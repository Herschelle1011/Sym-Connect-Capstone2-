@model CreateEvaluationViewModel
@{
    ViewData["Title"] = "Create Evaluation";
    Layout = "_AdminLayout";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    .eval-create-page, .eval-create-page * {
        font-family: 'Poppins', sans-serif;
    }
</style>

<div class="container mt-4 eval-create-page">
    <h2>Create New Evaluation</h2>
    <p class="text-muted">Add questions and set the answer type for each one.</p>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Evaluation Info -->
        <div class="card p-3 mb-3">
            <div class="mb-3">
                <label class="form-label">Evaluation title</label>
                <input asp-for="EvaluationTitle" class="form-control" placeholder="Enter title here..." />
                <span asp-validation-for="EvaluationTitle" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <input asp-for="Description" class="form-control" placeholder="Enter description here..." />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Open</label>
                    <input asp-for="OpenAt" type="date" id="openAtInput" class="form-control" />
                    <span asp-validation-for="OpenAt" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Closes</label>
                    <input asp-for="ClosedAt" type="date" id="closedAtInput" class="form-control" />
                    <span asp-validation-for="ClosedAt" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Suggested Questions (click to reuse) -->
        @if (Model.AvailableQuestions != null && Model.AvailableQuestions.Any())
        {
            <div class="mb-3">
                <label class="form-label d-block">Suggested questions (click to add)</label>
                @foreach (var q in Model.AvailableQuestions)
                {
                    <span class="badge bg-light text-dark border suggestion-chip me-2 mb-2 p-2"
                          style="cursor:pointer;"
                          data-id="@q.QuestionId"
                          data-text="@q.QuestionText">
                        @q.QuestionText
                    </span>
                }
            </div>
        }

        <!-- Question blocks get added here by JS -->
        <div id="questionsContainer"></div>

        <div id="noQuestionsError" class="text-danger mb-3" style="display:none; font-size:13px;">
            Please add at least one question.
        </div>

        <button type="button" id="addQuestionBtn" class="btn btn-primary w-100 mb-3">+ Add Question</button>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>

    </form>
</div>

<!-- Template for one question block (not visible, just a blueprint) -->
<template id="questionTemplate">
    <div class="card p-3 mb-3 question-block eval-create-page">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <label class="form-label question-label">Question</label>
            <span class="text-danger remove-question" style="cursor:pointer;">
                <i class="bi bi-trash"></i>
            </span>
        </div>
        <div class="d-flex gap-2 mb-2">
            <input type="hidden" class="question-id-input" name="" value="" />
            <div class="flex-grow-1">
                <input type="text" class="form-control question-text-input" name="" placeholder="Type your question here" />
                <span class="text-danger question-text-error" style="font-size:12px;"></span>
            </div>
            <div>
                <select class="form-select answer-type-select" style="max-width:200px;">
                    <option value="" selected disabled>Answer Type</option>
                    <option value="RatingScale">Rating Scale</option>
                    <option value="ShortAnswer">Short Answer</option>
                </select>
                <span class="text-danger answer-type-error d-block" style="font-size:12px;"></span>
            </div>
        </div>
        <div class="answer-preview text-muted">Choose an answer type first...</div>
    </div>
</template>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // ✅ Data from the server: whatever the user had typed before a failed submit (or empty on first visit)
const existingQuestions = @Html.Raw(Json.Serialize(
    (Model.Questions ?? new List<QuestionRowViewModel>())
        .Select(q => new {
            questionId = q.QuestionId,
            questionText = q.QuestionText,
            answerType = q.AnswerType.ToString() // ✅ turns enum into "RatingScale" / "ShortAnswer"
        })
));
        let questionIndex = 0;
        const openAtInput = document.getElementById("openAtInput");
        const closedAtInput = document.getElementById("closedAtInput");
        const today = new Date().toISOString().split("T")[0];

        openAtInput.min = today;

        // Whenever Open changes, Closes must be after it
        openAtInput.addEventListener("change", function () {
            if (openAtInput.value) {
                closedAtInput.min = openAtInput.value;

                if (closedAtInput.value && closedAtInput.value < openAtInput.value) {
                    closedAtInput.value = "";
                }
            }
        });

        function buildAnswerPreview(type) {
            if (type === "RatingScale") {
                const labels = ["Very Poor", "Poor", "Fair", "Good", "Excellent"];
                return `
                    <div class="row text-center g-0">
                        ${labels.map((label, idx) => `
                            <div class="col">
                                <div class="small fw-semibold mb-1">${idx + 1}</div>
                                <i class="bi bi-star fs-2 text-secondary"></i>
                                <div class="small text-muted">${label}</div>
                            </div>
                        `).join("")}
                    </div>
                `;
            }

            if (type === "ShortAnswer") {
                return `<input type="text" class="form-control" placeholder="Short answer..." disabled />`;
            }

            return `<span class="text-muted">Choose an answer type first...</span>`;
        }

        function addQuestionBlock(questionId = "", questionText = "", answerType = "") {
            const template = document.getElementById("questionTemplate").content.cloneNode(true);
            const block = template.querySelector(".question-block");
            const i = questionIndex;

            block.querySelector(".question-label").textContent = `Question ${i + 1}`;

            const idInput = block.querySelector(".question-id-input");
            idInput.name = `Questions[${i}].QuestionId`;
            idInput.value = questionId;

            const textInput = block.querySelector(".question-text-input");
            textInput.name = `Questions[${i}].QuestionText`;
            textInput.value = questionText;

            const typeSelect = block.querySelector(".answer-type-select");
            typeSelect.name = `Questions[${i}].AnswerType`;
            typeSelect.value = answerType; // restore the selected answer type on reload

            const preview = block.querySelector(".answer-preview");
            preview.innerHTML = buildAnswerPreview(answerType); // show the right preview immediately

            typeSelect.addEventListener("change", function () {
                preview.innerHTML = buildAnswerPreview(this.value);
                block.querySelector(".answer-type-error").textContent = "";
                typeSelect.classList.remove("border-danger");
            });

            textInput.addEventListener("input", function () {
                block.querySelector(".question-text-error").textContent = "";
            });

            block.querySelector(".remove-question").addEventListener("click", function () {
                block.remove();
                renumberQuestions();
            });

            document.getElementById("questionsContainer").appendChild(block);
            questionIndex++;
        }

        function renumberQuestions() {
            document.querySelectorAll(".question-block").forEach(function (block, idx) {
                block.querySelector(".question-label").textContent = `Question ${idx + 1}`;
            });
        }

        document.getElementById("addQuestionBtn").addEventListener("click", function () {
            addQuestionBlock();
        });

        document.querySelectorAll(".suggestion-chip").forEach(function (chip) {
            chip.addEventListener("click", function () {
                addQuestionBlock(this.dataset.id, this.dataset.text);
            });
        });

        // ✅ Restore previously typed questions on reload, otherwise start with one blank card
        if (existingQuestions.length > 0) {
            existingQuestions.forEach(function (q) {
                addQuestionBlock(q.questionId, q.questionText, q.answerType);
            });
        } else {
            addQuestionBlock();
        }

        document.querySelector("form").addEventListener("submit", function (e) {
            let hasError = false;
            const blocks = document.querySelectorAll(".question-block");

            if (blocks.length === 0) {
                document.getElementById("noQuestionsError").style.display = "block";
                hasError = true;
            } else {
                document.getElementById("noQuestionsError").style.display = "none";
            }

            blocks.forEach(function (block) {
                const text = block.querySelector(".question-text-input");
                const type = block.querySelector(".answer-type-select");
                const textError = block.querySelector(".question-text-error");
                const typeError = block.querySelector(".answer-type-error");

                if (!text.value.trim()) {
                    textError.textContent = "Question text is required.";
                    hasError = true;
                } else {
                    textError.textContent = "";
                }

                if (!type.value) {
                    typeError.textContent = "Required.";
                    type.classList.add("border-danger");
                    hasError = true;
                } else {
                    typeError.textContent = "";
                    type.classList.remove("border-danger");
                }
            });

            if (hasError) e.preventDefault();
        });
    </script>
}