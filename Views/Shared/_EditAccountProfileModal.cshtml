@model Sym_Connect__Capstone2_.ViewModels.Profile.EditAccountProfileViewModel
@{
    string formArea =
        ViewBag.FormArea as string ?? "";

    string formController =
        ViewBag.FormController as string ?? "Admin";
}

<form asp-action="EditProfile"
      asp-controller="@formController"
      asp-area="@formArea"
      method="post"
      enctype="multipart/form-data"
      id="editAccountProfileForm"
      class="modal-ajax-form">

    @Html.AntiForgeryToken()

    <input asp-for="UserId" type="hidden" />
    <input asp-for="OriginalEmail" type="hidden" id="originalEmailInput" />
    <input asp-for="EmailVerificationCode" type="hidden" id="emailVerificationCodeInput" />

    <div class="modal-header">
        <div>
            <small class="text-muted">
                Update your account information
            </small>
        </div>
    </div>


    <div class="modal-body">

        <!-- PROFILE PHOTO -->
        <div class="text-center mb-4">

            <div class="mb-3">

                @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoUrl))
                {
                    <img src="@Model.CurrentPhotoUrl"
                         id="profilePhotoPreview"
                         class="rounded-circle object-fit-cover mx-auto"
                         width="90"
                         height="90"
                         alt="Profile photo" />

                    <div id="profilePhotoPlaceholder"
                         class="rounded-circle bg-light
                        d-none align-items-center
                        justify-content-center
                        mx-auto"
                         style="width:90px;height:90px;">

                        <i class="bi bi-person fs-2 text-muted"></i>
                    </div>
                }
                else
                {
                    <img src=""
                         id="profilePhotoPreview"
                         class="rounded-circle object-fit-cover mx-auto d-none"
                         width="90"
                         height="90"
                         alt="Profile photo" />

                    <div id="profilePhotoPlaceholder"
                         class="rounded-circle bg-light
                        d-flex align-items-center
                        justify-content-center
                        mx-auto"
                         style="width:90px;height:90px;">

                        <i class="bi bi-person fs-2 text-muted"></i>
                    </div>
                }

            </div>


            <!-- Hidden actual file input -->
            <input asp-for="ProfilePicture"
                   type="file"
                   accept="image/jpeg,image/png,image/webp"
                   class="d-none"
                   id="profilePictureInput" />


            <!-- Visible Change Photo button -->
            <button type="button"
                    id="changePhotoButton"
                    class="btn btn-sm btn-outline-primary rounded-pill px-3">

                <i class="bi bi-camera me-1"></i>
                Change Photo

            </button>


            <div class="mt-1">
                <span asp-validation-for="ProfilePicture"
                      class="text-danger small">
                </span>
            </div>

        </div>


        <!-- DISPLAY NAME -->
        @if (string.IsNullOrEmpty(formArea))
        {
            <!-- DISPLAY NAME - ADMIN ONLY -->
            <div class="mb-3">
                <label asp-for="DisplayName"
                       class="form-label">
                    Display Name
                </label>

                <input asp-for="DisplayName"
                       class="form-control"
                       placeholder="Enter your name" />

                <span asp-validation-for="DisplayName"
                      class="text-danger small">
                </span>
            </div>
        }


        <!-- EMAIL -->
        <div class="mb-3">
            <label asp-for="Email"
                   class="form-label">
                Email Address
            </label>

            <div class="input-group">
                <input asp-for="Email"
                       id="emailInput"
                       class="form-control"
                       placeholder="Enter your email" />

                <button type="button"
                        id="verifyEmailBtn"
                        class="btn btn-outline-primary d-none">
                    Verify Code
                </button>
            </div>

            <span asp-validation-for="Email"
                  class="text-danger small">
            </span>

            <!-- Shows once the code has been confirmed -->
            <div id="emailVerifiedBadge" class="text-success small mt-1 d-none">
                <i class="bi bi-check-circle-fill"></i> Email verified — ready to save.
            </div>
        </div>


        <hr class="my-4" />


        <div class="mb-3">
            <h6 class="fw-semibold mb-1">
                Change Password
            </h6>

            <small class="text-muted">
                Leave these fields blank if you
                don't want to change your password.
            </small>
        </div>


        <!-- NEW PASSWORD -->
        <div class="mb-3">
            <label asp-for="NewPassword"
                   class="form-label">
                New Password
            </label>

            <div class="input-group">
                <input asp-for="NewPassword"
                       type="password"
                       id="newPasswordInput"
                       class="form-control"
                       placeholder="Enter new password" />

                <button type="button"
                        class="btn btn-outline-secondary password-toggle"
                        data-target="newPasswordInput"
                        aria-label="Show password">

                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <span asp-validation-for="NewPassword"
                  class="text-danger small">
            </span>
        </div>


        <!-- CONFIRM PASSWORD -->
        <div class="mb-2">
            <label asp-for="ConfirmPassword"
                   class="form-label">
                Confirm Password
            </label>

            <div class="input-group">
                <input asp-for="ConfirmPassword"
                       type="password"
                       id="confirmPasswordInput"
                       class="form-control"
                       placeholder="Confirm new password" />

                <button type="button"
                        class="btn btn-outline-secondary password-toggle"
                        data-target="confirmPasswordInput"
                        aria-label="Show password">

                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger small">
            </span>
        </div>
    </div>


    <div class="modal-footer">
        <button type="button"
                class="btn btn-light"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                id="saveProfileBtn"
                class="btn btn-primary px-4">
            Save Changes
        </button>
    </div>





</form>