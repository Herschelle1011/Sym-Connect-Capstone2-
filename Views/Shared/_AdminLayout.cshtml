@using Microsoft.AspNetCore.Identity
@using Sym_Connect__Capstone2_.Models
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYM-Connect</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/admin/group-details.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/MembersTable.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/facility.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/event.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/MediaAndDocuments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/ProfileViewMember.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/group-attendance-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification-dropdown.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/eventRequest.css" />
    <link rel="stylesheet" href="~/css/admin/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/ParticipationMemberModal.css" asp-append-version="true" />


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body>
    <div id="globalLoadingOverlay" class="global-loading-overlay">
        <div class="global-loading-spinner"></div>
    </div>

    @{
        var currentUser = await UserManager.GetUserAsync(User);
        var profilePicture = currentUser?.ProfilePictureUrl;
        var fallbackAvatar =
        $"https://ui-avatars.com/api/?name={User.Identity?.Name ?? "User"}&background=4a6cf7&color=fff&size=34";
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        bool electionOpen = controller == "Elections" || controller == "PartyLists";
    }

    <!-- ═══════════════════════════════ TOP BAR ═══════════════════════════════ -->
    <header id="topbar">
        <div style="display:none;">
            @Html.AntiForgeryToken()
        </div>
        <button id="sidebar-toggle" title="Open menu" aria-label="Open menu">
            <i class="bi bi-list"></i>
        </button>
        <span class="topbar-brand">SYM-Connect</span>
        <div class="topbar-actions">
            <a asp-controller="Notifications" asp-action="Index" class="topbar-icon-btn" id="notifBell" title="Notifications">
                <i class="bi bi-bell"></i>
                <span class="notif-count"
                      id="notifCount"
                      style="display:none;">
                    0
                </span>
            </a>
            <div id="notifDropdownPanel" class="notif-dropdown-panel"></div>
            <img class="topbar-avatar"
                 src="@(string.IsNullOrEmpty(profilePicture) ? fallbackAvatar : profilePicture)"
                 alt="User Avatar" />
        </div>
    </header>


    @* ========= TOAST PART =========== *@

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1200; margin-top: 70px;">
        <div id="appToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
            <div class="d-flex">
                <div class="toast-body" id="appToastBody">
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>



    <!-- Dimmed backdrop behind the drawer -->
    <div id="sidebar-overlay"></div>

    <!-- ═══════════════════════════════ SIDEBAR (off-canvas) ═══════════════════════════════ -->
    <nav id="sidebar">

        <div class="sidebar-brand">
            <img src="https://res.cloudinary.com/dxzmz62w4/image/upload/q_auto/f_auto/v1778759822/profiles/8f97c2e0-2fc4-46d0-a8ad-499b0f30e2c1.png"
                 alt="SYM-Connect Logo"
                 onerror="this.src='https://ui-avatars.com/api/?name=SYM&background=4a6cf7&color=fff&size=36'" />

            <div class="sidebar-brand-text">
                <span class="sidebar-brand-name">SYM-Connect</span>
                <span class="sidebar-brand-subname">Salesian Youth Movement</span>
            </div>

            <button id="sidebar-close" title="Close menu" aria-label="Close menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="sidebar-nav">

            <a asp-controller="Announcements" asp-action="Index"
               class="nav-item @(controller == "Announcements" ? "active" : "")">
                <i class="bi bi-megaphone"></i>
                <span class="nav-label">Announcements</span>
            </a>

        

            <a asp-controller="Admin" asp-action="Dashboard"
               class="nav-item @(controller == "Home" ? "active" : "")">
                <i class="bi bi-grid"></i>
                <span class="nav-label">Dashboard</span>
            </a>

            <a asp-controller="YouthMembers" asp-action="Index"
               class="nav-item @(controller == "Members" ? "active" : "")">
                <i class="bi bi-people"></i>
                <span class="nav-label">Members</span>
            </a>

            <a asp-controller="Events" asp-action="Index"
               class="nav-item @(controller == "Events" ? "active" : "")">
                <i class="bi bi-calendar-event"></i>
                <span class="nav-label">Events</span>
            </a>

            <a asp-controller="Groups" asp-action="Index"
               class="nav-item @(controller == "Groups" ? "active" : "")">
                <i class="bi bi-diagram-3"></i>
                <span class="nav-label">Groups</span>
            </a>

            <a asp-controller="Facilities" asp-action="Index"
               class="nav-item @(controller == "Facility" ? "active" : "")">
                <i class="bi bi-hospital"></i>
                <span class="nav-label">Facility</span>
            </a>

            <a asp-controller="Evaluations" asp-action="Index"
               class="nav-item @(controller == "Evaluation" ? "active" : "")">
                <i class="bi bi-star-half"></i>
                <span class="nav-label">Evaluation</span>
            </a>

            
            <a asp-controller="ParticipationTracking" asp-action="Index"
               class="nav-item @(controller == "Participation" ? "active" : "")">
                <i class="bi bi-clipboard-check"></i> 
                <span class="nav-label">Participation</span>
            </a>

            
            <a asp-controller="MediaAndDocuments" asp-action="Index"
               class="nav-item @(controller == "MediaAndDocuments" ? "active" : "")">

                <i class="bi bi-folder2-open"></i>

                <span class="nav-label">Media and Documents</span>
            </a>


            <div class="nav-dropdown @(electionOpen ? "open" : "")">

                <a href="#" class="nav-item nav-dropdown-toggle @(electionOpen ? "active" : "")">
                    <i class="bi bi-hand-index-thumb"></i>
                    <span class="nav-label">Election</span>
                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                </a>

                <div class="nav-dropdown-menu">

                    <a asp-controller="PartyLists" asp-action="Index"
                       class="nav-item sub-item @(controller == "PartyLists" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span class="nav-label">Partylist</span>
                    </a>

                    <a asp-controller="Elections" asp-action="Index"
                       class="nav-item sub-item @(controller == "Elections" ? "active" : "")">
                        <i class="bi bi-person-check-fill"></i>
                        <span class="nav-label">Create Voting</span>
                    </a>


                </div>

            </div>
        </div>

        <!-- Bottom links -->
        <div class="sidebar-bottom">
            <form asp-controller="Admin"
                  asp-action="Logout"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to logout?')">

                <button type="submit" class="nav-item logout-button">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="nav-label">Logout</span>
                </button>

            </form>


        </div>

        <!-- User profile -->
        <div class="sidebar-user">
            <img src="@(string.IsNullOrEmpty(profilePicture) ? fallbackAvatar : profilePicture)"
                 alt="User Avatar" />
            <div class="sidebar-user-info">
                <div class="sidebar-user-name">@(User.Identity?.Name ?? "Guest")</div>
                <div class="sidebar-user-role">Admin</div>
            </div>
            <i class="bi bi-chevron-down sidebar-user-chevron"></i>
          </div>
    </nav>
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- Main content area -->
    <div id="main-content">
        <div class="content-wrapper">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/alertDialog.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin/AddressScript.js" asp-append-version="true"></script>
    <script src="~/js/profile.js"></script>
    <script src="~/js/admin/membersTable.js"></script>


    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/admin/notification.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Off-canvas sidebar: opens only on hamburger click, closes via X, overlay click, or Esc
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        const openBtn = document.getElementById('sidebar-toggle');
        const closeBtn = document.getElementById('sidebar-close');

        function openSidebar() {
        sidebar.classList.add('show');
        overlay.classList.add('show');
        document.body.classList.add('sidebar-open');
        }

        function closeSidebar() {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
        document.body.classList.remove('sidebar-open');
        }

        openBtn.addEventListener('click', openSidebar);
        closeBtn.addEventListener('click', closeSidebar);
        overlay.addEventListener('click', closeSidebar);

        document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSidebar();
        });

        // Election submenu toggle
        document.querySelectorAll('.nav-dropdown-toggle').forEach(item => {
        item.addEventListener('click', function (e) {
        e.preventDefault();
        this.parentElement.classList.toggle('open');
        });
        });

        // ---previewProfilePhoto
        function previewProfilePhoto(input) {
        const preview = document.getElementById('photoPreview');
        const placeholder = document.getElementById('placeholderIcon');

        if (input.files && input.files[0]) {
        const blobUrl = URL.createObjectURL(input.files[0]);
        preview.src = blobUrl;
        preview.style.display = 'block';
        placeholder.style.display = 'none';

        preview.onload = function () {
        URL.revokeObjectURL(blobUrl);
        };
        } else {
        preview.src = "";
        preview.style.display = 'none';
        placeholder.style.display = 'block';
        }
        }

        function showToast(message, success) {
        const container = document.querySelector('.toast-container');
        const delay = 9000;

        const toastEl = document.createElement('div');
        toastEl.className = `toast app-toast align-items-center border-0 ${success ? 'toast-success' : 'toast-danger'}`;
        toastEl.setAttribute('role', 'alert');
        toastEl.setAttribute('aria-live', 'assertive');
        toastEl.setAttribute('aria-atomic', 'true');
        toastEl.setAttribute('data-bs-delay', delay);

        const icon = success ? 'bi-check-circle-fill' : 'bi-x-circle-fill';

        toastEl.innerHTML = `
        <div class="toast-body-wrapper">
        <i class="bi ${icon} toast-icon"></i>
        <div class="toast-text">${message}</div>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-progress" style="animation-duration: ${delay}ms;"></div>
        `;

        container.appendChild(toastEl);

        const toast = new bootstrap.Toast(toastEl);
        toast.show();

        toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }


      

    </script>
    <partial name="_Modal" />
    <partial name="_AlertDialog" />

</body>
</html>
