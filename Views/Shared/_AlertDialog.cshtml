<div class="modal fade" id="appAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
        <div class="modal-content text-center" style="border-radius: 16px; border: none; padding: 28px 24px;">

            <div id="appAlertIcon" class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                 style="width: 56px; height: 56px; border-radius: 50%;">
                <i id="appAlertIconGlyph" class="bi" style="font-size: 26px;"></i>
            </div>

            <h6 id="appAlertTitle" class="fw-semibold mb-2" style="font-size: 16px;"></h6>
            <p id="appAlertMessage" class="text-muted mb-4" style="font-size: 13.5px;"></p>

            <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal" id="appAlertOkBtn">
                OK
            </button>
        </div>
    </div>
</div>