<!-- Views/Shared/_Modal.cshtml -->
<!-- Reusable modal shell — works for ANY form -->

<div class="modal fade" id="appModal" tabindex="-1"
     aria-labelledby="appModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered app-modal-dialog">
        <div class="modal-content" style="border-radius: 16px; border: none;">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-start gap-2">
                    <div class="app-modal-icon d-none" id="appModalIcon">
                        <i></i>
                    </div>
                    <div>
                        <h5 class="modal-title"
                            id="appModalLabel"
                            style="font-size: 16px; font-weight: 500;">
                        </h5>
                        <p class="app-modal-subtitle d-none" id="appModalSubtitle"></p>
                    </div>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <!-- Body — content loads here dynamically -->
            <div class="modal-body" id="appModalBody">
            </div>

        </div>
    </div>
</div>