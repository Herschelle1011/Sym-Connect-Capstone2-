@model List<GetPositionListViewModel>
@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Manage Positions</h4>
        <small class="text-muted">Positions can be added or edited, not removed.</small>
    </div>
    <button type="button" class="btn btn-primary rounded-pill open-modal"
            data-title="Add Position"
            data-url="@Url.Action("GetCreateModal", "Position")">
        <i class="ti ti-plus me-1"></i> Add Position
    </button>
</div>

<div class="card border-0 shadow-sm">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:56px;height:56px;">
                <i class="ti ti-users fs-3 text-muted"></i>
            </div>
            <p class="text-muted mb-0">No positions yet. Add your first one to get started.</p>
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var position in Model.OrderBy(p => p.DisplayOrder))
            {
                <div class="list-group-item d-flex align-items-center gap-3 py-3 position-row"
                     data-position-id="@position.PositionId">

                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:40px;height:40px;">
                        <i class="ti ti-user-plus fs-6"></i>
                    </div>

                    <div class="flex-grow-1 min-width-0">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-medium text-truncate">@position.PositionName</span>
                            <span class="badge rounded-pill bg-light text-muted fw-normal" style="font-size:.7rem;">
                                #@position.DisplayOrder
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(position.Description))
                        {
                            <small class="text-muted d-block text-truncate">@position.Description</small>
                        }
                    </div>

                    <span class="badge rounded-pill @(position.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") flex-shrink-0">
                        <i class="ti ti-point-filled me-1" style="font-size:.6rem;"></i>@(position.IsActive ? "Active" : "Inactive")
                    </span>

                    <div class="form-check form-switch mb-0 flex-shrink-0" title="Toggle active status">
                        <input class="form-check-input toggle-status" type="checkbox"
                               data-position-id="@position.PositionId"
                               role="switch"
                        @(position.IsActive ? "checked" : "") />
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary open-modal flex-shrink-0"
                            data-title="Edit Position"
                            data-url="@Url.Action("GetEditModal", "Position", new { id = position.PositionId })">
                        <i class="ti ti-edit"></i>
                    </button>
                </div>
            }
        </div>
    }
</div>

<style>
    .position-row {
        transition: background-color .15s ease;
    }

        .position-row:hover {
            background-color: var(--tblr-list-group-hover-bg, rgba(0,0,0,.02));
        }

    .min-width-0 {
        min-width: 0;
    }
</style>
