@model List<Sym_Connect__Capstone2_.ViewModels.Participation.GroupParticipationViewModel>
@using Sym_Connect__Capstone2_.Models.Enums

<div id="groupParticipationWrapper" class="participation-table-card">

    <!-- HEADER -->
    <div class="participation-table-header">
        <div>
            <h6 class="mb-1 fw-semibold">Group Participation</h6>
            <div class="text-muted small">
                View participation performance for each assigned group.
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="participation-search">
                <i class="bi bi-search"></i>
                <input type="text"
                       id="groupSearchInput"
                       placeholder="Search group..." />
            </div>

            <select id="groupStatusFilter"
                    class="form-select form-select-sm participation-status-filter">
                <option value="">All Status</option>
                <option value="@GroupAttendanceStatus.FullyPresent">
                    Fully Present
                </option>
                <option value="@GroupAttendanceStatus.PartiallyPresent">
                    Partially Present
                </option>
                <option value="@GroupAttendanceStatus.Absent">
                    Absent
                </option>
            </select>
        </div>
    </div>


    <!-- TABLE -->
    <div class="table-responsive">
        <table class="table participation-table mb-0"
               id="groupParticipationTable">

            <thead>
                <tr>
                    <th>GROUP NAME</th>
                    <th class="text-center">TOTAL MEMBERS</th>
                    <th class="text-center">EVENTS ASSIGNED</th>

                    <th class="text-center participation-parent-header"
                        colspan="3">
                        PARTICIPATION
                    </th>

                    <th class="text-center">POINTS</th>

                    <th>RATE</th>
                    <th>STATUS</th>
                </tr>

                <tr class="participation-subheader">
                    <th></th>
                    <th></th>
                    <th></th>

                    <th class="text-center text-success">
                        FULLY PRESENT
                    </th>

                    <th class="text-center text-warning">
                        PARTIAL
                    </th>

                    <th class="text-center text-danger">
                        ABSENT
                    </th>

                

                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>


            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9"
                            class="text-center text-muted py-5">
                            No group participation data found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var group in Model)
                    {
                        var statusClass = group.Status switch
                        {
                            GroupAttendanceStatus.FullyPresent
                                => "status-fully-present",

                            GroupAttendanceStatus.PartiallyPresent
                                => "status-partially-present",

                            _ => "status-absent"
                        };


                        var statusLabel = group.Status switch
                        {
                            GroupAttendanceStatus.FullyPresent
                                => "Fully Present",

                            GroupAttendanceStatus.PartiallyPresent
                                => "Partially Present",

                            _ => "Absent"
                        };


                        var barColor = group.Status switch
                        {
                            GroupAttendanceStatus.FullyPresent
                                => "#16a34a",

                            GroupAttendanceStatus.PartiallyPresent
                                => "#f59e0b",

                            _ => "#dc2626"
                        };


                        <tr class="group-row"
                            data-name="@group.GroupName.ToLower()"
                            data-status="@group.Status">

                            <!-- GROUP -->
                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <div class="group-avatar">
                                        <i class="bi bi-people-fill"></i>
                                    </div>

                                    <div>
                                        <div class="group-name-text">
                                            @group.GroupName
                                        </div>
                                    </div>

                                </div>
                            </td>


                            <!-- MEMBERS -->
                            <td class="text-center table-number">
                                @group.TotalMembers
                            </td>


                            <!-- EVENTS -->
                            <td class="text-center table-number">
                                <span class="fw-semibold">@group.AttendedEvents</span>
                                <span class="text-muted">/@group.EventsAssigned</span>
                            </td>


                            <!-- FULL -->
                            <td class="text-center participation-value text-success">
                                @group.FullyPresentEvents
                            </td>


                            <!-- PARTIAL -->
                            <td class="text-center participation-value text-warning">
                                @group.PartiallyPresentEvents
                            </td>


                            <!-- ABSENT -->
                            <td class="text-center participation-value text-danger">
                                @group.AbsentEvents
                            </td>


                            <!-- POINTS -->
                            <td class="text-center table-number">
                                <span class="fw-semibold points-earned">@group.EarnedPoints</span>
                                <span class="text-muted">/@group.TotalPossiblePoints pts</span>
                            </td>


                            <!-- RATE -->
                            <td style="min-width:110px;">

                                <div class="d-flex align-items-center gap-2">

                                    <div class="participation-rate-bar flex-grow-1">

                                        <div class="participation-rate-bar-fill"
                                             style="
                                            width:@group.ParticipationRate.ToString("0")%;
                                            background:@barColor;">
                                        </div>

                                    </div>

                                    <span class="rate-value">
                                        @group.ParticipationRate.ToString("0")%
                                    </span>

                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>
                                <span class="status-badge @statusClass">
                                    @statusLabel
                                </span>
                            </td>

                            <td class="text-center">
                                <button type="button" class="btn btn-outline-primary btn-sm open-group-participation-modal"
                                        data-url="@Url.Action("GetGroupMembers", "ParticipationTracking", new { groupId = group.GroupId })"
                                        data-title="@group.GroupName - Members">
                                    View Details
                                </button>
                            </td>


                        </tr>
                    }

                    <tr id="groupNoResultsRow" style="display:none;">
                        <td colspan="9" class="text-center text-muted py-5">
                            No groups match your search or filter.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>


    <!-- FOOTER -->
    @if (Model != null && Model.Any())
    {
        <div class="participation-table-footer">

            <span class="text-muted small"
                  id="groupShowingLabel">
                Showing 1 to @Math.Min(5, Model.Count) of @Model.Count groups
            </span>


            <nav>
                <ul class="pagination pagination-sm participation-pagination mb-0"
                    id="groupPagination">
                </ul>
            </nav>

        </div>
    }

</div>


<style>

    .participation-table-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
    }


    .participation-table-header {
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        border-bottom: 1px solid #e5e7eb;
    }


    .participation-search {
        height: 34px;
        width: 210px;
        border: 1px solid #dbe1ea;
        border-radius: 7px;
        background: #fff;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 10px;
    }


        .participation-search i {
            color: #94a3b8;
            font-size: 12px;
        }


        .participation-search input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 12px;
            color: #334155;
            background: transparent;
        }


            .participation-search input::placeholder {
                color: #94a3b8;
            }


    .participation-status-filter {
        width: 135px;
        height: 34px;
        border-radius: 7px;
        border-color: #dbe1ea;
        font-size: 12px;
        color: #475569;
    }


    .participation-table {
        font-size: 12px;
        color: #334155;
    }


        .participation-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e5e7eb;
            padding: 10px 12px;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: .02em;
            vertical-align: middle;
        }


        .participation-table .participation-subheader th {
            padding-top: 4px;
            padding-bottom: 7px;
            background: #f8fafc;
            font-size: 8.5px;
        }


    .participation-parent-header {
        border-bottom: none !important;
    }


    .participation-table tbody td {
        padding: 12px;
        border-color: #edf0f5;
        vertical-align: middle;
    }


    .participation-table tbody tr:hover {
        background: #fafcff;
    }


    .group-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #2563eb;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
    }


    .group-name-text {
        font-weight: 600;
        color: #0f172a;
        white-space: nowrap;
    }


    .table-number {
        font-weight: 500;
        color: #334155;
    }


    .participation-value {
        font-weight: 600;
    }


    .points-earned {
        color: #7c3aed;
    }


    .participation-rate-bar {
        height: 4px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        min-width: 45px;
    }


    .participation-rate-bar-fill {
        height: 100%;
        border-radius: 999px;
    }


    .rate-value {
        min-width: 30px;
        font-size: 11px;
        font-weight: 600;
        color: #475569;
    }


    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 8px;
        font-size: 9.5px;
        font-weight: 600;
        white-space: nowrap;
    }


    .status-fully-present {
        color: #15803d;
        background: #dcfce7;
    }


    .status-partially-present {
        color: #b45309;
        background: #fef3c7;
    }


    .status-absent {
        color: #b91c1c;
        background: #fee2e2;
    }


    .participation-table-footer {
        min-height: 48px;
        padding: 10px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #e5e7eb;
    }


    .participation-pagination .page-link {
        border: none;
        color: #475569;
        border-radius: 6px !important;
        margin: 0 2px;
        min-width: 30px;
        text-align: center;
        font-size: 11px;
    }


    .participation-pagination .page-item.active .page-link {
        background: #2563eb;
        color: white;
    }


    @@media (max-width: 768px) {

        .participation-search {
            width: 100%;
        }

        .participation-status-filter {
            width: 100%;
        }

        .participation-table-header > div:last-child {
            width: 100%;
        }
    }

</style>


<script>

    (function () {

        var searchInput =
            document.getElementById('groupSearchInput');

        var statusFilter =
            document.getElementById('groupStatusFilter');

        var allRows =
            Array.from(
                document.querySelectorAll(
                    '#groupParticipationTable tbody .group-row'
                )
            );

        var noResultsRow =
            document.getElementById('groupNoResultsRow');

        var showingLabel =
            document.getElementById('groupShowingLabel');

        var paginationEl =
            document.getElementById('groupPagination');

        var rowsPerPage = 5;
        var currentPage = 1;


        // Returns only the rows that pass the current search + status filter
        function getVisibleRows() {

            var term =
                (searchInput?.value || '')
                    .toLowerCase()
                    .trim();

            var status =
                statusFilter?.value || '';

            return allRows.filter(function (row) {

                var matchesName =
                    row.dataset.name.includes(term);

                var matchesStatus =
                    !status ||
                    row.dataset.status === status;

                return matchesName && matchesStatus;
            });
        }


        function renderPagination(totalPages) {
            if (!paginationEl) return;

            var html = '';

            html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
                '<a class="page-link" href="#" data-action="prev"><i class="bi bi-chevron-left"></i></a></li>';

            for (var p = 1; p <= totalPages; p++) {
                html += '<li class="page-item ' + (p === currentPage ? 'active' : '') + '">' +
                    '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
            }

            html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">' +
                '<a class="page-link" href="#" data-action="next"><i class="bi bi-chevron-right"></i></a></li>';

            paginationEl.innerHTML = html;
        }


        // ── Pagination renderer ───────────────────────────────────────
        function renderPage() {

            var visible = getVisibleRows();
            var totalPages = Math.max(1, Math.ceil(visible.length / rowsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            var start = (currentPage - 1) * rowsPerPage;
            var end = start + rowsPerPage;

            allRows.forEach(function (row) { row.style.display = 'none'; });
            visible.forEach(function (row, i) {
                row.style.display = (i >= start && i < end) ? '' : 'none';
            });

            if (noResultsRow) {
                noResultsRow.style.display = visible.length === 0 ? '' : 'none';
            }

            var showing = Math.min(end, visible.length);
            var from = visible.length === 0 ? 0 : start + 1;

            if (showingLabel) {
                showingLabel.textContent =
                    'Showing ' + from + ' to ' + showing + ' of ' + visible.length + ' groups';
            }

            renderPagination(totalPages);
        }


        // ── Pagination click events (delegated) ─────────────────────────
        paginationEl?.addEventListener('click', function (e) {
            var link = e.target.closest('a');
            if (!link) return;
            e.preventDefault();

            if (link.dataset.action === 'prev') {
                if (currentPage > 1) currentPage--;
            }
            else if (link.dataset.action === 'next') {
                var visible = getVisibleRows();
                var totalPages = Math.max(1, Math.ceil(visible.length / rowsPerPage));
                if (currentPage < totalPages) currentPage++;
            }
            else if (link.dataset.page) {
                currentPage = parseInt(link.dataset.page, 10);
            }

            renderPage();
        });


        // ── Search / filter events ──────────────────────────────────────
        searchInput?.addEventListener('input', function () {
            currentPage = 1;
            renderPage();
        });

        statusFilter?.addEventListener('change', function () {
            currentPage = 1;
            renderPage();
        });


        // ── First render ──────────────────────────────────────────────
        if (allRows.length > 0) {
            renderPage();
        }

    })();

</script>
