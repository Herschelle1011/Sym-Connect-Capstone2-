@model List<Sym_Connect__Capstone2_.ViewModels.Participation.GroupParticipationViewModel>
@using Sym_Connect__Capstone2_.Models.Enums

<div id="groupParticipationWrapper" class="participation-table-card">

    <!-- HEADER -->
    <div class="participation-table-header">

        <h6 class="mb-0 fw-bold participation-table-title">
            Group Participation
        </h6>

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <div class="participation-search">
                <input type="text"
                       id="groupSearchInput"
                       placeholder="Search" />
                <i class="bi bi-search"></i>
            </div>

            <button type="button"
                    id="exportPdfBtn"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-download"></i>
                Export
            </button>

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-calendar-event"></i>
                Event Calendar
            </a>

        </div>
    </div>


    <!-- TABLE -->
    <div class="table-responsive">
        <table class="table participation-table mb-0"
               id="groupParticipationTable">

            <thead>
                <tr>
                    <th>GROUP NAME</th>
                    <th class="text-center">TOTAL MEMBERS</th>
                    <th class="text-center">EVENT ASSIGNED</th>
                    <th class="text-center">PRESENT</th>
                    <th class="text-center">PARTIAL</th>
                    <th class="text-center">ABSENT</th>
                    <th class="text-center">TOTAL POINTS</th>
                    <th class="text-center">RATE</th>
                    <th></th>
                </tr>
            </thead>


            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9"
                            class="text-center text-muted py-5">
                            No group participation data found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var group in Model)
                    {
                        var barColor = group.Status switch
                        {
                            GroupAttendanceStatus.FullyPresent => "#16a34a",
                            GroupAttendanceStatus.PartiallyPresent => "#f59e0b",
                            _ => "#dc2626"
                        };


                        <tr class="group-row"
                            data-name="@group.GroupName.ToLower()"
                            data-status="@group.Status">

                            <!-- GROUP -->
                            <td>
                                <div class="group-name-text">
                                    @group.GroupName
                                </div>
                            </td>


                            <!-- MEMBERS -->
                            <td class="text-center table-number">
                                @group.TotalMembers
                            </td>


                            <!-- EVENTS -->
                            <td class="text-center table-number">
                                @group.EventsAssigned
                            </td>




                            <!-- PRESENT -->
                           <td class="text-center table-number">
        @group.FullyPresentEvents
    </td>


                            <!-- PARTIAL -->
                            <td class="text-center table-number">
                                @group.PartiallyPresentEvents
                            </td>


                            <!-- ABSENT -->
                            <td class="text-center table-number">
                                @group.AbsentEvents
                            </td>


                            <!-- POINTS -->
                            <td class="text-center table-number">
                                @group.EarnedPoints.ToString("0.##")/@group.TotalPossiblePoints points
                            </td>


                            <!-- RATE -->
                            <td style="min-width:90px;">
                                <div class="rate-cell">
                                    <div class="participation-rate-bar">
                                        <div class="participation-rate-bar-fill"
                                             style="width:@group.ParticipationRate.ToString("0")%; background:@barColor;">
                                        </div>
                                    </div>

                                    <span class="rate-value">
                                        @group.ParticipationRate.ToString("0")%
                                    </span>
                                </div>
                            </td>


                            <!-- ACTION -->
                            <td class="text-center">
                                <button type="button" class="btn btn-outline-primary btn-sm open-group-participation-modal"
                                        data-url="@Url.Action("GetGroupMembers", "ParticipationTracking", new { groupId = group.GroupId })"
                                        data-title="@group.GroupName"
                                        data-count="@group.TotalMembers member@(group.TotalMembers == 1 ? "" : "s")">
                                    View Details
                                </button>
                            </td>

                        </tr>
                    }

                    <tr id="groupNoResultsRow" style="display:none;">
                        <td colspan="9" class="text-center text-muted py-5">
                            No groups match your search.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>


    <!-- FOOTER -->
    @if (Model != null && Model.Any())
    {
        <div class="participation-table-footer">

            <span class="text-muted small" id="groupShowingLabel">
                Showing 1 to @Math.Min(5, Model.Count) of @Model.Count groups
            </span>

            <nav>
                <ul class="pagination pagination-sm participation-pagination mb-0" id="groupPagination"></ul>
            </nav>

        </div>
    }

</div>


<style>

    .participation-table-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
    }


    .participation-table-header {
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }


    .participation-table-title {
        font-size: 16px;
        color: #0f172a;
    }


    .participation-search {
        position: relative;
        height: 36px;
        width: 200px;
    }

        .participation-search input {
            width: 100%;
            height: 100%;
            border: 1px solid #dbe1ea;
            border-radius: 999px;
            padding: 0 34px 0 14px;
            font-size: 13px;
            color: #334155;
            outline: none;
        }

            .participation-search input::placeholder {
                color: #94a3b8;
            }

            .participation-search input:focus {
                border-color: #93c5fd;
            }

        .participation-search i {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 13px;
            pointer-events: none;
        }


    .participation-table {
        font-size: 13px;
        color: #334155;
        margin-bottom: 0;
    }

        .participation-table thead th {
            background: #0d91e8;
            color: #fff;
            border: none;
            padding: 12px 14px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .02em;
            white-space: nowrap;
        }

            .participation-table thead th:first-child {
                border-top-left-radius: 0;
            }

        .participation-table tbody td {
            padding: 14px;
            border-color: #eef1f5;
            vertical-align: middle;
        }

        .participation-table tbody tr:hover {
            background: #fafcff;
        }

        .participation-table tbody tr:last-child td {
            border-bottom: none;
        }


    .group-name-text {
        font-weight: 600;
        color: #0f172a;
        white-space: nowrap;
    }


    .table-number {
        font-weight: 500;
        color: #334155;
    }


    .rate-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }


    .participation-rate-bar {
        width: 70px;
        height: 4px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }


    .participation-rate-bar-fill {
        height: 100%;
        border-radius: 999px;
    }


    .rate-value {
        font-size: 10.5px;
        font-weight: 600;
        color: #94a3b8;
    }


    .participation-table-footer {
        min-height: 48px;
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #e5e7eb;
    }


    .participation-pagination .page-link {
        border: none;
        color: #475569;
        border-radius: 6px !important;
        margin: 0 2px;
        min-width: 30px;
        text-align: center;
        font-size: 11px;
    }

    .participation-pagination .page-item.active .page-link {
        background: #0d91e8;
        color: white;
    }


    @@media (max-width: 768px) {

        .participation-table-header {
            flex-direction: column;
            align-items: stretch;
        }

        .participation-search {
            width: 100%;
        }
    }

</style>


<script>

    (function () {

        var searchInput = document.getElementById('groupSearchInput');
        var allRows = Array.from(document.querySelectorAll('#groupParticipationTable tbody .group-row'));
        var noResultsRow = document.getElementById('groupNoResultsRow');
        var showingLabel = document.getElementById('groupShowingLabel');
        var paginationEl = document.getElementById('groupPagination');

        var rowsPerPage = 5;
        var currentPage = 1;


        function getVisibleRows() {

            var term = (searchInput?.value || '').toLowerCase().trim();

            return allRows.filter(function (row) {
                return row.dataset.name.includes(term);
            });
        }


        function renderPagination(totalPages) {
            if (!paginationEl) return;

            var html = '';

            html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
                '<a class="page-link" href="#" data-action="prev"><i class="bi bi-chevron-left"></i></a></li>';

            for (var p = 1; p <= totalPages; p++) {
                html += '<li class="page-item ' + (p === currentPage ? 'active' : '') + '">' +
                    '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
            }

            html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">' +
                '<a class="page-link" href="#" data-action="next"><i class="bi bi-chevron-right"></i></a></li>';

            paginationEl.innerHTML = html;
        }


        function renderPage() {

            var visible = getVisibleRows();
            var totalPages = Math.max(1, Math.ceil(visible.length / rowsPerPage));

            if (currentPage > totalPages) currentPage = totalPages;

            var start = (currentPage - 1) * rowsPerPage;
            var end = start + rowsPerPage;

            allRows.forEach(function (row) { row.style.display = 'none'; });
            visible.forEach(function (row, i) {
                row.style.display = (i >= start && i < end) ? '' : 'none';
            });

            if (noResultsRow) {
                noResultsRow.style.display = visible.length === 0 ? '' : 'none';
            }

            var showing = Math.min(end, visible.length);
            var from = visible.length === 0 ? 0 : start + 1;

            if (showingLabel) {
                showingLabel.textContent =
                    'Showing ' + from + ' to ' + showing + ' of ' + visible.length + ' groups';
            }

            renderPagination(totalPages);
        }


        paginationEl?.addEventListener('click', function (e) {
            var link = e.target.closest('a');
            if (!link) return;
            e.preventDefault();

            if (link.dataset.action === 'prev') {
                if (currentPage > 1) currentPage--;
            }
            else if (link.dataset.action === 'next') {
                var visible = getVisibleRows();
                var totalPages = Math.max(1, Math.ceil(visible.length / rowsPerPage));
                if (currentPage < totalPages) currentPage++;
            }
            else if (link.dataset.page) {
                currentPage = parseInt(link.dataset.page, 10);
            }

            renderPage();
        });


        searchInput?.addEventListener('input', function () {
            currentPage = 1;
            renderPage();
        });


        if (allRows.length > 0) {
            renderPage();
        }

    })();

</script>