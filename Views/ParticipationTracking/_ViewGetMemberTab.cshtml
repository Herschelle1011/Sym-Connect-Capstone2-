@model List<Sym_Connect__Capstone2_.ViewModels.Participation.MemberParticipationViewModel>
@using Sym_Connect__Capstone2_.Models.Enums


<div class="p-3 member-participation-widget">

    <div class="member-table-toolbar">

        <div class="input-group input-group-sm member-search-box">
            <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
            </span>

            <input type="text"
                   id="groupMemberSearch"
                   class="form-control js-member-search"
                   placeholder="Search member..." />
        </div>

        <select id="groupMemberSort"
                class="form-select form-select-sm member-sort-box js-member-sort">

            <option value="highest">
                Points: Highest to Lowest
            </option>

            <option value="lowest">
                Points: Lowest to Highest
            </option>

        </select>

    </div>

    <div class="table-responsive">
        <table class="table group-modal-table mb-0"
               id="groupMemberTable">

            <thead>
                <tr>
                    <th>MEMBER NAME</th>
                    <th class="text-center">EVENTS ATTENDED</th>
                    <th class="text-center text-success">PRESENT</th>
                    <th class="text-center text-danger">ABSENT</th>
                    <th class="text-center">POINTS</th>
                    <th>RATE</th>
                    <th>STATUS</th>
                </tr>
            </thead>

            <tbody class="js-member-tbody">

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-4">

                            No members found in this group.

                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var member in Model)
                    {
                        var statusClass = member.Status switch
                        {
                            MemberParticipationStatus.FullyPresent => "status-fully-present",
                            MemberParticipationStatus.PartiallyPresent => "status-partially-present",
                            _ => "status-absent"
                        };

                        var statusLabel = member.Status switch
                        {
                            MemberParticipationStatus.FullyPresent => "Fully Present",
                            MemberParticipationStatus.PartiallyPresent => "Partially Present",
                            _ => "Absent"
                        };

                        var barColor = member.Status switch
                        {
                            MemberParticipationStatus.FullyPresent => "#16a34a",
                            MemberParticipationStatus.PartiallyPresent => "#f59e0b",
                            _ => "#dc2626"
                        };

                        <tr data-member-name="@member.FullName.ToLower()"
                            data-points="@member.EarnedEventPoints">

                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    @if (!string.IsNullOrEmpty(member.PhotoUrl))
                                    {
                                        <img src="@member.PhotoUrl"
                                             alt="@member.FullName"
                                             class="member-participation-avatar" />
                                    }
                                    else
                                    {
                                        <div class="member-avatar-placeholder">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                    }

                                    <div class="member-name-text d-flex align-items-center gap-1">
                                        @member.FullName

                                        @if (member.IsTopPerformer)
                                        {
                                            <i class="bi bi-award-fill text-warning"
                                               title="Top performer"></i>
                                        }
                                    </div>

                                </div>
                            </td>

                            <td class="text-center table-number">
                                <span class="fw-semibold">
                                    @member.EventsPresent
                                </span>

                                <span class="text-muted">
                                    /@member.EventsAssigned
                                </span>
                            </td>

                            <td class="text-center participation-value text-success">
                                @member.EventsPresent
                            </td>

                            <td class="text-center participation-value text-danger">
                                @member.EventsAbsent
                            </td>

                            <td class="text-center table-number">
                                <span class="fw-semibold points-earned">
                                    @member.EarnedEventPoints
                                </span>

                                <span class="text-muted">
                                    /@member.TotalPossiblePoints pts
                                </span>
                            </td>

                            <td style="min-width:110px;">
                                <div class="d-flex align-items-center gap-2">

                                    <div class="participation-rate-bar flex-grow-1">

                                        <div class="participation-rate-bar-fill"
                                             style="width:@member.ParticipationRate.ToString("0")%; background:@barColor;">
                                        </div>


                                    </div>

                                    <span class="rate-value">
                                        @member.ParticipationRate.ToString("0")%
                                    </span>

                                </div>
                            </td>

                            <td>
                                <span class="status-badge @statusClass">
                                    @statusLabel
                                </span>
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>
    </div>
</div>


