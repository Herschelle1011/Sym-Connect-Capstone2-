@model List<Sym_Connect__Capstone2_.ViewModels.Participation.MemberParticipationViewModel>
@using Sym_Connect__Capstone2_.Models.Enums

<style>
    .member-table-toolbar {
        display: flex;
        justify-content: flex-start;
        gap: 8px;
        margin-bottom: 10px;
    }

    .member-search-box {
        width: 190px;
    }

    .member-sort-box {
        width: 140px;
        font-size: 12px;
    }


    .member-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 9px 2px;
        border-bottom: 1px solid #eef1f5;
    }


    .member-participation-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }


    .member-avatar-placeholder {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }


    .member-name-text {
        font-weight: 600;
        color: #0f172a;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 5px;
    }


    .member-sub-text {
        font-size: 11px;
        color: #64748b;
        margin-top: 1px;
    }


    .member-row-right {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }


    .member-points-text {
        font-size: 12.5px;
        white-space: nowrap;
        min-width: 70px;
        text-align: right;
    }


    .member-rate {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 85px;
    }


    .participation-rate-bar {
        flex-grow: 1;
        height: 4px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        min-width: 45px;
    }


    .rate-value {
        font-size: 11px;
        font-weight: 600;
        color: #475569;
        min-width: 28px;
    }


    .member-table-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding-top: 10px;
        margin-top: 4px;
        border-top: 1px solid #eef1f5;
    }


    .member-pagination-info {
        font-size: 11px;
        color: #64748b;
    }
</style>

<div class="p-2 member-participation-widget">

    <div class="member-table-toolbar">

        <div class="input-group input-group-sm member-search-box">
            <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
            </span>

            <input type="text"
                   id="groupMemberSearch"
                   class="form-control js-member-search"
                   placeholder="Search member..." />
        </div>

        <select id="groupMemberSort"
                class="form-select form-select-sm member-sort-box js-member-sort">

            <option value="highest">
                Highest points
            </option>

            <option value="lowest">
                Lowest points
            </option>

        </select>

    </div>


    <div class="member-list js-member-tbody">

        @if (Model == null || !Model.Any())
        {
            <div class="text-center text-muted py-4">
                No members found in this group.
            </div>
        }
        else
        {
            @foreach (var member in Model)
            {
                var barColor = member.Status switch
                {
                    MemberParticipationStatus.FullyPresent => "#16a34a",
                    MemberParticipationStatus.PartiallyPresent => "#f59e0b",
                    _ => "#dc2626"
                };

                <div class="member-row"
                     data-member-name="@member.FullName.ToLower()"
                     data-points="@member.EarnedEventPoints">

                    <div class="member-row-left">

                        @if (!string.IsNullOrEmpty(member.PhotoUrl))
                        {
                            <img src="@member.PhotoUrl"
                                 alt="@member.FullName"
                                 class="member-participation-avatar" />
                        }
                        else
                        {
                            <div class="member-avatar-placeholder">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }

                        <div>
                            <div class="member-name-text">
                                @member.FullName

                                @if (member.IsTopPerformer)
                                {
                                    <i class="bi bi-award-fill text-warning" title="Top performer"></i>
                                }
                            </div>

                            <div class="member-sub-text">
                                @member.EventsPresent of @member.EventsAssigned events

                                @if (member.EventsAbsent > 0)
                                {
                                    <span class="text-danger">&nbsp;&middot;&nbsp;@member.EventsAbsent Absent</span>
                                }
                            </div>
                        </div>

                    </div>


                    <div class="member-row-right">

                        <div class="member-points-text">
                            <span class="fw-semibold points-earned">@member.EarnedEventPoints</span>
                            <span class="text-muted">of @member.TotalPossiblePoints pts</span>
                        </div>

                        <div class="member-rate">
                            <div class="participation-rate-bar">
                                <div class="participation-rate-bar-fill"
                                     style="width:@member.ParticipationRate.ToString("0")%; background:@barColor;">
                                </div>
                            </div>

                            <span class="rate-value">
                                @member.ParticipationRate.ToString("0")%
                            </span>
                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>


<style>

    .member-table-toolbar {
        display: flex;
        justify-content: flex-start;
        gap: 10px;
        margin-bottom: 16px;
    }

    .member-search-box {
        width: 230px;
    }

        .member-search-box .input-group-text {
            border-right: none;
            color: #94a3b8;
        }

        .member-search-box .form-control {
            border-left: none;
            font-size: 13px;
        }

            .member-search-box .form-control:focus {
                box-shadow: none;
                border-color: #dbe1ea;
            }

    .member-sort-box {
        width: 165px;
        font-size: 13px;
    }


    .member-list {
        display: flex;
        flex-direction: column;
    }


    .member-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 4px;
        border-bottom: 1px solid #eef1f5;
    }

        .member-row:last-child {
            border-bottom: none;
        }


    .member-row-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }


    .member-participation-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }


    .member-avatar-placeholder {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }


    .member-name-text {
        font-weight: 600;
        color: #0f172a;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }


    .member-sub-text {
        font-size: 12px;
        color: #64748b;
        margin-top: 2px;
    }


    .member-row-right {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-shrink: 0;
    }


    .member-points-text {
        font-size: 14px;
        white-space: nowrap;
        min-width: 90px;
        text-align: right;
    }

        .member-points-text .points-earned {
            color: #7c3aed;
        }


    .member-rate {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 110px;
    }


    .participation-rate-bar {
        flex-grow: 1;
        height: 4px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
        min-width: 60px;
    }


    .participation-rate-bar-fill {
        height: 100%;
        border-radius: 999px;
    }


    .rate-value {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        min-width: 34px;
    }


    /* ============================
           PAGINATION (created by JS)
        ============================= */

    .member-table-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 14px;
        margin-top: 6px;
        border-top: 1px solid #eef1f5;
    }


    .member-pagination-info {
        font-size: 12px;
        color: #64748b;
    }


    .member-pagination-list {
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .member-pagination-list button {
            border: none;
            background: transparent;
            min-width: 26px;
            height: 26px;
            border-radius: 6px;
            font-size: 12px;
            color: #475569;
        }

            .member-pagination-list button:hover:not(:disabled) {
                background: #f1f5f9;
            }

            .member-pagination-list button.active {
                background: #2563eb;
                color: #fff;
            }

            .member-pagination-list button:disabled {
                color: #cbd5e1;
            }


    @@media (max-width: 576px) {

        .member-table-toolbar {
            flex-wrap: wrap;
        }

        .member-search-box,
        .member-sort-box {
            width: 100%;
        }

        .member-row {
            flex-wrap: wrap;
        }

        .member-row-right {
            width: 100%;
            justify-content: space-between;
        }
    }

</style>