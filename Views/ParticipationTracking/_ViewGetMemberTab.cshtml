@model List<Sym_Connect__Capstone2_.ViewModels.Participation.MemberParticipationViewModel>
@using Sym_Connect__Capstone2_.Models.Enums

<div id="memberParticipationWrapper" class="participation-table-card">

    <!-- HEADER -->
    <div class="participation-table-header">

        <div>
            <h6 class="mb-1 fw-semibold">
                Member Participation
            </h6>

            <div class="text-muted small">
                View participation performance of individual members.
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <!-- SEARCH -->
            <div class="participation-search">
                <i class="bi bi-search"></i>

                <input type="text"
                       id="memberSearchInput"
                       placeholder="Search member..." />
            </div>

            <!-- FILTER -->
            <select id="memberStatusFilter"
                    class="form-select form-select-sm participation-status-filter">

                <option value="">
                    All Status
                </option>

                <option value="@MemberParticipationStatus.FullyPresent">
                    Fully Present
                </option>

                <option value="@MemberParticipationStatus.PartiallyPresent">
                    Partially Present
                </option>

                <option value="@MemberParticipationStatus.Absent">
                    Absent
                </option>

            </select>

        </div>

    </div>


    <!-- TABLE -->
    <div class="table-responsive">

        <table class="table participation-table mb-0"
               id="memberParticipationTable">

            <thead>

                <tr>
                    <th>MEMBER NAME</th>

                    <th>GROUP</th>

                    <th class="text-center">
                        EVENTS ATTENDED
                    </th>

                    <th class="text-center participation-parent-header"
                        colspan="2">
                        PARTICIPATION
                    </th>

                    <th>RATE</th>

                    <th>STATUS</th>
                </tr>


                <tr class="participation-subheader">

                    <th></th>
                    <th></th>
                    <th></th>

                    <th class="text-center text-success">
                        PRESENT
                    </th>

                    <th class="text-center text-danger">
                        ABSENT
                    </th>

                    <th></th>
                    <th></th>

                </tr>

            </thead>


            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-5">

                            No member participation data found.

                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var member in Model)
                    {
                        var statusClass = member.Status switch
                        {
                            MemberParticipationStatus.FullyPresent
                                => "status-fully-present",

                            MemberParticipationStatus.PartiallyPresent
                                => "status-partially-present",

                            _ => "status-absent"
                        };


                        var statusLabel = member.Status switch
                        {
                            MemberParticipationStatus.FullyPresent
                                => "Fully Present",

                            MemberParticipationStatus.PartiallyPresent
                                => "Partially Present",

                            _ => "Absent"
                        };


                        var barColor = member.Status switch
                        {
                            MemberParticipationStatus.FullyPresent
                                => "#16a34a",

                            MemberParticipationStatus.PartiallyPresent
                                => "#f59e0b",

                            _ => "#dc2626"
                        };


                        <tr class="member-row"
                            data-name="@member.FullName.ToLower()"
                            data-status="@member.Status">


                            <!-- MEMBER -->
                            <td>

                                <div class="d-flex align-items-center gap-2">

                                    @if (!string.IsNullOrEmpty(member.PhotoUrl))
                                    {
                                        <img src="@member.PhotoUrl"
                                             alt="@member.FullName"
                                             class="member-participation-avatar" />
                                    }
                                    else
                                    {
                                        <div class="member-avatar-placeholder">

                                            <i class="bi bi-person-fill"></i>

                                        </div>
                                    }


                                    <div>

                                        <div class="member-name-text">
                                            @member.FullName
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- GROUP -->
                            <td>

                                <span class="member-group-text">
                                    @member.GroupName
                                </span>

                            </td>


                            <!-- EVENTS -->
                            <td class="text-center table-number">
                                <span class="fw-semibold">@member.EventsPresent</span>
                                <span class="text-muted">/@member.EventsAssigned</span>
                            </td>

                            <!-- PRESENT -->
                            <td class="text-center participation-value text-success">

                                @member.EventsPresent

                            </td>


                            <!-- ABSENT -->
                            <td class="text-center participation-value text-danger">

                                @member.EventsAbsent

                            </td>


                            <!-- RATE -->
                            <td style="min-width:110px;">

                                <div class="d-flex align-items-center gap-2">

                                    <div class="participation-rate-bar flex-grow-1">

                                        <div class="participation-rate-bar-fill"
                                             style="
                                            width:@member.ParticipationRate.ToString("0")%;
                                            background:@barColor;">
                                        </div>

                                    </div>

                                    <span class="rate-value">

                                        @member.ParticipationRate.ToString("0")%

                                    </span>

                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>

                                <span class="status-badge @statusClass">
                                    @statusLabel
                                </span>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>


    @* <!-- FOOTER --> *@
    @if (Model != null && Model.Any())
    {
        <div class="participation-table-footer">

            <span class="text-muted small"
                  id="memberShowingLabel">

                Showing 1 to @Math.Min(5, Model.Count)
                of @Model.Count members

            </span>


            <nav>

                <ul class="pagination pagination-sm participation-pagination mb-0">

                    <li class="page-item disabled">
                        <a class="page-link" href="#">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    <li class="page-item active">
                        <a class="page-link" href="#">
                            1
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="#">
                            2
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="#">
                            3
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="#">
                            4
                        </a>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="#">
                            5
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            ...
                        </span>
                    </li>

                    <li class="page-item">

                        <a class="page-link" href="#">
                            @(((Model.Count - 1) / 5) + 1)
                        </a>

                    </li>

                    <li class="page-item">
                        <a class="page-link" href="#">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>

                </ul>

            </nav>

        </div>
    }

</div>


<style>

    /* ==============================
           TABLE CONTAINER
           ============================== */

    .participation-table-card {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #ffffff;
        overflow: hidden;
    }


    /* ==============================
           HEADER
           ============================== */

    .participation-table-header {
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        border-bottom: 1px solid #e5e7eb;
    }


    /* ==============================
           SEARCH
           ============================== */

    .participation-search {
        width: 210px;
        height: 34px;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 10px;
        background: #fff;
        border: 1px solid #dbe1ea;
        border-radius: 7px;
    }


        .participation-search i {
            color: #94a3b8;
            font-size: 12px;
        }


        .participation-search input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            font-size: 12px;
            color: #334155;
        }


            .participation-search input::placeholder {
                color: #94a3b8;
            }


    .participation-status-filter {
        width: 135px;
        height: 34px;
        border-radius: 7px;
        border-color: #dbe1ea;
        font-size: 12px;
        color: #475569;
    }


    /* ==============================
           TABLE
           ============================== */

    .participation-table {
        font-size: 12px;
        color: #334155;
    }


        .participation-table thead th {
            padding: 10px 12px;
            background: #f8fafc;
            color: #64748b;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: .02em;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }


        .participation-table .participation-subheader th {
            padding-top: 4px;
            padding-bottom: 7px;
            background: #f8fafc;
            font-size: 8.5px;
        }


    .participation-parent-header {
        border-bottom: none !important;
    }


    .participation-table tbody td {
        padding: 12px;
        border-color: #edf0f5;
        vertical-align: middle;
    }


    .participation-table tbody tr {
        transition: background .15s ease;
    }


        .participation-table tbody tr:hover {
            background: #fafcff;
        }


    /* ==============================
           MEMBER AVATAR
           ============================== */

    .member-participation-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }


    .member-avatar-placeholder {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #64748b;
        font-size: 12px;
        flex-shrink: 0;
    }


    .member-name-text {
        color: #0f172a;
        font-weight: 600;
        white-space: nowrap;
    }


    .member-group-text {
        color: #64748b;
        font-size: 11.5px;
    }


    /* ==============================
           NUMBERS
           ============================== */

    .table-number {
        color: #334155;
        font-weight: 500;
    }


    .participation-value {
        font-weight: 600;
    }


    /* ==============================
           RATE
           ============================== */

    .participation-rate-bar {
        min-width: 45px;
        height: 4px;
        overflow: hidden;
        background: #e5e7eb;
        border-radius: 999px;
    }


    .participation-rate-bar-fill {
        height: 100%;
        border-radius: 999px;
    }


    .rate-value {
        min-width: 30px;
        color: #475569;
        font-size: 11px;
        font-weight: 600;
    }


    /* ==============================
           STATUS
           ============================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 9.5px;
        font-weight: 600;
        white-space: nowrap;
    }


    .status-fully-present {
        color: #15803d;
        background: #dcfce7;
    }


    .status-partially-present {
        color: #b45309;
        background: #fef3c7;
    }


    .status-absent {
        color: #b91c1c;
        background: #fee2e2;
    }


    /* ==============================
           FOOTER
           ============================== */

    .participation-table-footer {
        min-height: 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-top: 1px solid #e5e7eb;
    }


    /* ==============================
           PAGINATION
           ============================== */

    .participation-pagination .page-link {
        min-width: 30px;
        margin: 0 2px;
        text-align: center;
        border: none;
        border-radius: 6px !important;
        color: #475569;
        font-size: 11px;
    }


    .participation-pagination .page-item.active .page-link {
        background: #2563eb;
        color: #fff;
    }


    /* ==============================
           MOBILE
           ============================== */

    @@media (max-width: 768px) {

        .participation-search {
            width: 100%;
        }


        .participation-status-filter {
            width: 100%;
        }


        .participation-table-header > div:last-child {
            width: 100%;
        }
    }

</style>


<script>

    (function () {

        const searchInput =
            document.getElementById(
                'memberSearchInput'
            );

        const statusFilter =
            document.getElementById(
                'memberStatusFilter'
            );

        const rows =
            document.querySelectorAll(
                '#memberParticipationTable .member-row'
            );


        function applyMemberFilters() {

            const term =
                (searchInput?.value || '')
                    .toLowerCase()
                    .trim();


            const status =
                statusFilter?.value || '';


            rows.forEach(function (row) {

                const matchesName =
                    row.dataset.name.includes(term);


                const matchesStatus =
                    !status ||
                    row.dataset.status === status;


                row.style.display =
                    matchesName && matchesStatus
                        ? ''
                        : 'none';

            });

        }


        searchInput?.addEventListener(
            'input',
            applyMemberFilters
        );


        statusFilter?.addEventListener(
            'change',
            applyMemberFilters
        );

    })();

</script>