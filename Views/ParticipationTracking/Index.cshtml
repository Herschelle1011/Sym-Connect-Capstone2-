@model Sym_Connect__Capstone2_.ViewModels.Participation.ParticipationTrackingViewModel

@{
    ViewData["Title"] = "Participation Tracking";
    Layout = "_AdminLayout";
}

<style>
    .participation-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
    }

    .page-subtitle {
        font-size: 14px;
        color: #64748b;
    }

    .top-action-btn {
        height: 40px;
        border-radius: 8px;
        font-size: 13px;
        padding: 0 14px;
    }

    /* SUMMARY */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 18px;
        min-height: 110px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .summary-number {
        font-size: 26px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 5px;
    }

    .summary-label {
        font-size: 13px;
        font-weight: 600;
        color: #1f2937;
    }

    .summary-sub {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 3px;
    }

    .bg-purple-subtle {
        background: #f3e8ff;
    }

    .text-purple {
        color: #9333ea;
    }

    /* MAIN PANEL */
    .participation-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 0;
    }

    .participation-panel-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        border-bottom: 1px solid #e5e7eb;
        padding: 0 18px;
    }

    #participationTab {
        border: none;
        margin: 0;
    }

        #participationTab .nav-link {
            border: 0;
            border-bottom: 2px solid transparent;
            border-radius: 0;
            background: transparent;
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
            padding: 16px 10px 13px;
            margin-right: 18px;
        }

            #participationTab .nav-link.active {
                color: #2563eb;
                border-bottom-color: #2563eb;
            }

    .participation-panel-body {
        padding: 18px;
    }

    .participation-description {
        font-size: 12.5px;
        color: #64748b;
        margin-bottom: 14px;
    }

    .panel-actions .btn {
        height: 38px;
        font-size: 13px;
        border-radius: 8px;
    }

    /* DATE RANGE DROPDOWN */
    .date-range-error {
        font-size: 11.5px;
        color: #dc2626;
        margin-top: -4px;
        margin-bottom: 10px;
        display: none;
    }

        .date-range-error.show {
            display: block;
        }

    .date-range-clear {
        font-size: 11.5px;
        color: #64748b;
        text-decoration: none;
        display: inline-block;
        margin-top: 2px;
    }

        .date-range-clear:hover {
            color: #2563eb;
        }

    /* LEGEND */
    .participation-legend {
        margin-top: 16px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 13px 16px;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

    .legend-text {
        font-size: 11.5px;
        color: #475569;
    }

    .legend-title {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
    }

    .rate-formula {
        font-size: 11.5px;
        color: #475569;
        white-space: nowrap;
    }

    /* STATUS */
    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-fully-present {
        background: #dcfce7;
        color: #15803d;
    }

    .status-partially-present {
        background: #fef3c7;
        color: #b45309;
    }

    .status-absent {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* RATE BAR */
    .participation-rate-bar {
        width: 100%;
        height: 4px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    .participation-rate-bar-fill {
        height: 100%;
        border-radius: 999px;
    }

    @@media (max-width: 1200px) {
        .summary-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 500px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="participation-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <h1 class="page-title mb-1">Participation Tracking</h1>
            <p class="page-subtitle mb-0">
                Track attendance and participation of groups and members across all events.
            </p>
        </div>

        <div class="d-flex gap-2">
            <div class="dropdown">
                <button class="btn btn-outline-secondary top-action-btn d-flex align-items-center gap-2"
                        type="button"
                        id="dateRangeBtn"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside">
                    <i class="bi bi-calendar3"></i>
                    <span id="dateRangeLabel">All Dates</span>
                    <i class="bi bi-chevron-down small"></i>
                </button>

                <div class="dropdown-menu dropdown-menu-end p-3"
                     style="min-width:280px;">

                    <div class="mb-2">
                        <label class="form-label small text-muted">From</label>
                        <input type="date"
                               id="ptFromDate"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small text-muted">To</label>
                        <input type="date"
                               id="ptToDate"
                               class="form-control form-control-sm" />
                    </div>

                    <div id="ptDateRangeError" class="date-range-error"></div>

                    <button type="button"
                            id="ptApplyDateRange"
                            class="btn btn-sm btn-primary w-100">
                        Apply
                    </button>

                    <div class="text-center">
                        <a href="#" id="ptClearDateRange" class="date-range-clear">
                            Clear range
                        </a>
                    </div>
                </div>
            </div>

          
        </div>
    </div>


    <!-- SUMMARY -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-icon bg-primary-subtle text-primary">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <div class="summary-number text-primary">
                    @Model.Summary.TotalGroups
                </div>

                <div class="summary-label">
                    Total Groups
                </div>

                <div class="summary-sub">
                    Assigned to events
                </div>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon bg-success-subtle text-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>
                <div class="summary-number text-success">
                    @Model.Summary.FullyPresentGroups
                </div>

                <div class="summary-label text-success">
                    Fully Present
                </div>

                <div class="summary-sub">
                    Groups
                    &nbsp;
                    @(Model.Summary.TotalGroups == 0
                        ? "0.00"
                        : Math.Round(
                            (double)Model.Summary.FullyPresentGroups /
                            Model.Summary.TotalGroups * 100,
                            2
                        ).ToString("0.00"))%
                </div>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon bg-warning-subtle text-warning">
                <i class="bi bi-dash-circle-fill"></i>
            </div>

            <div>
                <div class="summary-number text-warning">
                    @Model.Summary.PartiallyPresentGroups
                </div>

                <div class="summary-label text-warning">
                    Partially Present
                </div>

                <div class="summary-sub">
                    Groups
                    &nbsp;
                    @(Model.Summary.TotalGroups == 0
                        ? "0.00"
                        : Math.Round(
                            (double)Model.Summary.PartiallyPresentGroups /
                            Model.Summary.TotalGroups * 100,
                            2
                        ).ToString("0.00"))%
                </div>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon bg-danger-subtle text-danger">
                <i class="bi bi-x-circle-fill"></i>
            </div>

            <div>
                <div class="summary-number text-danger">
                    @Model.Summary.AbsentGroups
                </div>

                <div class="summary-label text-danger">
                    Absent Groups
                </div>

                <div class="summary-sub">
                    @(Model.Summary.TotalGroups == 0
                        ? "0.00"
                        : Math.Round(
                            (double)Model.Summary.AbsentGroups /
                            Model.Summary.TotalGroups * 100,
                            2
                        ).ToString("0.00"))%
                </div>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon bg-purple-subtle text-purple">
                <i class="bi bi-person-fill"></i>
            </div>

            <div>
                <div class="summary-number text-purple">
                    @Model.Summary.TotalMembers
                </div>

                <div class="summary-label">
                    Total Members
                </div>

                <div class="summary-sub">
                    Across all groups
                </div>
            </div>
        </div>
    </div>


    <!-- MAIN PARTICIPATION PANEL -->
    <div class="participation-panel">
        <div class="participation-panel-body">

            <p class="participation-description"
               id="participationTabDescription">
                Track participation of groups across all events.
            </p>

            <div class="tab-content">

                <div class="tab-pane fade show active"
                     id="groups-pane">

                    @await Html.PartialAsync(
                        "_ViewGetGroupTab",
                        Model.Groups
                    )

                </div>

                

            </div>

        </div>

    </div>


    <!-- LEGEND -->
    <div class="participation-legend">

        <div class="d-flex flex-wrap align-items-center gap-4">

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill text-primary"></i>
                <span class="legend-title">Legend</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="legend-dot bg-success"></span>

                <span class="legend-text">
                    <strong class="text-success">
                        Fully Present:
                    </strong>

                    Attended all assigned events.
                </span>
            </div>


            <div class="d-flex align-items-center gap-2">
                <span class="legend-dot bg-warning"></span>

                <span class="legend-text">
                    <strong class="text-warning">
                        Partially Present:
                    </strong>

                    Attended some of the assigned events.
                </span>
            </div>


            <div class="d-flex align-items-center gap-2">
                <span class="legend-dot bg-danger"></span>

                <span class="legend-text">
                    <strong class="text-danger">
                        Absent:
                    </strong>

                    Did not attend any assigned events.
                </span>
            </div>


            <div class="ms-auto rate-formula">
                Rate = (Present / Events Assigned) × 100%
            </div>

        </div>

    </div>

</div>


@section Scripts {
    <script src="~/js/admin/ParticipationTracking.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var groupsTab = document.getElementById('groups-tab');
            var membersTab = document.getElementById('members-tab');
            var description = document.getElementById('participationTabDescription');

            if (groupsTab && membersTab && description) {
                groupsTab.addEventListener('shown.bs.tab', function () {
                    description.textContent = 'Track participation of groups across all events.';
                });
                membersTab.addEventListener('shown.bs.tab', function () {
                    description.textContent = 'Track participation of individual members across all events.';
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var fromInput = document.getElementById('ptFromDate');
            var toInput = document.getElementById('ptToDate');
            var applyBtn = document.getElementById('ptApplyDateRange');
            var clearLink = document.getElementById('ptClearDateRange');
            var errorEl = document.getElementById('ptDateRangeError');
            var label = document.getElementById('dateRangeLabel');

            function formatLabel(fromStr, toStr) {
                var opts = { month: 'short', day: 'numeric', year: 'numeric' };
                var fromDate = new Date(fromStr + 'T00:00:00');
                var toDate = new Date(toStr + 'T00:00:00');
                return fromDate.toLocaleDateString('en-US', opts) + ' - ' + toDate.toLocaleDateString('en-US', opts);
            }

            function showError(message) {
                errorEl.textContent = message;
                errorEl.classList.add('show');
            }

            function clearError() {
                errorEl.textContent = '';
                errorEl.classList.remove('show');
            }

      
            var params = new URLSearchParams(window.location.search);
            var urlFrom = params.get('fromDate');
            var urlTo = params.get('toDate');

            if (urlFrom) fromInput.value = urlFrom;
            if (urlTo) toInput.value = urlTo;
            if (urlFrom && urlTo) {
                label.textContent = formatLabel(urlFrom, urlTo);
            }

            applyBtn.addEventListener('click', function () {
                clearError();

                var fromVal = fromInput.value;
                var toVal = toInput.value;

                if (!fromVal || !toVal) {
                    showError('Please select both a From and To date.');
                    return;
                }

                if (new Date(fromVal) > new Date(toVal)) {
                    showError('The "From" date must be before the "To" date.');
                    return;
                }

                var url = new URL(window.location.href);
                url.searchParams.set('fromDate', fromVal);
                url.searchParams.set('toDate', toVal);
                window.location.href = url.toString();
            });

            clearLink.addEventListener('click', function (e) {
                e.preventDefault();

                var url = new URL(window.location.href);
                url.searchParams.delete('fromDate');
                url.searchParams.delete('toDate');
                window.location.href = url.toString();
            });
        });


        document.addEventListener('DOMContentLoaded', function () {

        var exportBtn = document.getElementById('exportPdfBtn');

        if (!exportBtn) return;

        exportBtn.addEventListener('click', function () {

        var jsPDFCtor = window.jspdf.jsPDF;
        var doc = new jsPDFCtor({ orientation: 'landscape' });

        doc.setFontSize(14);
        doc.text('Participation Tracking - Group Report', 14, 15);

        var generatedOn = new Date().toLocaleString();
        doc.setFontSize(9);
        doc.setTextColor(120);
        doc.text('Generated: ' + generatedOn, 14, 21);


        // Respect the current search + status filter,
        // ignore pagination (export the full filtered set).

        var searchTerm =
        (document.getElementById('groupSearchInput')?.value || '')
        .toLowerCase()
        .trim();

        var status =
        document.getElementById('groupStatusFilter')?.value || '';

        var rows = Array.from(
        document.querySelectorAll('#groupParticipationTable tbody .group-row')
        )
        .filter(function (row) {

        var matchesName = row.dataset.name.includes(searchTerm);
        var matchesStatus = !status || row.dataset.status === status;

        return matchesName && matchesStatus;
        })
        .map(function (row) {

        var cells = row.querySelectorAll('td');

        return [
        cells[0].querySelector('.group-name-text')?.textContent.trim() || '',
        cells[1].textContent.trim(),
        cells[2].textContent.replace(/\s+/g, ' ').trim(),
        cells[3].textContent.trim(),
        cells[4].textContent.trim(),
        cells[5].textContent.trim(),
        cells[6].textContent.replace(/\s+/g, ' ').trim(),
        cells[7].querySelector('.rate-value')?.textContent.trim() || ''
        ];
        });

        doc.autoTable({
        startY: 27,
        head: [[
        'Group Name', 'Total Members', 'Events Assigned',
        'Fully Present', 'Partial', 'Absent',
        'Points', 'Rate'
        ]],
        body: rows,
        styles: { fontSize: 8, cellPadding: 3 },
        headStyles: { fillColor: [37, 99, 235], textColor: 255 },
        alternateRowStyles: { fillColor: [248, 250, 252] }
        });

        var filename =
        'participation-tracking-' +
        new Date().toISOString().slice(0, 10) +
        '.pdf';

        doc.save(filename);
        });

        });
    </script>
}
<partial name="_GroupParticipationModal" />