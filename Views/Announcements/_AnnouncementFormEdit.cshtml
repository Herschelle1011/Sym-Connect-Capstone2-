@model Sym_Connect__Capstone2_.ViewModels.Announcement.AnnouncementViewModel
@using Sym_Connect__Capstone2_.Models.Enums.AnnouncementEnums

<form id="announcementForm" data-mode="edit" asp-controller="Announcement" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="AnnouncementId" />

    <div class="form-group">
        <label asp-for="Title">Title <span class="required">*</span></label>
        <input asp-for="Title" class="form-control" placeholder="Enter title" />
        <span asp-validation-for="Title" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Content">Content <span class="required">*</span></label>
        <textarea asp-for="Content" class="form-control" rows="5" placeholder="Write announcement content..."></textarea>
        <span asp-validation-for="Content" class="field-error"></span>
    </div>

    <div class="form-group">
        <label>Target Audience <span class="required">*</span></label>
        <div class="radio-grid">
            <label class="radio-option">
                <input type="radio" asp-for="TargetAudience" value="@TargetAudience.Everyone"
                       checked="@(Model.TargetAudience == TargetAudience.Everyone)" />
                <span>Everyone</span>
            </label>
            <label class="radio-option">
                <input type="radio" asp-for="TargetAudience" value="@TargetAudience.AllMembers"
                       checked="@(Model.TargetAudience == TargetAudience.AllMembers)" />
                <span>All Members</span>
            </label>
            <label class="radio-option">
                <input type="radio" asp-for="TargetAudience" value="@TargetAudience.AllLeaders"
                       checked="@(Model.TargetAudience == TargetAudience.AllLeaders)" />
                <span>All Leaders</span>
            </label>
            <label class="radio-option">
                <input type="radio" asp-for="TargetAudience" value="@TargetAudience.SpecificGroup"
                       checked="@(Model.TargetAudience == TargetAudience.SpecificGroup)" />
                <span>Specific Group</span>
            </label>
        </div>
        <span asp-validation-for="TargetAudience" class="field-error"></span>
    </div>

    <div class="form-group conditional-field" id="groupField">
        <label asp-for="GroupId">Select Group</label>
        <select asp-for="GroupId" asp-items="Model.GroupOptions" class="form-control">
            <option value="">-- Select a group --</option>
        </select>
        <span asp-validation-for="GroupId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="PublishOption">Publish Option</label>
        <select asp-for="PublishOption" class="form-control" id="publishOptionSelect">
            <option value="@PublishOption.Now">Publish Now</option>
            <option value="@PublishOption.Scheduled">Scheduled</option>
            </select>
        </div>

    <div class="form-group conditional-field" id="scheduleField">
        <label asp-for="PublishDate">Schedule Date &amp; Time</label>
        <input asp-for="PublishDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="PublishDate" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ExpirationOption">Expiration</label>
        <select asp-for="ExpirationOption" class="form-control" id="expirationOptionSelect">
 <option value="@ExpirationOption.OneDay">One Day</option>
            <option value="@ExpirationOption.TwoDays">Two Days</option>
            <option value="@ExpirationOption.ThreeDays">Three Days</option>
            <option value="@ExpirationOption.Custom">Custom</option>
            </select>
            <small class="hint-text">Expired announcements stay in history but stop appearing as active.</small>
    </div>

    <div class="form-group conditional-field" id="customExpirationField">
        <label asp-for="CustomExpirationDate">Custom Expiration Date &amp; Time</label>
        <input asp-for="CustomExpirationDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="CustomExpirationDate" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="checkbox-option">
            <input type="checkbox" asp-for="IsPinned" />
            <span>Pin to dashboard</span>
        </label>
        <small class="hint-text">Only one announcement can be pinned at a time. Pinning this will unpin any other.</small>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="btnCancelAnnouncement">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Announcement</button>
    </div>
</form>
