@model List<Sym_Connect__Capstone2_.ViewModels.Announcement.ListAnnouncementViewModel>
@{
    ViewData["Title"] = "Announcements";
    Layout = "_AdminLayout";

    var now = DateTime.Now;
}

<link rel="stylesheet" href="~/css/admin/announcement.css" asp-append-version="true" />



<div class="announcement-page">
    <div class="page-header">
        <div>
            <div class="page-eyebrow"></div>
            <h2>Announcements</h2>
            <p class="page-subtitle">Create and manage announcements for SYM members, leaders, and groups.</p>
        </div>
        <button type="button" class="btn btncreateann" id="btnNewAnnouncement">
            <i class=""></i> New Announcement
        </button>
    </div>

    <div class="announcement-toolbar">

        <div class="ann-tabs">
            <button type="button" class="ann-tab active" data-tab="all">All</button>
            <button type="button" class="ann-tab" data-tab="pinned">Pinned</button>
        </div>

        <select id="audienceFilter" class="filter-select">
            <option value="">Filter</option>
            @foreach (var val in Enum.GetValues(typeof(Sym_Connect__Capstone2_.Models.Enums.AnnouncementEnums.TargetAudience)))
            {
                <option value="@val">@val</option>
            }
        </select>

        <div class="search-box">
            <i class=""></i>
            <input type="text" id="announcementSearch" placeholder="Search announcements..." />
        </div>

    </div>

    <div class="ann-card-list" id="announcementTableBody">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <i class="ti ti-speakerphone"></i>
                <div>No announcements yet.</div>
            </div>
        }
        else
        {
            @* Pinned announcement (if any) is guaranteed to render first *@
            foreach (var a in Model.OrderByDescending(x => x.IsPinned).ThenByDescending(x => x.CreatedAt))
            {
                var isExpired =
                    a.ExpiresAt.HasValue &&
                    a.ExpiresAt.Value <= now;

                var isScheduled =
                    a.PublishDate.HasValue &&
                    a.PublishDate.Value > now;

                var status =
                    isExpired
                        ? "Expired"
                        : isScheduled
                            ? "Scheduled"
                            : "Published";

                var statusPillClass =
                    isExpired
                        ? "pill-expired"
                        : isScheduled
                            ? "pill-scheduled"
                            : "pill-live";

                // Per-audience pill color, matched to the reference design.
                // Adjust the enum member names below if yours differ.
                var audiencePillClass = a.TargetType switch
                {
                    TargetAudience.Everyone => "pill-audience-everyone",
                    TargetAudience.AllLeaders => "pill-audience-leaders",
                    TargetAudience.AllMembers => "pill-audience-members",
                    TargetAudience.SpecificGroup => "pill-audience-group",
                    _ => "pill-audience"
                };

                <div class="ann-card @(a.IsPinned ? "pinned" : "")"
                     data-id="@a.AnnouncementId"
                     data-audience="@a.TargetType"
                     data-status="@status"
                     data-pinned="@a.IsPinned.ToString().ToLower()">

                    <div class="ann-card-header">

                        <div class="ann-avatar">
                            @if (!string.IsNullOrEmpty(a.CreatedByPhotoUrl))
                            {
                                <img src="@a.CreatedByPhotoUrl"
                                     alt="Profile photo" />
                            }
                            else
                            {
                                <i class="ti ti-user"></i>
                            }
                        </div>

                        <div class="ann-card-headtext">

                            <div class="ann-card-title-row">

                                <h3 class="ann-card-title">@a.Title</h3>

                                <div class="ann-card-menu-wrapper">

                                    <button type="button" class="btn-icon btn-more" data-id="@a.AnnouncementId" title="More">
                                        <i class="ti ti-dots-vertical"></i>
                                    </button>

                                    <div class="ann-dropdown-menu" hidden>

                                        <button type="button" class="dropdown-item btnEditAnnouncement" data-id="@a.AnnouncementId">
                                            <i class="ti ti-pencil"></i> Edit
                                        </button>

                                        <button type="button" class="dropdown-item dropdown-item-danger btnArchiveAnnouncement" data-id="@a.AnnouncementId">
                                            <i class="ti ti-trash"></i> Delete
                                        </button>

                                    </div>

                                </div>

                            </div>

                            <div class="ann-card-meta">

                                <span class="pill pill-posted-by">
                                    <i class="ti ti-user"></i>
                                    Posted by @(string.IsNullOrEmpty(a.CreatedBy) ? "Admin" : a.CreatedBy)
                                </span>

                                @if (a.IsPinned)
                                {
                                    <span class="badge-pinned">PINNED</span>
                                }

                                <span class="pill @audiencePillClass">
                                    <i class="ti ti-users"></i>
                                    @a.TargetType
                                </span>

                                <span class="pill @statusPillClass">
                                    @status
                                </span>

                                @if (a.TargetType == TargetAudience.SpecificGroup && !string.IsNullOrEmpty(a.GroupName))
                                {
                                    <span class="ann-meta-plain">@a.GroupName</span>
                                }

                                <span class="ann-meta-plain">
                                    <i class="ti ti-calendar"></i>
                                    @a.CreatedAt.ToString("MMM d, yyyy")
                                </span>

                                <span class="ann-meta-plain">
                                    <i class="ti ti-clock"></i>
                                    @a.CreatedAt.ToString("h:mm tt")
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="ann-card-body">

                        <p class="ann-card-desc" id="desc-@a.AnnouncementId">@a.Content</p>

                        <button type="button" class="btn-show-more" data-target="desc-@a.AnnouncementId" hidden>
                            Show more
                        </button>

                    </div>
                    @if (a.ExpiresAt.HasValue)
                    {
                        <div class="ann-card-footer">
                            <i class="ti ti-hourglass-low"></i>
                            Expires @a.ExpiresAt.Value.ToString("MMM d, yyyy") at @a.ExpiresAt.Value.ToString("h:mm tt")
                        </div>
                    }

                </div>
            }
        }

    </div>
</div>


@section Scripts {
    <script src="~/js/admin/announcement.js"></script>
}
