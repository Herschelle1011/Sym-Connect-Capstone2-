@model Sym_Connect__Capstone2_.ViewModels.Announcement.ArchiveAnnouncementViewModel

<div style="padding: 0 0.5rem 0.5rem;">

    <div style="display:flex; justify-content:center; margin-bottom: 1.25rem;">
        <div style="width:56px; height:56px; border-radius:50%;
            background:rgba(234,179,8,.12); border:1px solid rgba(234,179,8,.3);
            display:flex; align-items:center; justify-content:center;">
            <i class="bi bi-archive" style="font-size:1.4rem; color:#b45309;"></i>
        </div>
    </div>

    <h5 style="text-align:center; font-size:15px; font-weight:700;
        color:#111827; margin:0 0 6px;">
        Archive this announcement?
    </h5>
    <p style="text-align:center; font-size:13px; color:#6b7280;
        line-height:1.6; margin:0 0 1.25rem;">
        This announcement will be hidden from members. You can restore it later from the archive.
    </p>

    <div style="background:#f9fafb; border:1px solid #e5e7eb;
        border-radius:10px; padding:14px 16px; margin-bottom:1.5rem;">
        <div style="display:flex; flex-direction:column; gap:8px;">

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-speakerphone" style="margin-right:4px;"></i>Title
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.Title
                </span>
            </div>

            <div style="height:1px; background:#f0f0f0;"></div>

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-people" style="margin-right:4px;"></i>Audience
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.TargetType
                </span>
            </div>

            <div style="height:1px; background:#f0f0f0;"></div>

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-calendar" style="margin-right:4px;"></i>Created
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.CreatedAt.ToString("MMM d, yyyy")
                </span>
            </div>

        </div>
    </div>

    <form id="archiveForm"
          class="modal-ajax-form"
          action="@Url.Action("Archive", "Announcements")"
          method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.AnnouncementId" />

        <div style="display:flex; gap:10px;">
            <button type="button"
                    class="btn w-50"
                    data-bs-dismiss="modal"
                    style="font-size:13px;
                font-weight:500;
                border:1px solid #e5e7eb;
                border-radius:8px;
                padding:9px;
                background:#fff;
                color:#374151;">
                Cancel
            </button>

            <button type="submit" class="btn w-50"
                    style="font-size:13px; font-weight:600;
                border-radius:8px; padding:9px;
                background:#b45309; color:#fff; border:none;
                transition:background .15s;">
                <i class="bi bi-archive" style="margin-right:5px;"></i>Archive
            </button>
        </div>
    </form>

</div>