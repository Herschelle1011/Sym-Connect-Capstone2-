@model Sym_Connect__Capstone2_.ViewModels.Emails.MemberVerificationEmailViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email</title>
</head>

<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:'Segoe UI', Arial, sans-serif;">

    <table role="presentation"
           width="100%"
           cellpadding="0"
           cellspacing="0"
           style="background-color:#f1f5f9; padding:40px 0;">

        <tr>
            <td align="center">

                <table role="presentation"
                       width="480"
                       cellpadding="0"
                       cellspacing="0"
                       style="
                    width:100%;
                    max-width:480px;
                    background-color:#ffffff;
                    border-radius:12px;
                    overflow:hidden;
                    box-shadow:0 2px 8px rgba(0,0,0,0.06);
                    ">

                    <!-- HEADER -->
                    <tr>
                        <td align="center"
                            style="background-color:#4a6cf7; padding:32px 24px;">

                            <img src="https://res.cloudinary.com/dxzmz62w4/image/upload/v1780837507/facilities/Testing%20Room/21141848-1a2b-4cce-870f-e235625d0fd7.png"
                                 alt="SYM-Connect"
                                 width="48"
                                 height="48"
                                 style="
                            border-radius:8px;
                            display:block;
                            margin-bottom:12px;
                            " />

                            <span style="
                                color:#ffffff;
                                font-size:20px;
                                font-weight:600;
                                ">
                                SYM-Connect
                            </span>

                        </td>
                    </tr>

                    <!-- BODY -->
                    <tr>
                        <td style="padding:40px 32px;">

                            <h2 style="
                                margin:0 0 12px;
                                font-size:22px;
                                font-weight:700;
                                color:#111827;
                                ">
                                Welcome, @Model.FirstName
                            </h2>

                            <p style="
                                margin:0 0 16px;
                                font-size:15px;
                                line-height:1.6;
                                color:#4b5563;
                                ">
                                An administrator has created a SYM-Connect
                                account for you.
                            </p>

                            <p style="
                                margin:0 0 24px;
                                font-size:15px;
                                line-height:1.6;
                                color:#4b5563;
                                ">
                                Please verify that this email address belongs
                                to you. After verification, you will be asked
                                to create your account password.
                            </p>

                            <!-- VERIFY BUTTON -->
                            <table role="presentation"
                                   cellpadding="0"
                                   cellspacing="0"
                                   style="margin:0 auto 24px;">

                                <tr>
                                    <td align="center"
                                        style="
                                        border-radius:8px;
                                        background-color:#4a6cf7;
                                        ">

                                        <a href="@Model.ConfirmationLink"
                                           style="
                                            display:inline-block;
                                            padding:14px 32px;
                                            font-size:15px;
                                            font-weight:600;
                                            color:#ffffff;
                                            text-decoration:none;
                                            border-radius:8px;
                                            ">
                                            Verify Email Address
                                        </a>

                                    </td>
                                </tr>
                            </table>

                            <!-- FALLBACK LINK -->
                            <p style="
                                margin:0 0 8px;
                                font-size:13px;
                                color:#9ca3af;
                                text-align:center;
                                ">
                                If the button does not work, copy and paste
                                this link into your browser:
                            </p>

                            <p style="
                                margin:0;
                                font-size:12px;
                                color:#4a6cf7;
                                text-align:center;
                                word-break:break-all;
                                line-height:1.5;
                                ">
                                @Model.ConfirmationLink
                            </p>

                        </td>
                    </tr>

                    <!-- DIVIDER -->
                    <tr>
                        <td style="padding:0 32px;">
                            <div style="border-top:1px solid #e5e7eb;"></div>
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="
                            padding:24px 32px 32px;
                            text-align:center;
                            ">

                            <p style="
                                margin:0 0 8px;
                                font-size:12px;
                                line-height:1.5;
                                color:#9ca3af;
                                ">
                                If you were not expecting an account from
                                SYM-Connect, you can safely ignore this email.
                            </p>

                            <p style="
                                margin:0;
                                font-size:12px;
                                color:#c1c7d0;
                                ">
                                &copy; @DateTime.Now.Year SYM-Connect.
                                All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>