@model CreateElectionWizardViewModel
@{
    ViewData["Title"] = "Create New Evaluation";
    Layout = "_AdminLayout";

    //default dates
    var todayString = DateTime.Today.ToString("yyyy-MM-dd");
    var tomorrowString = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");

}

<style>
    .field-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
    }

    .party-card {
        cursor: pointer;
        border: 1.5px solid #E2E8F0;
        border-radius: 12px;
        padding: 1rem 1.15rem;
        background: #fff;
        transition: all 0.15s ease;
        display: block;
    }

        .party-card:hover {
            border-color: #93C5FD;
            background: #F0F6FF;
        }

        .party-card.is-checked {
            border-color: #2563EB;
            background: #EFF6FF;
        }

    .party-check {
        width: 1.1rem;
        height: 1.1rem;
        border-radius: 5px;
        border: 1.5px solid #CBD5E1;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .party-card.is-checked .party-check {
        border-color: #2563EB;
        background: #2563EB;
    }

    .btn-rounded-primary {
        background: #2563EB;
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.65rem 1.5rem;
        border-radius: 999px;
        border: none;
        transition: background 0.15s ease;
    }

        .btn-rounded-primary:hover {
            background: #1D4ED8;
            color: #fff;
        }

    .btn-rounded-ghost {
        background: transparent;
        border: 1px solid #E2E8F0;
        color: #475569;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.6rem 1.3rem;
        border-radius: 999px;
        transition: background 0.15s ease;
    }

        .btn-rounded-ghost:hover {
            background: #F8FAFC;
            color: #475569;
        }

    .quota-badge {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
    }

    .quota-pending {
        background: #FEF3C7;
        color: #B45309;
    }

    .quota-met {
        background: #DCFCE7;
        color: #15803D;
    }

    .party-checkbox-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    /* Fixed alignment styling for input group icons */
    .input-group-text svg {
        color: #94A3B8;
        width: 1rem;
        height: 1rem;
    }
</style>

<!-- Main Wrapper Layer using Bootstrap Containers -->
<div class="w-100 min-vh-100 bg-light py-5">
    <div class="container" style="max-width: 720px;">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index"
               class="page-back-btn" title="Back to Elections" aria-label="Back to Elections">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Create New Election</h1>
                <p class="text-muted small mb-0">Create evaluation details.</p>
            </div>
        </div>

        <div class="card border rounded-4 shadow-sm overflow-hidden bg-white">
            <div class="w-100 bg-primary" style="height: 6px;"></div>

            <form asp-action="Create" method="post" id="wizardForm" class="p-4 p-md-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 small"></div>

                <!-- ================= STEP 1: ELECTION DETAILS ================= -->
                <div id="step1Panel" class="d-flex flex-column gap-4">
                    <div>
                        <label asp-for="ElectionName" class="field-label mb-2">Election Title</label>
                        <input asp-for="ElectionName" type="text" class="form-control rounded-3 p-3 text-dark" style="font-size: 0.9rem;" placeholder="Enter title..." required />
                        <span asp-validation-for="ElectionName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Row 1: Dates with Native Bootstrap Input Groups -->
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="StartDate" class="field-label mb-2">Opens</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 rounded-start-3 px-3">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                </span>
                                <input asp-for="StartDate" type="date" value="@todayString" class="form-control border-start-0 rounded-end-3 p-3" required />
                            </div>
                            <span asp-validation-for="StartDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="EndDate" class="field-label mb-2">Closes</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 rounded-start-3 px-3">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                </span>
                                <input asp-for="EndDate" type="date" value="@tomorrowString" class="form-control border-start-0 rounded-end-3 p-3" required />
                            </div>
                            <span asp-validation-for="EndDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Row 2: Times with Native Bootstrap Input Groups -->
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="StartTime" class="field-label mb-2">Start Time</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 rounded-start-3 px-3">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                </span>
                                <input asp-for="StartTime" type="time" class="form-control border-start-0 rounded-end-3 p-3" required />
                            </div>
                            <span asp-validation-for="StartTime" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="EndTime" class="field-label mb-2">Close Time</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 rounded-start-3 px-3">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                </span>
                                <input asp-for="EndTime" type="time" class="form-control border-start-0 rounded-end-3 p-3" required />
                            </div>
                            <span asp-validation-for="EndTime" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
                <!-- ================= STEP 2: PARTYLIST SELECTION ================= -->
                <div id="step2Panel" class="d-none flex-column gap-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <label class="field-label mb-0">Available Partylists &middot; Click to add to voting</label>
                        <span class="quota-badge quota-pending" id="selectionCountNotice">Selected: 0 / 2</span>
                    </div>

                    <div class="row g-3">
                        @if (Model.AvailablePartyLists != null && Model.AvailablePartyLists.Any())
                        {
                            @foreach (var party in Model.AvailablePartyLists)
                            {
                                <div class="col-12 col-sm-6">
                                    <label class="party-card h-100 user-select-none">
                                        <input type="checkbox" name="SelectedPartyListIds" value="@party.Id" class="party-checkbox-hidden party-checkbox" />
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="party-check mt-1">
                                                <svg class="inner-check d-none" style="width: 10px; height: 10px; color:#ffffff;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="fw-semibold text-dark text-sm mb-1" style="font-size: 0.9rem;">@party.PartyListName</p>
                                                <p class="text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.78rem; line-height: 1.3;">@party.PartyListDescription</p>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-4">
                                <p class="text-muted small mb-0">
                                    No party lists are ready yet. A party list must have candidates
                                    assigned to every position before it can be added to an election.
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <!-- ================= FOOTER / CONTROLS ================= -->
                <div class="mt-4 pt-4 border-top d-flex align-items-center justify-content-between">
                    <span class="small fw-medium text-muted" id="stepIndicator">Step 1 of 2</span>

                    <div class="d-flex align-items-center gap-2">

                        <button type="button" id="prevBtn" class="btn-rounded-ghost d-none">Back</button>
                        <button type="button" id="nextBtn" class="btn-rounded-primary">Proceed</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const step1 = document.getElementById("step1Panel");
        const step2 = document.getElementById("step2Panel");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const stepIndicator = document.getElementById("stepIndicator");
        const checkboxes = document.querySelectorAll(".party-checkbox");
        const countNotice = document.getElementById("selectionCountNotice");
        const wizardForm = document.getElementById("wizardForm");

        let currentStep = 1;

        // Uses Bootstrap display helpers ('d-flex' / 'd-none')
        function updateWizardUI() {
            if (currentStep === 1) {
                step1.classList.add("d-flex");
                step1.classList.remove("d-none");
                step2.classList.add("d-none");
                step2.classList.remove("d-flex");
                prevBtn.classList.add("d-none");
                nextBtn.innerText = "Proceed";
                stepIndicator.innerText = "Step 1 of 2";
            } else {
                step1.classList.add("d-none");
                step1.classList.remove("d-flex");
                step2.classList.add("d-flex");
                step2.classList.remove("d-none");
                prevBtn.classList.remove("d-none");
                nextBtn.innerText = "Publish Election";
                stepIndicator.innerText = "Step 2 of 2";
            }
        }

        function updateCheckboxUI() {
            let checkedCount = 0;
            checkboxes.forEach(cb => {
                const container = cb.closest("label");
                const innerCheck = container.querySelector(".inner-check");
                if (cb.checked) {
                    checkedCount++;
                    container.classList.add("is-checked");
                    innerCheck.classList.remove("d-none");
                } else {
                    container.classList.remove("is-checked");
                    innerCheck.classList.add("d-none");
                }
            });

            countNotice.innerText = `Selected: ${checkedCount} / 2`;
            countNotice.className = checkedCount === 2 ? "quota-badge quota-met" : "quota-badge quota-pending";
        }

        checkboxes.forEach(cb => {
            cb.addEventListener("change", function () {
                let checkedCount = Array.from(checkboxes).filter(c => c.checked).length;
                if (checkedCount > 2) {
                    this.checked = false;
                    alert("You can only select exactly 2 partylists.");
                }
                updateCheckboxUI();
            });
        });

        nextBtn.addEventListener("click", function () {
            if (currentStep === 1) {
                const inputs = step1.querySelectorAll("input, textarea");
                let allValid = true;
                inputs.forEach(input => {
                    if (!input.checkValidity()) {
                        input.reportValidity();
                        allValid = false;
                    }
                });
                if (!allValid) return;

                currentStep = 2;
                updateWizardUI();
            } else {
                const checkedCount = Array.from(checkboxes).filter(c => c.checked).length;
                if (checkedCount !== 2) {
                    alert("Select exactly 2 partylists before submitting.");
                    return;
                }
                wizardForm.submit();
            }
        });

        prevBtn.addEventListener("click", function () {
            currentStep = 1;
            updateWizardUI();
        });

        // Initialize state
        updateWizardUI();
    });
</script>
