@model Sym_Connect__Capstone2_.ViewModels.Election.ElectionDetailsViewModel

@{
    ViewData["Title"] = "Election Details";
    Layout = "_AdminLayout";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .election-details-page, .election-details-page * {
        font-family: 'Poppins', sans-serif;
    }

    .election-details-page {
        background: #f5f7fb;
    }

    /* ── Back link ── */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: #7b8397;
        text-decoration: none;
        margin-bottom: 18px;
        transition: color .15s;
    }

        .back-link:hover {
            color: #0d6efd;
        }

    /* ── Header card ── */
    .details-hero {
        background: #fff;
        border: 1px solid #eef0f5;
        border-radius: 18px;
        padding: 28px 30px;
        margin-bottom: 22px;
    }

    .details-title {
        font-size: 26px;
        font-weight: 800;
        color: #1a1f2b;
        margin: 0;
        line-height: 1.2;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .status-open {
        background: #E6F8EE;
        color: #15803D;
    }

    .status-incoming {
        background: #FEF3C7;
        color: #92400E;
    }

    .status-closed {
        background: #F1F2F6;
        color: #64748B;
    }

    .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 12px;
    }

    .meta-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13.5px;
        color: #7b8397;
        font-weight: 500;
    }

        .meta-item i {
            color: #a7b0c4;
        }

    /* ── Action buttons ── */
    .btn-pill-solid {
        background: #0d6efd;
        color: #fff;
        font-size: 13.5px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 999px;
        text-decoration: none;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: background .15s;
    }

        .btn-pill-solid:hover {
            background: #0b5ed7;
            color: #fff;
        }

    .btn-pill-ghost {
        border: 1px solid #e3e6ee;
        color: #4b5468;
        background: #fff;
        font-size: 13.5px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 999px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all .15s;
    }

        .btn-pill-ghost:hover {
            background: #f8f9fc;
            border-color: #d7dbe6;
            color: #1a1f2b;
        }

        .btn-pill-ghost.danger:hover {
            background: #FEF2F2;
            border-color: #FCA5A5;
            color: #B91C1C;
        }

    /* ── Stat cards ── */
    .stat-card {
        background: #fff;
        border: 1px solid #eef0f5;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

        .stat-icon.candidates {
            background: #EEF4FF;
            color: #3860D6;
        }

        .stat-icon.positions {
            background: #FDF2FA;
            color: #C2298A;
        }

        .stat-icon.votes {
            background: #ECFDF3;
            color: #15803D;
        }

    .stat-label {
        font-size: 12.5px;
        color: #7b8397;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 800;
        color: #1a1f2b;
        line-height: 1;
    }

    /* ── Party list cards ── */
    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #1a1f2b;
        margin-bottom: 14px;
    }

    .party-card {
        border-radius: 16px;
        border: 1px solid #eef0f5;
        background: #fff;
        padding: 22px;
        height: 100%;
        transition: box-shadow .15s, border-color .15s;
    }

        .party-card:hover {
            border-color: #dfe3ec;
            box-shadow: 0 4px 18px rgba(20, 30, 60, .05);
        }

    .party-avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #6f7dff, #4f46e5);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
        flex-shrink: 0;
    }

    .party-name {
        font-weight: 700;
        font-size: 15px;
        color: #1a1f2b;
    }

    .candidate-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 11px 0;
        border-top: 1px solid #f2f3f7;
        font-size: 13.5px;
    }

    .candidate-position {
        color: #7b8397;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11.5px;
        letter-spacing: .03em;
    }

    .candidate-name {
        font-weight: 600;
        color: #1a1f2b;
    }

    .empty-state {
        text-align: center;
        color: #9aa3b8;
        padding: 40px 0;
        font-size: 14px;
    }
</style>

<div class="election-details-page min-vh-100 py-4">
    <div class="container" style="max-width: 1080px;">

        <a asp-action="Index" asp-controller="Elections" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to elections
        </a>

        <div class="details-hero">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="details-title">@Model.ElectionName</h1>
                        <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-item"><i class="bi bi-calendar-event"></i> Start: @Model.StartDate.ToString("MMM d, yyyy")</span>
                        <span class="meta-item"><i class="bi bi-calendar-check"></i> End: @Model.EndDate.ToString("MMM d, yyyy")</span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Result" asp-controller="Elections" asp-route-electionId="@Model.id" class="btn-pill-solid">
                        <i class="bi bi-bar-chart-line"></i> Results
                    </a>
                    <a asp-action="Edit" asp-controller="Elections" asp-route-id="@Model.id" class="btn-pill-ghost">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a onclick="openModal('Archive Election', '@Url.Action("GetArchive", "Elections", new { id = Model.id })')"
                       class="btn-pill-ghost danger" style="cursor:pointer;">
                        <i class="bi bi-archive"></i> Archive
                    </a>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon candidates"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <div class="stat-label">Candidates</div>
                        <div class="stat-value">@Model.TotalCandidates</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon positions"><i class="bi bi-diagram-3-fill"></i></div>
                    <div>
                        <div class="stat-label">Positions</div>
                        <div class="stat-value">@Model.TotalPositions</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon votes"><i class="bi bi-bar-chart-fill"></i></div>
                    <div>
                        <div class="stat-label">Votes so far</div>
                        <div class="stat-value">@Model.TotalVotes</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-title">Party lists</div>

        @if (Model.partyLists != null && Model.partyLists.Any())
        {
            <div class="row g-3">
                @foreach (var party in Model.partyLists)
                {
                    <div class="col-md-6">
                        <div class="party-card">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <div class="party-avatar">
                                    @(string.IsNullOrWhiteSpace(party.PartyListName) ? "?" : party.PartyListName.Substring(0, 1).ToUpper())
                                </div>
                                <span class="party-name">@party.PartyListName</span>
                            </div>

                            @if (party.candidates != null && party.candidates.Any())
                            {
                                @foreach (var candidate in party.candidates)
                                {
                                    <div class="candidate-row">
                                        <span class="candidate-position">@candidate.PositionName</span>
                                        <span class="candidate-name">@candidate.FullName</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small pt-2">No candidates assigned yet.</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">No party lists assigned to this election.</div>
        }

    </div>
</div>
