@model Sym_Connect__Capstone2_.ViewModels.Member.RejectMembershipViewModel

<div class="modal-body text-center px-4 pb-2">
    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
         style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2;">
        <i class="bi bi-x-circle-fill" style="color: #dc2626; font-size: 26px;"></i>
    </div>

    <h5 class="fw-semibold mb-2">Reject Membership Application</h5>
    <p class="mb-3" style="font-size: 14px;">
        Are you sure you want to reject <strong>@Model.FullName</strong>?
    </p>

    <div class="text-start mb-1">
        <label for="rejectionReason" class="form-label" style="font-size: 14px;">
            Rejection Reason <span class="text-danger">*</span>
        </label>
        <textarea id="rejectionReason" class="form-control" rows="3"></textarea>
        <div id="rejectionReasonError" class="text-danger mt-1 d-none" style="font-size: 12.5px;">
            Please provide a rejection reason.
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mt-3 text-start">
        <i class="bi bi-info-circle-fill text-primary"></i>
        <small class="text-primary">The applicant will be notified of the rejection</small>
    </div>
</div>

<hr class="mt-3 mb-0" />

<div class="modal-footer border-0 justify-content-end">
    <form id="rejectModalForm">@Html.AntiForgeryToken()</form>
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
    <button type="button"
            id="confirmMembershipRejectBtn"
            class="btn btn-danger"
            data-id="@Model.MemberId"
            onclick="rejectApplicant(this)">
        Reject
    </button>
</div>