@model IEnumerable<MemberListViewModel>
@{
    ViewData["Title"] = "Groups";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="member-page">

    <div class="page-header">
        <div class="page-title-row">
            <h1 class="page-title">Member</h1>
        </div>

        <button type="button"
                class="btn-add open-modal"
                data-url="@Url.Action("Create", "YouthMembers")"
                data-title="Add Member">
            <span>+</span> Add Member
        </button>
    </div>

    <div class="filter-bar">
        <div class="filter-tabs">
            <button type="button" class="filter-tab active-tab" data-status="all">
                All (@Model.Count())
            </button>

            <button type="button" class="filter-tab" data-status="active">
                Active (@Model.Count(m => m.Status == "Active"))
            </button>

            <button type="button" class="filter-tab" data-status="inactive">
                Inactive (@Model.Count(m => m.Status == "Inactive"))
            </button>
        </div>

        <div class="spacer"></div>

        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" placeholder="Search members..." />
        </div>

        <button type="button" class="btn-filter">
            <i class="bi bi-funnel"></i> Filter
        </button>

        <button type="button" class="btn-date">
            <i class="bi bi-calendar3"></i> Date
        </button>
    </div>

    <div class="table-card">
        <table class="members-table" id="membersTable">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Member</th>
                    <th>Contact no.</th>
                    <th>Address</th>
                    <th>Birth Date</th>
                    <th>Gender</th>
                    <th>Status</th>
                    <th>Joined Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr class="empty-row">
                        <td colspan="9">No members found.</td>
                    </tr>
                }
                else
                {
                    
                        int rowNumber = 1;
                    
                    foreach (var item in Model)
                    {
                        <tr data-status="@item.Status.ToLower()">
                            <td>@rowNumber</td>
                            <td>
                                <div class="member-cell open-modal"
                                     data-url="@Url.Action("Profile", "YouthMembers", new { id = item.MemberId })"
                                     data-title="Member Profile">
                                    <img src="@item.PhotoUrl" alt="@item.FullName" class="member-avatar" />
                                    <div class="member-name-cell">
                                        <div class="member-fullname">@item.FullName</div>
                                        <div class="member-email">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.ContactNumber</td>
                            <td>@item.Address</td>
                            <td>@(item.BirthDate.HasValue ? @item.BirthDate.Value.ToString("MM/dd/yyyy") : "")</td>
                            <td>@item.Gender</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge-status badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactive">Inactive</span>
                                }
                            </td>
                            <td>@item.DateRegistered.ToString("MM/dd/yyyy")</td>
                            <td>
                                <div class="action-cell">

                                    <button type="button"
                                            class="btn-icon btn-view open-modal"
                                            data-url="@Url.Action("Profile", "YouthMembers", new { id = item.MemberId })"
                                            data-title="Member Profile">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </button>

                                    <button type="button"
                                            class="btn-icon btn-edit open-modal"
                                            data-url="@Url.Action("Edit", "YouthMembers", new { id = item.MemberId })"
                                            data-title="Edit Member">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button type="button"
                                            class="btn-icon btn-delete open-modal"
                                            data-url="@Url.Action("Delete", "YouthMembers", new { id = item.MemberId })"
                                            data-title="Delete Member">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        rowNumber++;
                    }
                }
            </tbody>
        </table>    
        <!-- Pagination bar -->
        <div style="display:flex; align-items:center; justify-content:space-between;
                    padding:12px 16px; border-top:1px solid var(--border-color);
                    font-size:13px; color:var(--text-muted);">

            <span id="pageInfo"></span>

            <div style="display:flex; align-items:center; gap:8px;">
                <button id="prevBtn" class="btn-filter">← Prev</button>
                <span id="pageNum" style="min-width:90px; text-align:center;"></span>
                <button id="nextBtn" class="btn-filter">Next →</button>
            </div>
    </div>
</div>
</div>


@await Html.PartialAsync("~/Views/Shared/_Modal.cshtml")

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
        <script src="~/js/admin/membersTable.js"></script>

}