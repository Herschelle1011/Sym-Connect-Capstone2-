@using Sym_Connect__Capstone2_.Models.Enums
@model Sym_Connect__Capstone2_.ViewModels.Member.MembersPageViewModel

@{
    ViewData["Title"] = "Members";
    Layout = "_AdminLayout";

    int pendingCount =
        Model.Applicants.Count(a =>
            a.Status == MembershipApplicationStatus.Pending);
}

<div class="member-page">

    <!-- =========================
         PAGE HEADER
    ========================== -->
    <div class="page-header">

        <div>
            <h1 class="page-title">Members</h1>

            <p class="page-subtitle">
                View and manage everyone in your organization.
            </p>
        </div>

        @* <button type="button"
                class="btn-export">
            <i class="bi bi-upload"></i>
            Export
        </button> *@

    </div>


    <!-- =========================
         MAIN TABS
         ALL MEMBERS / APPLICANTS
    ========================== -->
    <div class="top-tabs">

        <button type="button"
                class="top-tab"
                data-section="members-section">

            <i class="bi bi-people"></i>

            All Members

        </button>


        <button type="button"
                class="top-tab active-tab"
                data-section="applicants-section">

            <i class="bi bi-people"></i>

            Applicants

            @if (pendingCount > 0)
            {
                <span class="tab-count-badge">
                    @pendingCount
                </span>
            }

        </button>

    </div>


    <!-- =====================================================
         ALL MEMBERS SECTION
         Hidden when the page first opens
    ====================================================== -->
    <div id="members-section"
         class="tab-section"
         style="display:none;">


        <!-- =========================
             MEMBER FILTER BAR
        ========================== -->
        <div class="filter-bar">

            <div class="filter-tabs">

                <button type="button"
                        class="filter-tab active-tab"
                        data-status="all">

                    All

                    <span class="count-badge">
                        @Model.Members.Count
                    </span>

                </button>


                <button type="button"
                        class="filter-tab"
                        data-status="active">

                    Active

                    <span class="count-badge">
                        @Model.Members.Count(m =>
                            m.Status == "Active")
                    </span>

                </button>


                <button type="button"
                        class="filter-tab"
                        data-status="inactive">

                    Inactive

                    <span class="count-badge">
                        @Model.Members.Count(m =>
                            m.Status == "Inactive")
                    </span>

                </button>

            </div>


            <div class="spacer"></div>


            <!-- Search -->
            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       class="search-input"
                       data-target="membersTable"
                       placeholder="Search..." />

            </div>


            <!-- Date -->
            @* <button type="button"
                    class="btn-filter">

                <i class="bi bi-calendar3"></i>
                Modified dates

            </button> *@


            <!-- Sort -->
            @* <button type="button"
                    class="btn-filter">

                <i class="bi bi-funnel"></i>
                Sort

            </button> *@

        </div>


        <!-- =========================
             MEMBERS TABLE
        ========================== -->
        <div class="table-card">

            <table class="members-table"
                   id="membersTable">

                <thead>
                    <tr>

                        <th>Id</th>

                        <th>FirstName</th>

                        <th>MiddleName</th>

                        <th>LastName</th>

                        <th>Group</th>

                        <th>Role</th>

                        <th>Email</th>

                        <th>Status</th>

                        <th class="text-center">Action</th>

                    </tr>
                </thead>


                <tbody>

                    @if (!Model.Members.Any())
                    {
                        <tr class="empty-row">

                            <td colspan="9">
                                No members found.
                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Members)
                        {
                            <tr class="open-modal"
                                data-status="@item.Status.ToLower()"
                                data-url="@Url.Action(
                                                "Profile",
                                                "YouthMembers",
                                                new { area = "Admin", id = item.MemberId })"
                                data-title="Member Profile" data-modal-size="lg">

                                <td>@item.MemberId.ToString("D4")</td>
                                <td>@item.FirstName</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.MiddleName)
                                        ? "-"
                                        : item.MiddleName)
                                </td>
                                <td>@item.LastName</td>
                                <td>
                                    @(item.GroupDetailsVM.FirstOrDefault()?.GroupName ?? "N/A")
                                </td>
                                <td>@item.Role</td>
                                <td>@item.Email</td>
                                <td>
                                    <span class="badge-status @(item.Status == "Active" ? "badge-active" : "badge-inactive")">
                                        @item.Status
                                    </span>
                                </td>

                                <td class="member-actions-cell">

                                    @if (item.Status == "Active")
                                    {
                                        <button type="button"
                                                class="member-action-btn archive-member-btn"
                                                data-url="@Url.Action(
                                                                    "ArchiveModal",
                                                                    "YouthMembers",
                                                                    new
                                                                    {
                                                                        area = "Admin",
                                                                        id = item.MemberId
                                                                    })"
                                                data-title="Archive Member"
                                                data-modal-size="sm"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Archive member">

                                            <i class="bi bi-archive"></i>

                                        </button>
                                    }

                                </td>


                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =====================================================
         APPLICANTS SECTION
         Visible when page first opens
    ====================================================== -->
    <div id="applicants-section"
         class="tab-section">


        <!-- =========================
             APPLICANT FILTER BAR
        ========================== -->
        <div class="filter-bar">

            <div class="filter-tabs">

                <button type="button"
                        class="filter-tab active-tab"
                        data-status="all">
                    All
                </button>


                <button type="button"
                        class="filter-tab dot-pending"
                        data-status="pending">
                    Pending
                </button>


                <button type="button"
                        class="filter-tab dot-approved"
                        data-status="approved">
                    Approved
                </button>


                <button type="button"
                        class="filter-tab dot-rejected"
                        data-status="rejected">
                    Rejected
                </button>

            </div>


            <div class="spacer"></div>


            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       class="search-input"
                       data-target="applicantsTable"
                       placeholder="Search..." />

            </div>


          @*   <button type="button"
                    class="btn-filter">

                <i class="bi bi-calendar3"></i>
                Modified dates

            </button> *@


            @* <button type="button"
                    class="btn-filter">

                <i class="bi bi-funnel"></i>
                Sort

            </button> *@

        </div>


        <!-- =========================
             APPLICANTS TABLE
        ========================== -->
        <div class="table-card">

            <table class="members-table"
                   id="applicantsTable">

                <thead>

                    <tr>

                        <th>Id</th>

                        <th>FirstName</th>

                        <th>MiddleName</th>

                        <th>LastName</th>

                        <th>Preferred Group</th>

                        <th>Email</th>

                        <th>Date Applied</th>

                        <th>Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (!Model.Applicants.Any())
                    {
                        <tr class="empty-row">

                            <td colspan="8">
                                No applicants found.
                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Applicants)
                        {
                            var applicantStatus =
                                item.Status
                                    .ToString()
                                    .ToLower();

                            <tr class="applicant-row open-modal"
                                data-status="@applicantStatus"
                                data-url="@Url.Action( "GetApplicationInformation","YouthMembers",
                                                                    new
                                                                    {
                                                                        area = "Admin",
                                                                        id = item.MemberId
                                                                    })"
                                data-title="Applicant Information" 
                                data-modal-size="lg">


                                <td>
                                    @item.MemberId.ToString("D4")
                                </td>


                                <td>
                                    @item.FirstName
                                </td>


                                <td>
                                    @(string.IsNullOrWhiteSpace(item.MiddleName)
                                        ? "-"
                                        : item.MiddleName)
                                </td>


                                <td>
                                    @item.LastName
                                </td>


                                <td>
                                    @(string.IsNullOrWhiteSpace(item.GroupName)
                                        ? "N/A"
                                        : item.GroupName)
                                </td>


                                <td>
                                    @item.Email
                                </td>


                                <td>
                                    @(item.DateApplied?.ToString("MM/dd/yyyy")
                                        ?? "N/A")
                                </td>


                                <td>

                                    <span class="badge-status badge-@applicantStatus">

                                        @item.Status

                                    </span>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================
     REUSABLE MODAL
========================== -->
@await Html.PartialAsync(
    "~/Views/Shared/_Modal.cshtml"
)


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

    <script src="~/js/admin/membersTable.js"></script>

    <script>
        const tooltipTriggerList =
        document.querySelectorAll('[data-bs-toggle="tooltip"]');

        tooltipTriggerList.forEach(function (element) {
        new bootstrap.Tooltip(element);
        });


        document.addEventListener("DOMContentLoaded", function () {

            /* =========================================
            TOP LEVEL TABS
            ALL MEMBERS / APPLICANTS
            ========================================== */

            const topTabs = document.querySelectorAll(".top-tab");
            const sections = document.querySelectorAll(".tab-section");

            topTabs.forEach(function (tab) {
                tab.addEventListener("click", function () {
                    const targetSection = this.dataset.section;

                    topTabs.forEach(function (button) {
                        button.classList.remove("active-tab");
                    });

                    this.classList.add("active-tab");

                    sections.forEach(function (section) {
                        section.style.display = (section.id === targetSection) ? "block" : "none";
                    });
                });
            });

            /* =========================================
            STATUS FILTERS
            Works separately for each section
            ========================================== */

            document.querySelectorAll(".tab-section").forEach(function (section) {
                const filterTabs = section.querySelectorAll(".filter-tab");

                filterTabs.forEach(function (button) {
                    button.addEventListener("click", function () {
                        filterTabs.forEach(function (item) {
                            item.classList.remove("active-tab");
                        });

                        this.classList.add("active-tab");

                        const status = this.dataset.status;
                        const rows = section.querySelectorAll("tbody tr[data-status]");

                        rows.forEach(function (row) {
                            const rowStatus = row.dataset.status.toLowerCase();
                            row.style.display = (status === "all" || rowStatus === status) ? "" : "none";
                        });
                    });
                });
            });

            /* =========================================
            SEARCH
            ========================================== */

            document.querySelectorAll(".search-input").forEach(function (input) {
                input.addEventListener("input", function () {
                    const table = document.getElementById(this.dataset.target);
                    if (!table) { return; }

                    const query = this.value.trim().toLowerCase();
                    const rows = table.querySelectorAll("tbody tr[data-status]");

                    rows.forEach(function (row) {
                        const rowText = row.textContent.toLowerCase();
                        row.style.display = rowText.includes(query) ? "" : "none";
                    });
                });
            });

            /* =========================================
            OPEN APPLICANT MODAL ON PAGE LOAD
            (e.g. after redirect from an email link)
            ========================================== */

            (async function () {
                const openApplicantId = '@ViewBag.OpenApplicantId';

                if (!openApplicantId) { return; }

                const applicantUrl =
                    '@Url.Action("GetApplicationInformation", "YouthMembers")' + '?id=' + openApplicantId;

                try {
                    const response = await fetch(applicantUrl);

                    if (!response.ok) {
                        throw new Error("Unable to load applicant.");
                    }

                    const html = await response.text();

                    const modalElement = document.getElementById("appModal");
                    const modalTitle = modalElement.querySelector(".modal-title");
                    const modalBody = modalElement.querySelector(".modal-body");

                    if (!modalElement || !modalTitle || !modalBody) {
                        console.error("Reusable modal was not found.");
                        return;
                    }

                    modalTitle.textContent = "Applicant Information";
                    modalBody.innerHTML = html;

                    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.show();
                }
                catch (error) {
                    console.error("Unable to open applicant:", error);
                }
            })();



        document.querySelectorAll(".archive-member-btn").forEach(function (button) {

        button.addEventListener("click", async function (event) {

        // Prevent the member profile row from opening
        event.stopPropagation();

        const url = this.dataset.url;
        const title = this.dataset.title;

        try {

        const response = await fetch(url);

        if (!response.ok) {
        throw new Error("Unable to load archive modal.");
        }

        const html = await response.text();

        const modalElement = document.getElementById("appModal");
        const modalTitle = modalElement.querySelector(".modal-title");
        const modalBody = modalElement.querySelector(".modal-body");

        modalTitle.textContent = title;
        modalBody.innerHTML = html;

        const modal =
        bootstrap.Modal.getOrCreateInstance(modalElement);

        modal.show();

        }
        catch (error) {
        console.error("Unable to open archive modal:", error);
        }
        });

        });
        });

    </script>
}
}