@model MembersCreateViewModel

<link rel="stylesheet" href="~/css/admin/MembersFormModal.css" asp-append-version="true" />


<form id="createMemberForm" asp-action="Create" asp-controller="YouthMembers" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    @* ---------UPLOAD PHOTO *@
    <div class="photo-upload-block">
        <div id="photoPreviewWrapper" class="photo-preview-wrapper">
            <img id="photoPreview" src="" style="display:none;" />
            <i class="bi bi-person-fill" id="placeholderIcon"></i>
        </div>

        <div class="photo-mode-toggle" role="group">
            <input type="radio" class="btn-check" name="photoMode" id="modeUpload" checked onchange="togglePhotoMode('upload')">
            <label for="modeUpload">Upload Photo</label>

            <input type="radio" class="btn-check" name="photoMode" id="modeUrl" onchange="togglePhotoMode('url')">
            <label for="modeUrl">Paste Link</label>
        </div>

        <div id="uploadInputWrapper">
            <input type="file" name="Photo" id="photoInput" accept="image/*" class="form-control form-control-sm" onchange="previewProfilePhoto(this)" />
        </div>

        <div id="urlInputWrapper" style="display:none;">
            <input type="url" asp-for="PhotoUrl" id="photoUrlInput" class="form-control form-control-sm" placeholder="https://example.com/photo.jpg" oninput="previewFromUrl(this.value)" />
            <span asp-validation-for="PhotoUrl" class="text-danger small"></span>
        </div>
    </div>

    @* ---------PERSONAL INFO *@
    <div class="member-form-section">
        <div class="member-form-section-title">Personal Info</div>

        <div class="row mb-3">
            <div class="col-6">
                <div class="form-floating">
                    <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                    <label asp-for="FirstName">First Name</label>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="form-floating">
                    <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                    <label asp-for="LastName">Last Name</label>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-floating">
                <input asp-for="MiddleName" class="form-control" placeholder="Middle Name" />
                <label asp-for="MiddleName">Middle Name</label>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-6">
                <div class="form-floating">
                    <input asp-for="BirthDate"
                           type="date"
                           class="form-control"
                           value="@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
                    <label asp-for="BirthDate">Birth Date</label>
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="form-floating">
                    <select asp-for="Gender" class="form-select">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <label asp-for="Gender">Gender</label>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    @* ---------CONTACT INFO *@
    <div class="member-form-section">
        <div class="member-form-section-title">Contact Info</div>

        <div class="mb-3">
            <div class="form-floating">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-floating">
                <input asp-for="ContactNumber" class="form-control" placeholder="Contact Number" />
                <label asp-for="ContactNumber">Contact Number</label>
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>
        </div>
    </div>

    @* ---------ADDRESS *@
    <div class="member-form-section">
        <div class="member-form-section-title">Address</div>

        <div class="mb-3">
            <label class="form-label small text-muted mb-1">Country</label>
            <div class="member-form-readonly">Philippines</div>
            <input type="hidden" asp-for="Country" value="Philippines" />
        </div>

        <div class="row mb-3">
            <div class="col-6">
                <label class="form-label small text-muted mb-1">
                    Province
                </label>

                <select id="provinceSelect" class="form-select">
                    <option value="">-- Select Province --</option>
                </select>

                <input type="hidden"
                       asp-for="Province"
                       id="provinceName" />

                <span asp-validation-for="Province"
                      class="text-danger small"></span>
            </div>

            <div class="col-6">
                <label class="form-label small text-muted mb-1">
                    City / Municipality
                </label>

                <select id="citySelect"
                        class="form-select"
                        disabled>
                    <option value="">-- Select Province First --</option>
                </select>

                <input type="hidden"
                       asp-for="City"
                       id="cityName" />

                <span asp-validation-for="City"
                      class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small text-muted mb-1">
                Barangay
            </label>

            <select asp-for="Barangay"
                    id="barangaySelect"
                    class="form-select"
                    disabled>
                <option value="">-- Select City First --</option>
            </select>

            <span asp-validation-for="Barangay"
                  class="text-danger small"></span>
        </div>
    </div>

    @* ---------STATUS *@
    <div class="member-form-section" style="margin-bottom: 12px;">
        <div class="member-form-section-title">Membership</div>

        <div class="form-floating">
            <select asp-for="Status" class="form-select">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
            <label asp-for="Status">Status</label>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3 pt-3" style="border-top: 1px solid #eef0f5;">
        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" id="submitBtn" class="btn btn-primary px-4">Create</button>
    </div>
</form>


<script>
    function previewProfilePhoto(input) {
        const preview = document.getElementById('photoPreview');
        const placeholder = document.getElementById('placeholderIcon');

        if (input.files && input.files[0]) {
            const blobUrl = URL.createObjectURL(input.files[0]);
            preview.src = blobUrl;
            preview.style.display = 'block';
            placeholder.style.display = 'none';

            preview.onload = function () {
                URL.revokeObjectURL(blobUrl);
            };
        } else {
            preview.src = "";
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        }
    }
</script>