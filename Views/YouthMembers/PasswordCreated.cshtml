@{
    ViewData["Title"] = "Account Ready";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYM-Connect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f1f5f9;
                min-height: 100vh;
            }

            .ready-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .ready-card {
                width: 100%;
                max-width: 420px;
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 4px 24px rgba(17, 24, 39, 0.06);
                padding: 44px 36px;
                text-align: center;
            }

            .ready-icon {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                background: #d1e7dd;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 24px;
                animation: pop-in 0.4s ease;
            }

                .ready-icon i {
                    color: #0f5132;
                    font-size: 34px;
                }

            @@keyframes pop-in {
                0% {
                    transform: scale(0.6);
                    opacity: 0;
                }

                100% {
                    transform: scale(1);
                    opacity: 1;
                }
            }

            .ready-title {
                font-weight: 700;
                font-size: 22px;
                color: #111827;
                margin-bottom: 8px;
            }

            .ready-subtitle {
                font-size: 14px;
                color: #6b7280;
                line-height: 1.6;
                margin-bottom: 28px;
            }

            .ready-checklist {
                text-align: left;
                background: #f9fafb;
                border-radius: 10px;
                padding: 16px 18px;
                margin-bottom: 28px;
            }

            .ready-checklist-item {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 13px;
                color: #374151;
                padding: 4px 0;
            }

                .ready-checklist-item i {
                    color: #4a6cf7;
                    font-size: 15px;
                }

            .btn-ready {
                background-color: #4a6cf7;
                border: none;
                border-radius: 10px;
                padding: 12px;
                font-weight: 600;
                font-size: 15px;
                width: 100%;
                transition: background-color 0.15s ease;
            }

                .btn-ready:hover {
                    background-color: #3a58d9;
                    color: #ffffff;
                }

            .ready-footer {
                text-align: center;
                font-size: 12px;
                color: #c1c7d0;
                margin-top: 24px;
            }
    </style>
</head>
<body>

    <div class="ready-wrapper">
        <div class="ready-card">

            <div class="ready-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <div class="ready-title">You're all set!</div>
            <div class="ready-subtitle">
                Your password has been created and your SYM-Connect account is ready to go.
            </div>

            <div class="ready-checklist">
                <div class="ready-checklist-item">
                    <i class="bi bi-check-circle-fill"></i> Email verified
                </div>
                <div class="ready-checklist-item">
                    <i class="bi bi-check-circle-fill"></i> Password created
                </div>
                <div class="ready-checklist-item">
                    <i class="bi bi-check-circle-fill"></i> Account activated
                </div>
            </div>

            <a asp-controller="Account" asp-action="Login" asp-area="Identity" class="btn btn-primary btn-ready">
                Sign In to Your Account
            </a>

        </div>
    </div>

    <div class="ready-footer">
        &copy; @DateTime.Now.Year SYM-Connect. All rights reserved.
    </div>

</body>
</html>