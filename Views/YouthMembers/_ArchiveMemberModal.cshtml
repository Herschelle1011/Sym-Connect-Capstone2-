@model Sym_Connect__Capstone2_.ViewModels.Member.ArchiveMemberViewModel

<div style="padding: 0 0.5rem 0.5rem;">

    <!-- Archive Icon -->
    <div style="display:flex; justify-content:center; margin-bottom:1.25rem;">
        <div style="
            width:56px;
            height:56px;
            border-radius:50%;
            background:rgba(234,179,8,.12);
            border:1px solid rgba(234,179,8,.3);
            display:flex;
            align-items:center;
            justify-content:center;">

            <i class="bi bi-archive"
               style="font-size:1.4rem; color:#b45309;">
            </i>

        </div>
    </div>


    <!-- Title -->
    <h5 style="
        text-align:center;
        font-size:15px;
        font-weight:700;
        color:#111827;
        margin:0 0 6px;">

        Archive this member?

    </h5>


    <!-- Description / Warning -->
    <p style="
        text-align:center;
        font-size:13px;
        color:#6b7280;
        line-height:1.6;
        margin:0 0 1.25rem;">

        This member will be marked as inactive, removed from their current group,
        and moved to the archive. Their
        <strong style="color:#b45309;">earned points will be reset to 0</strong>
        and this action
        <strong style="color:#b91c1c;">cannot be undone.</strong>

    </p>


    <!-- Member Information -->
    <div style="
        background:#f9fafb;
        border:1px solid #e5e7eb;
        border-radius:10px;
        padding:14px 16px;
        margin-bottom:1.5rem;">

        <div style="
            display:flex;
            flex-direction:column;
            gap:8px;">


            <!-- Member -->
            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                gap:15px;">

                <span style="
                    font-size:11px;
                    font-weight:600;
                    text-transform:uppercase;
                    letter-spacing:.05em;
                    color:#9ca3af;">

                    <i class="bi bi-person"
                       style="margin-right:4px;">
                    </i>

                    Member

                </span>

                <span style="
                    font-size:13px;
                    font-weight:600;
                    color:#111827;
                    text-align:right;">

                    @Model.FirstName

                    @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                    {
                        @($" {Model.MiddleName}")
                    }

                    @($" {Model.LastName}")

                </span>

            </div>


            <div style="height:1px; background:#f0f0f0;"></div>


            <!-- Group -->
            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                gap:15px;">

                <span style="
                    font-size:11px;
                    font-weight:600;
                    text-transform:uppercase;
                    letter-spacing:.05em;
                    color:#9ca3af;">

                    <i class="bi bi-people"
                       style="margin-right:4px;">
                    </i>

                    Group

                </span>

                <span style="
                    font-size:13px;
                    font-weight:600;
                    color:#111827;
                    text-align:right;">

                    @(string.IsNullOrWhiteSpace(Model.GroupName)
                        ? "No Group"
                        : Model.GroupName)

                </span>

            </div>


            <div style="height:1px; background:#f0f0f0;"></div>


            <!-- Earned Points -->
            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                gap:15px;">

                <span style="
                    font-size:11px;
                    font-weight:600;
                    text-transform:uppercase;
                    letter-spacing:.05em;
                    color:#9ca3af;">

                    <i class="bi bi-star"
                       style="margin-right:4px;">
                    </i>

                    Earned Points

                </span>

                <span style="
                    font-size:13px;
                    font-weight:600;
                    color:#111827;">

                    @Model.EarnedPoints

                </span>

            </div>

        </div>

    </div>


    <!-- Archive Form -->
    <form id="archiveMemberForm"
          class="modal-ajax-form"
          action="@Url.Action("ArchiveMember", "YouthMembers", new { area = "Admin" })"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="memberId"
               value="@Model.MemberId" />


        <div style="display:flex; gap:10px;">

            <!-- Cancel -->
            <button type="button"
                    class="btn w-50"
                    data-bs-dismiss="modal"
                    style="
                font-size:13px;
                font-weight:500;
                border:1px solid #e5e7eb;
                border-radius:8px;
                padding:9px;
                background:#fff;
                color:#374151;">

                Cancel

            </button>


            <!-- Archive -->
            <button type="submit"
                    class="btn w-50"
                    style="
                font-size:13px;
                font-weight:600;
                border-radius:8px;
                padding:9px;
                background:#b45309;
                color:#fff;
                border:none;
                transition:background .15s;">

                <i class="bi bi-archive"
                   style="margin-right:5px;">
                </i>

                Archive

            </button>

        </div>

    </form>

</div>