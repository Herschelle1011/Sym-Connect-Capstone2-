@model Sym_Connect__Capstone2_.ViewModels.Account.SetPasswordViewModel

@{
    ViewData["Title"] = "Set Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYM-Connect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f1f5f9;
                min-height: 100vh;
            }

            .setpw-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .setpw-card {
                width: 100%;
                max-width: 420px;
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 4px 24px rgba(17, 24, 39, 0.06);
                padding: 40px 36px;
            }

            .setpw-icon {
                width: 56px;
                height: 56px;
                border-radius: 14px;
                background: linear-gradient(135deg, #4a6cf7, #6d8bff);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 20px;
            }

                .setpw-icon i {
                    color: #ffffff;
                    font-size: 24px;
                }

            .setpw-title {
                font-weight: 700;
                font-size: 24px;
                color: #111827;
                margin-bottom: 6px;
            }

            .setpw-subtitle {
                font-size: 14px;
                color: #6b7280;
                line-height: 1.6;
                margin-bottom: 28px;
            }

                .setpw-subtitle .verified-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    color: #0f5132;
                    background: #d1e7dd;
                    font-size: 12px;
                    font-weight: 600;
                    padding: 2px 10px;
                    border-radius: 20px;
                    margin-bottom: 10px;
                }

            .form-label {
                font-size: 13px;
                font-weight: 600;
                color: #374151;
                margin-bottom: 6px;
            }

            .input-group-setpw {
                position: relative;
            }

                .input-group-setpw .form-control {
                    padding: 11px 42px 11px 14px;
                    border-radius: 10px;
                    border: 1px solid #e5e7eb;
                    font-size: 14px;
                }

                    .input-group-setpw .form-control:focus {
                        border-color: #4a6cf7;
                        box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.12);
                    }

            .toggle-password {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: #9ca3af;
                cursor: pointer;
                padding: 0;
                font-size: 16px;
            }

                .toggle-password:hover {
                    color: #4a6cf7;
                }

            .password-hint {
                font-size: 12px;
                color: #9ca3af;
                margin-top: 6px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .btn-setpw {
                background-color: #4a6cf7;
                border: none;
                border-radius: 10px;
                padding: 12px;
                font-weight: 600;
                font-size: 15px;
                width: 100%;
                margin-top: 8px;
                transition: background-color 0.15s ease;
            }

                .btn-setpw:hover {
                    background-color: #3a58d9;
                }

            .text-danger {
                font-size: 12px;
            }

            .setpw-footer {
                text-align: center;
                font-size: 12px;
                color: #c1c7d0;
                margin-top: 24px;
            }
    </style>
</head>
<body>

    <div class="setpw-wrapper">
        <div class="setpw-card">

            <div class="setpw-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <div class="setpw-title">Set your password</div>
            <div class="setpw-subtitle">
                <div class="verified-badge">
                    <i class="bi bi-check-circle-fill"></i> Email verified
                </div>
                <br />
                Create a password to finish setting up your SYM-Connect account.
            </div>

           <form asp-action="SetPassword"
              asp-controller="YouthMembers"
              method="post" novalidate>

                @Html.AntiForgeryToken()

                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group-setpw">
                        <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Enter a password" />
                        <button type="button" class="toggle-password" data-target="passwordInput">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="password-hint">
                        <i class="bi bi-info-circle"></i> At least 8 characters
                    </div>
                    <span asp-validation-for="Password" class="text-danger d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                    <div class="input-group-setpw">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPasswordInput" placeholder="Re-enter your password" />
                        <button type="button" class="toggle-password" data-target="confirmPasswordInput">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-setpw">
                    Set Password &amp; Continue
                </button>

            </form>

        </div>
    </div>

    <div class="setpw-footer">
        &copy; @DateTime.Now.Year SYM-Connect. All rights reserved.
    </div>

    <script>
            // Show/hide password toggle — delegated, no external JS file needed for this standalone page
            document.querySelectorAll('.toggle-password').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const targetInput = document.getElementById(btn.dataset.target);
                    const icon = btn.querySelector('i');
                    const isHidden = targetInput.type === 'password';

                    targetInput.type = isHidden ? 'text' : 'password';
                    icon.classList.toggle('bi-eye');
                    icon.classList.toggle('bi-eye-slash');
                });
            });
    </script>

</body>
</html>