@model Sym_Connect__Capstone2_.ViewModels.Member.ApproveMembershipViewModel

<div class="modal-body px-4 pb-2">
    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center justify-content-center"
             style="width: 32px; height: 32px; border-radius: 50%; background: #dcfce7;">
            <i class="bi bi-check-circle-fill" style="color: #16a34a; font-size: 18px;"></i>
        </div>
        <h5 class="mb-0 fw-semibold">Approve Membership?</h5>
    </div>

    <p class="mb-3" style="font-size: 14px;">
        Are you sure you want to approve <strong>@Model.FullName</strong> to be part of the
        <strong>@Model.GroupName</strong> in SYM?
    </p>

    <p class="mb-2" style="font-size: 14px;">Upon Approval, the system will:</p>
    <ul style="font-size: 14px;" class="mb-3">
        <li>Assign the members account</li>
        <li>Assign the member role</li>
        <li>Assign the member to its desired group</li>
        <li>Generate a unique QR code</li>
        <li>Notify the applicant</li>
    </ul>

    <div class="d-flex align-items-start gap-2 p-2 mb-1" style="background: #eff6ff; border-radius: 8px;">
        <i class="bi bi-info-circle-fill text-primary mt-1"></i>
        <small class="text-primary">
            This action will change the application status from Pending to Approved.
        </small>
    </div>
</div>

<hr class="mt-3 mb-0" />

<div class="modal-footer border-0 justify-content-end">

    <form id="approveModalForm">
        @Html.AntiForgeryToken()
    </form>

    <button type="button"
            id="cancelApproveBtn"
            class="btn btn-light"
            data-bs-dismiss="modal">
        Cancel
    </button>

    <button type="button"
            class="btn btn-success"
            data-id="@Model.MemberId"
            onclick="approveApplicant(this)">
        Approve
    </button>

</div>