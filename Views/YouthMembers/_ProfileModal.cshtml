@model MemberDetailsViewModel

<div class="profile-modal">
    <div class="profile-header">
        <img src="@Model.PhotoUrl" alt="@Model.FullName" class="profile-avatar" />
        <div class="profile-header-text">
            <h2 class="profile-name">@Model.FullName</h2>
         <p class="profile-subtext">
                Member since @(Model.MemberSince.ToString("MMMM dd, yyyy") ?? "—")
            </p>
        </div>
        <span class="profile-status-badge @(Model.Status == "Active" ? "status-active" : "status-inactive")">
            @Model.Status
        </span>
    </div>

    <div class="profile-body">
        <div class="profile-columns">
            <div class="profile-col">
                <h3 class="profile-section-title">Personal Info</h3>
                <div class="profile-field">
                    <span class="field-label">Fullname</span>
                    <span class="field-value">@Model.FullName</span>
                </div>
                <div class="profile-field">
                    <span class="field-label">Birthdate</span>
                    <span class="field-value">@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("MMMM d, yyyy") : "—")</span>
                </div>
                <div class="profile-field">
                    <span class="field-label">Gender</span>
                    <span class="field-value">@Model.Gender</span>
                </div>
            </div>

            <div class="profile-col">
                <h3 class="profile-section-title">Contact Info</h3>
                <div class="profile-field">
                    <span class="field-label">Email</span>
                    <span class="field-value">@Model.Email</span>
                </div>
                <div class="profile-field">
                    <span class="field-label">Contact</span>
                    <span class="field-value">@Model.ContactNumber</span>
                </div>
                <div class="profile-field">
                    <span class="field-label">Address</span>
                    <span class="field-value">@Model.Address</span>
                </div>
            </div>
        </div>

        <div class="profile-columns profile-membership">
            <div class="profile-col">
                <h3 class="profile-section-title">Membership</h3>
                <div class="profile-field">
                    <span class="field-label">Group</span>
                    <span class="field-value-lg">@(Model.groupDetails.Any() ? string.Join(", ", Model.groupDetails.Select(g => g.GroupName)) : "No group")</span>
                </div>
                <div class="profile-field">
                    <span class="field-label">Event Attended</span>
                    <span class="field-value-lg">@Model.EventAttendedCount</span>
                </div>
            </div>

            <div class="profile-col">
                <div class="profile-field" style="margin-top: 28px;">
                    <span class="field-label">Role</span>
                    <span class="field-value-lg">Member</span>
                </div>
                <div class="profile-field">
                    <span class="field-label">Date</span>
                    <span class="field-value-lg">@(Model.DateJoinedGroup?.ToString("MMMM d, yyyy") ?? "—")</span>
                </div>
            </div>
        </div>
    </div>
</div>