@model MemberViewModel.MemberDeleteViewModel

<form asp-action="Delete"
      asp-controller="YouthMembers"
      asp-route-id="@Model.memberId"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.memberId" />

    <p class="mb-3">
        Are you sure you want to delete this member?
    </p>

    <div class="border rounded p-3 mb-3 bg-light">
        <p class="mb-1">
            <strong>Name:</strong> @Model.FullName
        </p>

        <p class="mb-1">
            <strong>Email:</strong> @Model.Email
        </p>

        <p class="mb-0">
            <strong>Group:</strong> @(string.IsNullOrEmpty(Model.groupName) ? "No group assigned" : Model.groupName)
        </p>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-danger px-4">
            Delete
        </button>
    </div>
</form>