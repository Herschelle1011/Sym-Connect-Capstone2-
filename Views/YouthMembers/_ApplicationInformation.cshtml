@model Sym_Connect__Capstone2_.ViewModels.Member.MembershipApplicantDetailsViewModel

<div class="modal-content applicant-info-modal">
    <div class="modal-header border-0">
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">

        <!-- Applicant Information -->
        <div class="card mb-3">
            <div class="card-header bg-light-blue">
                <i class="bi bi-person-circle"></i> Applicant Information
            </div>
            <div class="card-body d-flex justify-content-between align-items-start">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(Model.ProfilePictureUrl ?? "/images/default-avatar.png")"
                         class="rounded-circle" width="60" height="60" />
                    <div>
                        <h5 class="mb-1">@Model.FirstName @Model.MiddleName @Model.LastName</h5>
                        <span class="badge bg-warning text-dark">Pending</span>
                        @* TODO: DateApplied not returned by GetApplicantInformationByIdAsync yet —
                           add DateApplied to the ViewModel/service, then swap the line below in *@
                        @if (Model.DateApplied.HasValue)
                        {
                            <small class="text-muted d-block mt-1">
                                Applied on @Model.DateApplied.Value.ToString("MMMM d, yyyy - h:mm tt")
                            </small>
                        }
                    </div>
                </div>
                <div class="text-end d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-primary fs-4"></i>
                    <div class="text-start">
                        <small class="text-muted d-block">Group Preference</small>
                        <strong>@Model.GroupName</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact / Personal Details -->
        <div class="card mb-3">
            <div class="card-body row">
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-envelope text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Email Address</small>
                        <strong>@Model.Email</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-telephone text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Contact Number</small>
                        <strong>@Model.ContactNumber</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-calendar-event text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Date of Birth</small>
                        <strong>@(Model.DateOfBirth.HasValue ? (DateTime.Today.Year - Model.DateOfBirth.Value.Year).ToString() : "N/A")</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-gender-ambiguous text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Gender</small>
                        <strong>@Model.Gender</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-geo-alt text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Address</small>
                        <strong>@Model.Address</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-person-badge text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Age</small>
                        <strong>@(Model.DateOfBirth.HasValue ? (DateTime.Today.Year - Model.DateOfBirth.Value.Year).ToString() : "N/A")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Information -->
        <div class="card mb-3">
            <div class="card-header bg-light-blue">
                <i class="bi bi-lock"></i> Account Information
            </div>
            <div class="card-body row">
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-person text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Username</small>
                        <strong>@Model.Username</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-start gap-2">
                    <i class="bi bi-shield-lock text-primary"></i>
                    <div>
                        <small class="text-muted d-block">Password</small>
                        <strong>&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Membership Application Details -->
        <div class="card mb-3">
            <div class="card-header bg-light-blue">
                <i class="bi bi-file-earmark-text"></i> Membership Application Details
            </div>
            <div class="card-body d-flex justify-content-between">
                <div>
                    @if (Model.AcceptedGuidelines)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Membership Guidelines</span>
                    }
                </div>
                <div>
                    @if (Model.AcceptedPrivacy)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Data Privacy & Consent</span>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary open-modal"
                data-url="@Url.Action("RejectApplicant", "YouthMembers", new { id = Model.MemberId })"
                data-title="Reject Applicant">
            Reject
        </button>
        <button type="button" class="btn btn-primary approve-applicant-btn"
                data-id="@Model.MemberId">
            Approve
        </button>
    </div>
</div>