@model Sym_Connect__Capstone2_.ViewModels.Member.MembershipApplicantDetailsViewModel

@if (Model == null)
{
    <div class="alert alert-danger">
        Unable to load applicant information.
    </div>

    return;
}

@{
    int? age = null;

    if (Model.DateOfBirth.HasValue)
    {
        var birthDate = Model.DateOfBirth.Value;
        var today = DateTime.Today;

        age = today.Year - birthDate.Year;

        if (birthDate.Date > today.AddYears(-age.Value))
        {
            age--;
        }
    }

    var fullName =
        $"{Model.FirstName} {Model.MiddleName} {Model.LastName}".Trim();
}

<div class="applicant-details-wrapper">

    <!-- =====================================================
         APPLICANT INFORMATION
    ====================================================== -->
    <div class="applicant-details-section">

        <div class="applicant-section-title">
            <i class="bi bi-person-fill"></i>
            <span>Applicant Information</span>
        </div>

        <!-- TOP ROW -->
        <div class="applicant-summary-row">

            <!-- Applicant -->
            <div class="applicant-summary-left">

                <img src="@(string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)
                                                 ? "/images/default-avatar.png"
                                                 : Model.ProfilePictureUrl)"
                     alt="@fullName"
                     class="applicant-profile-image" />

                <div class="applicant-summary-text">

                    <div class="applicant-full-name">
                        @fullName
                    </div>

                    <span class="applicant-status">
                        Pending
                    </span>

                    @if (Model.DateApplied.HasValue)
                    {
                        <div class="applicant-applied-date">
                            Applied on @Model.DateApplied.Value.ToString("MMMM d, yyyy - h:mm tt")
                        </div>
                    }

                </div>
            </div>


            <!-- Group Preference -->
            <div class="applicant-group-box">

                <div class="applicant-group-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <div class="applicant-group-label">
                        Group Preference
                    </div>

                    <div class="applicant-group-name">
                        @(string.IsNullOrWhiteSpace(Model.GroupName)
                            ? "No group selected"
                            : Model.GroupName)
                    </div>
                </div>

            </div>

        </div>


        <div class="applicant-divider"></div>


        <!-- INFORMATION GRID -->
        <div class="applicant-information-grid">

            <!-- EMAIL -->
            <div class="applicant-info-item">

                <div class="applicant-info-icon">
                    <i class="bi bi-envelope"></i>
                </div>

                <div>
                    <div class="applicant-info-label">
                        Email Address
                    </div>

                    <div class="applicant-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? "N/A"
                            : Model.Email)
                    </div>
                </div>

            </div>


            <!-- CONTACT -->
            <div class="applicant-info-item">

                <div class="applicant-info-icon">
                    <i class="bi bi-telephone"></i>
                </div>

                <div>
                    <div class="applicant-info-label">
                        Contact Number
                    </div>

                    <div class="applicant-info-value">
                        @(string.IsNullOrWhiteSpace(Model.ContactNumber)
                            ? "N/A"
                            : Model.ContactNumber)
                    </div>
                </div>

            </div>


            <!-- DATE OF BIRTH -->
            <div class="applicant-info-item">

                <div class="applicant-info-icon">
                    <i class="bi bi-calendar3"></i>
                </div>

                <div>
                    <div class="applicant-info-label">
                        Date of Birth
                    </div>

                    <div class="applicant-info-value">
                        @(Model.DateOfBirth?.ToString("MMMM d, yyyy") ?? "N/A")
                    </div>
                </div>

            </div>


            <!-- GENDER -->
            <div class="applicant-info-item">

                <div class="applicant-info-icon">
                    <i class="bi bi-gender-ambiguous"></i>
                </div>

                <div>
                    <div class="applicant-info-label">
                        Gender
                    </div>

                    <div class="applicant-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Gender)
                            ? "N/A"
                            : Model.Gender)
                    </div>
                </div>

            </div>


            <!-- ADDRESS -->
            <div class="applicant-info-item">

                <div class="applicant-info-icon">
                    <i class="bi bi-geo-alt"></i>
                </div>

                <div>
                    <div class="applicant-info-label">
                        Address
                    </div>

                    <div class="applicant-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "N/A"
                            : Model.Address)
                    </div>
                </div>

            </div>


            <!-- AGE -->
            <div class="applicant-info-item">

                <div class="applicant-info-icon">
                    <i class="bi bi-person"></i>
                </div>

                <div>
                    <div class="applicant-info-label">
                        Age
                    </div>

                    <div class="applicant-info-value">
                        @(age?.ToString() ?? "N/A")
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MEMBERSHIP APPLICATION DETAILS
    ====================================================== -->
    <div class="applicant-details-section application-details-section">

        <div class="applicant-section-title">
            <i class="bi bi-file-earmark-text-fill"></i>
            <span>Membership Application Details</span>
        </div>


        <div class="application-status-grid">

            <!-- Guidelines -->
            <div class="application-status-item">

                @if (Model.AcceptedGuidelines)
                {
                    <span class="application-check success">
                        <i class="bi bi-check-lg"></i>
                    </span>
                }
                else
                {
                    <span class="application-check failed">
                        <i class="bi bi-x-lg"></i>
                    </span>
                }

                <span class="application-status-text">
                    Membership Guidelines
                </span>

            </div>


            <!-- Privacy -->
            <div class="application-status-item">

                @if (Model.AcceptedPrivacy)
                {
                    <span class="application-check success">
                        <i class="bi bi-check-lg"></i>
                    </span>
                }
                else
                {
                    <span class="application-check failed">
                        <i class="bi bi-x-lg"></i>
                    </span>
                }

                <span class="application-status-text">
                    Data Privacy & Consent
                </span>

            </div>

        </div>

    </div>

    <!-- =====================================================
         BUTTONS
    ====================================================== -->
    <div class="applicant-modal-actions">

        <button type="button"
                class="applicant-action-btn reject-btn open-modal"
                data-url="@Url.Action("RejectModal", "YouthMembers", new { id = Model.MemberId })"
                data-title="Reject Membership Application">
            Reject
        </button>

        <button type="button"
                class="applicant-action-btn approve-btn open-modal"
                data-url="@Url.Action("ApproveModal", "YouthMembers", new { id = Model.MemberId })"
                data-title="Approve Membership">
            Approve
        </button>

    </div>

</div>