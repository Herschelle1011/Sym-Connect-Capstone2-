@model TransferMemberViewModel

<div class="text-center px-2 py-2">
    <div style="width:56px; height:56px; border-radius:50%;
        background:#dbeafe; display:flex; align-items:center;
        justify-content:center; margin:0 auto 14px;">
        <i class="ti ti-transfer" style="font-size:24px; color:#2563eb;"></i>
    </div>

    <p style="font-size:14px; margin-bottom:14px;">
        Transfer this member to a different group
    </p>
</div>

<form id="transferMemberForm" asp-action="ConfirmedTranferMember" asp-controller="Groups" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="memberId" value="@Model.memberId" />
    <input type="hidden" name="CurrentGroupId" value="@Model.currentGroupId" />

    <div class="mb-3 text-start">
        <label class="form-label fw-medium" style="font-size:13px;">Select new group</label>
        <select name="NewGroupId" class="form-select" required>
            <option value="">-- Select a group --</option>
            @if (Model.availableGroups != null)
            {
                @foreach (var group in Model.availableGroups)
                {
                    <option value="@group.groupId">@group.groupName</option>
                }
            }
        </select>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary w-50" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary w-50">
            Transfer member
        </button>
    </div>
</form>