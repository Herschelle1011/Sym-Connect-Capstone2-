@model GroupEditViewModel

<style>
    #editGroupForm .form-floating > .form-control,
    #editGroupForm .form-floating > .form-select {
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        font-size: 14px;
    }

        #editGroupForm .form-floating > .form-control:focus,
        #editGroupForm .form-floating > .form-select:focus {
            border-color: #4a6cf7;
            box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.12);
        }

    .egf-section-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #9ca3af;
        margin-bottom: 10px;
    }

    .cgf-status-pill {
        display: flex;
        gap: 8px;
    }

        .cgf-status-pill input[type="radio"] {
            display: none;
        }

        .cgf-status-pill label {
            flex: 1;
            text-align: center;
            padding: 10px 12px;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            font-size: 13px;
            font-weight: 600;
            color: #6b7280;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .cgf-status-pill input[value="Active"]:checked + label {
            background: #d1e7dd;
            border-color: #a3cfbb;
            color: #0f5132;
        }

        .cgf-status-pill input[value="Inactive"]:checked + label {
            background: #f3f4f6;
            border-color: #d1d5db;
            color: #4b5563;
        }

    #editGroupForm .btn-primary {
        background-color: #4a6cf7;
        border: none;
        border-radius: 10px;
        font-weight: 600;
    }

        #editGroupForm .btn-primary:hover {
            background-color: #3a58d9;
        }

    #editGroupForm .btn-light {
        border-radius: 10px;
        font-weight: 600;
        border: 1px solid #e5e7eb;
    }
</style>

<form id="editGroupForm" asp-action="Edit" asp-controller="Groups" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
    <input type="hidden" asp-for="GroupId" />

    <!-- ═══════ BASIC INFO ═══════ -->
    <div class="egf-section-label">
        <i class="bi bi-people-fill me-1"></i> Group details
    </div>

    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="GroupName"
                   class="form-control"
                   placeholder="Group Name" />
            <label asp-for="GroupName">Group name</label>
        </div>
        <span asp-validation-for="GroupName" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <div class="form-floating">
            <textarea asp-for="Description"
                      class="form-control"
                      placeholder="Description"
                      style="height: 100px;"></textarea>
            <label asp-for="Description">Description (optional)</label>
        </div>
    </div>

    <!-- ═══════ LEADERSHIP & STATUS ═══════ -->
    <div class="egf-section-label">
        <i class="bi bi-person-badge-fill me-1"></i> Leadership &amp; status
    </div>

    <div class="mb-4">
        <label class="d-block mb-2" style="font-size:13px; font-weight:600; color:#374151;">
            Group Leader
        </label>

        <input type="hidden" asp-for="LeaderId" id="selectedLeaderId" />
        <div id="leaderPickerTrigger"
             class="d-flex align-items-center gap-3 p-2 rounded"
             style="border: 1px dashed #d1d5db; cursor: pointer;"
             data-exclude-group-id="@(Model.GroupId > 0 ? Model.GroupId.ToString() : "")">

            @if (Model.LeaderId.HasValue)
            {
                <img src="@(string.IsNullOrEmpty(Model.CurrentLeaderPhotoUrl) ? $"https://ui-avatars.com/api/?name={Model.CurrentLeaderName}&background=4a6cf7&color=fff&size=40" : Model.CurrentLeaderPhotoUrl)"
                     id="leaderAvatarImg"
                     class="rounded-circle"
                     width="40" height="40"
                     alt="Leader" />

                <div class="flex-grow-1">
                    <div id="selectedLeaderName" class="fw-semibold">@Model.CurrentLeaderName</div>
                    <div id="selectedLeaderEmail" class="small text-muted">@Model.CurrentLeaderEmail</div>
                </div>

                <span class="badge points-badge">
                    <i class="bi bi-star-fill me-1"></i>@Model.CurrentLeaderPoints pts
                </span>
            }
            else
            {
                <div id="leaderAvatarPlaceholder"
                     class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:40px; height:40px; background:#f1f5f9; color:#9ca3af; flex-shrink:0;">
                    <i class="bi bi-person-plus"></i>
                </div>
                <div class="flex-grow-1">
                    <div id="selectedLeaderName" class="fw-semibold text-muted">No leader selected</div>
                    <div id="selectedLeaderEmail" class="small text-muted"></div>
                </div>
            }

            <i class="bi bi-chevron-right text-muted"></i>
        </div>

        <span asp-validation-for="LeaderId" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label class="d-block mb-2" style="font-size:13px; font-weight:600; color:#374151;">
            Status
        </label>
        <div class="cgf-status-pill">
            <input type="radio" asp-for="Status" id="statusActive" value="Active" />
            <label for="statusActive"><i class="bi bi-check-circle me-1"></i>Active</label>

            <input type="radio" asp-for="Status" id="statusInactive" value="Inactive" />
            <label for="statusInactive"><i class="bi bi-pause-circle me-1"></i>Inactive</label>
        </div>
    </div>

    <!-- Footer Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top: 1px solid #f1f5f9;">
        <button type="button"
                class="btn btn-light px-4"
                data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-lg me-1"></i> Save Changes
        </button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}