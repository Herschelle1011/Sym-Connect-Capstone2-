@model GroupViewModel.GroupDeleteViewModel

<div style="padding: 0 0.25rem 0.5rem;">

    @* Warning Icon *@
    <div style="display:flex; justify-content:center; margin-bottom:1.25rem;">
        <div style="width:56px; height:56px; border-radius:50%;
                    background:#fee2e2; display:flex;
                    align-items:center; justify-content:center;">
            <i class="ti ti-trash" style="font-size:24px; color:#dc2626;"></i>
        </div>
    </div>

    @* Message *@
    <p style="text-align:center; color:#374151; font-size:14px; margin-bottom:1.25rem; line-height:1.6;">
        Are you sure you want to remove
        <strong>@Model.GroupName</strong>?
        This action can
        be undone.
    </p>

    @* Group Info Summary *@
    <div style="background:#f9fafb; border:1px solid #e5e7eb;
                border-radius:10px; padding:0.85rem 1rem; margin-bottom:1.5rem;">

        <div style="display:flex; justify-content:space-between;
                    padding:4px 0; font-size:13px;">
            <span style="color:#6b7280;">Group name</span>
            <span style="font-weight:500; color:#111827;">@Model.GroupName</span>
        </div>

        <div style="border-top:1px solid #e5e7eb; margin:4px 0;"></div>

        <div style="display:flex; justify-content:space-between;
                    padding:4px 0; font-size:13px;">
            <span style="color:#6b7280;">Leader</span>
            <span style="font-weight:500; color:#111827;">@Model.LeaderName</span>
        </div>

        <div style="border-top:1px solid #e5e7eb; margin:4px 0;"></div>

        <div style="display:flex; justify-content:space-between;
                    padding:4px 0; font-size:13px;">
            <span style="color:#6b7280;">Status</span>
            @if (Model.Status == "Active")
            {
                <span style="background:#dcfce7; color:#166534;
                                 font-size:11px; padding:2px 10px;
                                 border-radius:99px;">Active</span>
            }
            else
            {
                <span style="background:#fee2e2; color:#991b1b;
                                 font-size:11px; padding:2px 10px;
                                 border-radius:99px;">Inactive</span>
            }
        </div>

        <div style="border-top:1px solid #e5e7eb; margin:4px 0;"></div>

        <div style="display:flex; justify-content:space-between;
                    padding:4px 0; font-size:13px;">
            <span style="color:#6b7280;">Total members</span>
            <span style="font-weight:500; color:#111827;">@Model.TotalMembers</span>
        </div>
    </div>

    @* Buttons *@
    <div style="display:flex; gap:10px;">

        @* Cancel — dismisses the modal *@
        <button type="button"
                data-bs-dismiss="modal"
                style="flex:1; padding:9px; border:1px solid #e5e7eb;
                       border-radius:10px; background:#fff;
                       font-size:14px; color:#374151; cursor:pointer;">
            Cancel
        </button>

        @* Confirm Delete — posts to your existing DeleteConfirmed action *@
        <form method="post"
              asp-action="Delete"
              asp-controller="Groups"
              asp-route-id="@Model.GroupId"
              style="flex:1;">
            @Html.AntiForgeryToken()
            <button type="submit"
                    style="width:100%; padding:9px;
                           background:#dc2626; color:#fff;
                           border:none; border-radius:10px;
                           font-size:14px; font-weight:500; cursor:pointer;">
                Remove
            </button>
        </form>
    </div>
</div>