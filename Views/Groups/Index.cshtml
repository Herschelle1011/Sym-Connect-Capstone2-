@model IEnumerable<Sym_Connect__Capstone2_.ViewModels.GroupViewModel.GroupListViewModel>
@{
    ViewData["Title"] = "Groups";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_Modal")

<div style="padding: 1.5rem 0;">

    @* {{-- Header --}} *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-4 fw-medium mb-0">Groups</h1>

        <!-- opens modal -->
        <button class="btn btn-primary btn-sm"
                onclick="openModal(
                    'Create group',
                    '@Url.Action("GetCreateForm", "Groups")')">
            <i class="ti ti-plus"></i> Create group
        </button>
    </div>

    @* {{-- Cards Grid --}} *@
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card border h-100"
                     style="border-radius: 12px; cursor: pointer;"
                     onclick="location.href='@Url.Action("Details", "Groups", new { id = item.GroupId })'">
                    <div class="card-body p-3">

                        @* {{-- Group Name + Status --}} *@
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="fw-medium">@item.GroupName</span>
                            <div class="d-flex align-items-center gap-2">
                                @if (item.Status == "Active")
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#dcfce7; color:#166534; font-size:11px;">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill"
                                          style="background:#fee2e2; color:#991b1b; font-size:11px;">
                                        Inactive
                                    </span>
                                }
                            </div>
                        </div>

                        @* {{-- Leader Info --}} *@
                        <div class="d-flex align-items-center gap-2 mb-3">
                            @* {{-- Avatar with initials --}} *@
                            <div style="width:40px; height:40px; border-radius:50%;
                                            background:#dbeafe; color:#1e40af;
                                            display:flex; align-items:center;
                                            justify-content:center; font-size:13px;
                                            font-weight:500; flex-shrink:0;">
                                @(item.LeaderName.Length >= 2
                                                            ? item.LeaderName.Substring(0, 2).ToUpper()
                                                            : item.LeaderName.ToUpper())
                            </div>
                            <div>
                                <p class="mb-0 fw-medium" style="font-size:14px;">
                                    @item.LeaderName
                                </p>
                                <p class="mb-0 text-muted" style="font-size:12px;">
                                    @item.LeaderEmail
                                </p>
                            </div>
                        </div>

                        @* {{-- Bottom: Member Avatars + Actions --}} *@
                        <div class="d-flex justify-content-between align-items-center pt-2"
                             style="border-top: 0.5px solid #e5e7eb;">

                            @* {{-- Member Avatars --}} *@
                            <div class="d-flex align-items-center">
                                @{
                                    if (!item.Members.Any())
                                    {
                                        <span style="font-size:12px; color:#9ca3af; font-style:italic;">
                                            No members yet
                                        </span>
                                    }
                                    else
                                    {
                                       
                                            var displayed = item.Members.Take(3).ToList();
                                            var remaining = item.Members.Count - 3;
                                       
                                
                                @foreach (var member in displayed)
                                {
                                    <div style="width:28px; height:28px; border-radius:50%;
                                                        background:#bfdbfe; color:#1e40af;
                                                        display:flex; align-items:center;
                                                        justify-content:center; font-size:11px;
                                                        font-weight:500; border:2px solid #fff;
                                                        margin-right:-8px;"
                                         title="@member.FullName">
                                        @(member.FullName.Length >= 2
                                                                        ? member.FullName.Substring(0, 2).ToUpper()
                                                                        : member.FullName.ToUpper())
                                    </div>
                                }
                                @if (remaining > 0)
                                {
                                    <div style="width:28px; height:28px; border-radius:50%;
                                                        background:#f3f4f6; color:#6b7280;
                                                        display:flex; align-items:center;
                                                        justify-content:center; font-size:11px;
                                                        border:2px solid #fff; margin-right:-8px;">
                                        +@remaining
                                    </div>
                                }
                                }
                                }
                            </div>

                            @* {{-- Action Icons --}} *@
                            <div class="d-flex gap-2">
                                <a 
                                   onclick="event.stopPropagation(); openModal('Edit group', '@Url.Action("GetEditForm", "Groups", new {id = item.GroupId} )')"
                                   style="color:#2563eb; font-size:15px;">

                                    <i class="ti ti-edit"></i>
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.GroupId"
                                   style="color:#6b7280; font-size:15px;" onclick="event.stopPropagation()">
                                    <i class="ti ti-info-circle"></i>
                                </a>
                                <a onclick="event.stopPropagation();
                openModal('Delete group',
                '@Url.Action("GetDeleteForm", "Groups", new { id = item.GroupId })')"
                                   style="color:#dc2626; font-size:15px; cursor:pointer;">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function openModal(title, url) {
        // Set the modal title
        document.getElementById('appModalLabel').innerText = title;

        // Load the form content from the server
        fetch(url)
            .then(response => response.text())
            .then(html => {
                document.getElementById('appModalBody').innerHTML = html;

                // Open the modal
                var modal = new bootstrap.Modal(
                    document.getElementById('appModal'));
                modal.show();
            });
    }
    </script>