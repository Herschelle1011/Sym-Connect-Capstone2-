@model IEnumerable<GroupListViewModel>
@{
    ViewData["Title"] = "Groups";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@await Html.PartialAsync("_Modal")

<style>
    .groups-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 0 1.25rem;
    }

    .groups-header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .groups-header-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #EEF0FF;
        color: #3860D6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .groups-header-title {
        font-size: 26px;
        font-weight: 700;
        color: #1a1f2b;
        margin: 0;
    }

    .groups-header-subtitle {
        font-size: 13.5px;
        color: #9aa3b8;
        margin: 2px 0 0;
    }

    .btn-create-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #3860D6;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-create-group:hover {
            background: #2E4EB8;
            color: #fff;
        }

    .groups-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #EEF0FF;
        color: #3860D6;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .groups-divider {
        border-top: 1px solid #eef0f5;
        margin-bottom: 24px;
    }

    /* ---- Group card ---- */
    .group-card {
        background: #fff;
        border: 1px solid #eef0f5;
        border-top: 3px solid #3860D6;
        border-radius: 14px;
        padding: 18px 20px;
        height: 100%;
        cursor: pointer;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
    }

        .group-card:hover {
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            transform: translateY(-1px);
        }

    .group-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-bottom: 14px;
        border-bottom: 1px solid #eef0f5;
        margin-bottom: 14px;
    }

    .group-card-title-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .group-icon-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #EEF0FF;
        color: #3860D6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .group-card-name {
        font-size: 16px;
        font-weight: 700;
        color: #1a1f2b;
    }

    .group-status-badge {
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .status-badge-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-badge-inactive {
        background: #fee2e2;
        color: #991b1b;
    }

    .group-leader-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid #eef0f5;
        margin-bottom: 12px;
    }

    .group-leader-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #f3f4f6;
        color: #9aa3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .group-leader-label {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #b0b5bd;
        margin-bottom: 2px;
    }

    .group-leader-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a1f2b;
    }

    .group-leader-email {
        font-size: 12.5px;
        color: #9aa3b8;
    }

    .group-card-actions {
        display: flex;
        justify-content: flex-end;
        gap: 16px;
    }

        .group-card-actions a {
            font-size: 15px;
            transition: opacity 0.15s;
        }

            .group-card-actions a:hover {
                opacity: 0.7;
            }

    /* ---- Pagination ---- */
    .groups-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 28px;
    }

    .page-nav-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid #eef0f5;
        background: #fff;
        color: #9aa3b8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .page-num-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #3860D6;
        color: #fff;
        font-weight: 600;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .groups-pagination-caption {
        text-align: center;
        font-size: 12.5px;
        color: #9aa3b8;
        margin-top: 10px;
    }
</style>

<div style="padding: 0 0 1.5rem;">

    @* ---- Header ---- *@
    <div class="groups-page-header">
        <div class="groups-header-left">
            <div class="groups-header-icon">
                <i class="ti ti-users"></i>
            </div>
            <div>
                <h1 class="groups-header-title">Groups</h1>
                <p class="groups-header-subtitle">Manage your groups and their leaders.</p>
            </div>
        </div>

        <button class="btn-create-group"
                onclick="openModal('Create group', '@Url.Action("GetCreateForm", "Groups")')">
            <i class="ti ti-plus"></i> Create group
        </button>
    </div>

    <div class="groups-divider"></div>

    @* ---- Stat pill ---- *@
    <div class="groups-stat-pill">
        <i class="ti ti-users"></i>
        @Model.Count(g => g.Status == "Active") Active Groups
    </div>

    @* ---- Cards Grid ---- *@
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="group-card"
                     onclick="location.href='@Url.Action("Details", "Groups", new { id = item.GroupId })'">

                    <div class="group-card-top">
                        <div class="group-card-title-row">
                            <div class="group-icon-circle">
                                <i class="ti ti-users"></i>
                            </div>
                            <span class="group-card-name">@item.GroupName</span>
                        </div>
                        @if (item.Status == "Active")
                        {
                            <span class="group-status-badge status-badge-active">Active</span>
                        }
                        else
                        {
                            <span class="group-status-badge status-badge-inactive">Inactive</span>
                        }
                    </div>

                    <div class="group-leader-row">
                        <div class="group-leader-avatar">
                            <i class="ti ti-user"></i>
                        </div>
                        <div>
                            <div class="group-leader-label">Leader</div>
                            <div class="group-leader-name">@item.LeaderName</div>
                            <div class="group-leader-email">@item.LeaderEmail</div>
                        </div>
                    </div>

                    <div class="group-card-actions">
                        <a onclick="event.stopPropagation(); openModal('Edit group', '@Url.Action("GetEditForm", "Groups", new { id = item.GroupId })')"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Edit group"
                           style="color:#3860D6; cursor:pointer;">
                            <i class="ti ti-edit"></i>
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.GroupId"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="View details"
                           style="color:#6b7280;"
                           onclick="event.stopPropagation()">
                            <i class="ti ti-eye"></i>
                        </a>

                        <a onclick="event.stopPropagation(); openModal('Archive Group', '@Url.Action("GetArchivedModalGroups", "Groups", new { id = item.GroupId })', 'sm')"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Archive group"
                           style="color:#d97706; cursor:pointer;">
                            <i class="bi bi-archive"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

   

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

        @await Html.PartialAsync("_LeaderPickerModal")

        <script>
                document.querySelectorAll(".archive-group-btn").forEach(function (button) {

                    button.addEventListener("click", function (event) {

                        event.stopPropagation();

                        const url = this.dataset.url;
                        const title = this.dataset.title;
                        const size = this.dataset.modalSize;

                        openModal(title, url, size);
                    });

                });                    

        </script>
}