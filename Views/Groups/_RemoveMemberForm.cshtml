@model RemoveMemberViewModel

<div class="text-center px-2 py-2">
    <div style="width:56px; height:56px; border-radius:50%;
        background:#fee2e2; display:flex; align-items:center;
        justify-content:center; margin:0 auto 14px;">
        <i class="ti ti-user-minus" style="font-size:24px; color:#dc2626;"></i>
    </div>

    <p style="font-size:14px; margin-bottom:4px;">
        Remove <strong>@Model.MemberName</strong> from
    </p>
    <p style="font-size:14px; margin-bottom:6px;">
        <strong>@Model.GroupName</strong>?
    </p>
    <p class="text-muted" style="font-size:12px; margin-bottom:20px;">
        This only removes them from the group. Their member profile stays intact.
    </p>
</div>

<form id="removeMemberForm" asp-action="RemoveMemberFromGroupAsync" asp-controller="Groups" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="groupId" value="@Model.groupId" />
    <input type="hidden" name="memberId" value="@Model.memberId" />

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary w-50" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-danger w-50">
            Remove member
        </button>
    </div>
</form>