@model GroupDetailsViewModel
@{
    ViewData["Title"] = "Group Details";
    Layout = "_AdminLayout";
}


<div class="container-fluid py-4" data-group-id="@Model.GroupId">

    @* {{-- Back + Group Name + Member Count --}} *@
    <div class="d-flex align-items-center gap-3 mb-3">
        <a asp-action="Index"
           class="page-back-btn" title="Back to Groups" aria-label="Back to Groups">
            <i class="ti ti-arrow-left"></i>
        </a>

        <div class="group-title-row">
            <h1 class="group-title">@Model.GroupName</h1>
            <div class="member-count-badge">
                <i class="ti ti-crown"></i>
                <span class="count">@Model.TotalMembers</span>
                <span class="label">members</span>
            </div>
            <div class="member-count-badge" style="background:#fff7ed; color:#c2410c;">
                <i class="ti ti-star"></i>
                <span class="count">@Model.TotalPoints</span>
                <span class="label">group points</span>
            </div>
        </div>
    </div>

    @* {{-- Leader Info --}} *@
    <div class="leader-section">
        <div class="leader-avatar">
            <img src="@(string.IsNullOrWhiteSpace(Model.PhotoUrl)
                         ? "/images/default-avatar.png"
                         : Model.PhotoUrl)"
                 alt="@Model.LeaderName"
                 class="leader-profile-image" />
        </div>

        <div>
            <div class="leader-name-row">
                <span class="leader-name">@Model.LeaderName</span>
                @if (Model.Status == "Active")
                {
                    <span class="status-badge active">Active</span>
                }
                else
                {
                    <span class="status-badge inactive">Inactive</span>
                }
            </div>

            <div class="leader-contact">
                <span><i class="ti ti-mail"></i> @Model.LeaderEmail</span>
                <span><i class="ti ti-phone"></i> @Model.LeaderContact</span>
            </div>

            <p class="leader-description">
                <strong>Description</strong><br />
                @Model.Description
            </p>
        </div>
    </div>

    @* {{-- Filter Tabs + Buttons --}} *@
    @{
        var totalCount = Model.Members.Count;
        var activeCount = Model.Members.Count(m => m.Status == "Active");
        var inactiveCount = Model.Members.Count(m => m.Status == "Inactive");
    }

    <div class="group-toolbar">
        <div class="toolbar-tabs-row">
            <div class="tab-group">
                <button class="tab-btn active" onclick="filterMembers('all', this)">
                    All (@totalCount)
                </button>
                <button class="tab-btn" onclick="filterMembers('Active', this)">
                    Active (@activeCount)
                </button>
                <button class="tab-btn" onclick="filterMembers('Inactive', this)">
                    Inactive (@inactiveCount)
                </button>
            </div>
            <div class="filter-date-group">
                <div class="dropdown">
                    <button class="btn-outline-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="ti ti-arrows-sort"></i>
                        <span id="sortLabel">Points: High to Low</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="sortMenu">
                        <li><button type="button" class="dropdown-item active" data-sort="points-desc">Points: High to Low</button></li>
                        <li><button type="button" class="dropdown-item" data-sort="points-asc">Points: Low to High</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><button type="button" class="dropdown-item" data-sort="name-asc">Name: A to Z</button></li>
                        <li><button type="button" class="dropdown-item" data-sort="name-desc">Name: Z to A</button></li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="add-member-row">
            @* {{-- Add Member — wire this to your AddMember action later --}} *@
            <button class="btn-add-member" onclick="openAddMemberModal()">
                <i class="ti ti-plus"></i> Add Member
            </button>
        </div>
    </div>

    @* {{-- Members Table --}} *@
    <div class="table-card">
        <table class="table members-table mb-0">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Contact Number</th>
                    <th class="text-center">Points</th>
                    <th class="text-center">Status</th>
                    <th>Joined Date</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody id="membersBody">
                @if (!Model.Members.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="6">
                            <div style="display:flex; flex-direction:column; align-items:center;
                                justify-content:center; padding:60px 20px; gap:12px;">

                                <div style="width:64px; height:64px; border-radius:50%;
                                    background:#eff6ff; display:flex;
                                    align-items:center; justify-content:center;">
                                    <i class="ti ti-users" style="font-size:28px; color:#93c5fd;"></i>
                                </div>

                                <p style="font-size:15px; font-weight:500; color:#111827; margin:0;">
                                    No members yet
                                </p>

                                <p style="font-size:13px; color:#9ca3af; margin:0; text-align:center;">
                                    This group has no members. Start by adding one.
                                </p>

                                <button onclick="openAddMemberModal()" class="btn-add-member" style="margin-top:4px; border-radius:8px;">
                                    <i class="ti ti-plus"></i> Add Member
                                </button>

                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var member in Model.Members)
                    {
                        <tr data-status="@member.Status"
                            data-member-id="@member.MemberId"
                            data-name="@member.FullName"
                            data-points="@member.EarnedPoints">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar">
                                        <img src="@(string.IsNullOrWhiteSpace(member.PhotoUrl)
                                                     ? "/images/default-avatar.png"
                                                     : member.PhotoUrl)"
                                             alt="@member.FullName"
                                             class="member-profile-image" />
                                    </div>
                                    @member.FullName
                                </div>
                            </td>
                            <td class="text-muted">@member.Email</td>
                            <td class="text-muted">@member.ContactNumber</td>
                            <td class="text-center">
                                <span style="font-weight:600;">@member.EarnedPoints</span>
                                @if (member.IsTopContributor)
                                {
                                    <i class="ti ti-trophy" style="color:#d97706; margin-left:4px;" title="Outstanding member"></i>
                                }
                            </td>

                            <td class="text-center">
                                @if (member.Status == "Active")
                                {
                                    <span class="status-badge active">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-muted">
                                @member.DateRegistered.ToString("MMMM dd, yyyy")
                            </td>
                            <td class="text-center">
                                <div class="action-icons">
                                    <a href="javascript:void(0)"
                                       class="open-modal"
                                       data-url="@Url.Action("getTranferMember", "Groups", new { groupId = Model.GroupId, memberId = member.MemberId })"
                                       data-title="Transfer member"
                                       style="color:#2563eb;"
                                       title="Transfer to another group">
                                        <i class="ti ti-transfer" style="font-size:16px;"></i>
                                    </a>

                                    <a href="javascript:void(0)"
                                       class="open-modal"
                                       data-url="@Url.Action("GetRemoveMemberForm", "Groups", new { groupId = Model.GroupId, memberId = member.MemberId })"
                                       data-title="Remove member"
                                       style="color:#dc2626;"
                                       title="Remove from group">
                                        <i class="ti ti-user-minus" style="font-size:16px;"></i>
                                    </a>

                                    <a href="javascript:void(0)"
                                       class="open-modal"
                                       data-url="@Url.Action("GetPromoteLeaderForm", "Groups", new { groupId = Model.GroupId, memberId = member.MemberId })"
                                       data-title="Make leader"
                                       style="color:#16a34a;"
                                       title="Make group leader">
                                        <i class="ti ti-crown" style="font-size:16px;"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>


@* ===== ADD MEMBER MODAL ===== *@
<div id="addMemberModal"
     style="display:none; position:fixed; inset:0; z-index:1050;
                background:rgba(0,0,0,0.45);
                align-items:center; justify-content:center;">

    <div style="background:#fff; border-radius:16px; padding:1.5rem;
                    width:100%; max-width:460px; margin:auto; position:relative;">

        @* Header *@
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h5 style="margin:0; font-weight:500;">Add members</h5>
            <button onclick="closeAddMemberModal()"
                    style="background:none; border:none; font-size:20px; cursor:pointer; color:#6b7280;">
                <i class="ti ti-x"></i>
            </button>
        </div>


        @* Search *@
        <div style="
            display:flex;
            align-items:center;
            gap:8px;
            border:1px solid #e5e7eb;
            border-radius:10px;
            padding:8px 12px;
            margin-bottom:10px;
            ">
            <i class="ti ti-search" style="color:#9ca3af;"></i>

            <input id="memberSearchInput"
                   type="text"
                   placeholder="Search name or email..."
                   oninput="searchMembers(this.value)"
                   style="
            border:none;
            outline:none;
            width:100%;
            font-size:14px;
            " />
        </div>


        @* Selected Members *@
        <div id="selectedTags"
             style="
            display:flex;
            flex-wrap:wrap;
            gap:6px;
            margin-bottom:10px;
            min-height:28px;
            ">
        </div>


        @* Available Member Label *@
        <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin:8px 2px 6px 2px;
            ">
            <span style="
                font-size:12px;
                font-weight:500;
                color:#6b7280;
                ">
                Available members
            </span>

            <span style="
                font-size:11px;
                color:#9ca3af;
                ">
                <i class="ti ti-sort-descending"></i>
                Highest points first
            </span>
        </div>


        @* Results *@
        <div id="searchResults"
             style="
            border:1px solid #e5e7eb;
            border-radius:10px;
            overflow:hidden;
            max-height:260px;
            overflow-y:auto;
            ">

            <div id="searchPlaceholder"
                 style="
                padding:16px;
                text-align:center;
                color:#9ca3af;
                font-size:13px;
                ">
                Loading members...
            </div>
        </div>

        @* Confirm Button — posts to your controller *@
        <form method="post"
              asp-action="AddMemberToGroup"
              asp-controller="Groups"
              id="addMemberForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.GroupId" />
            <div id="hiddenMemberInputs"></div>
            <button type="submit"
                    id="confirmAddBtn"
                    disabled
                    style="width:100%; margin-top:12px; padding:10px;
                               background:#2563eb; color:#fff; border:none;
                               border-radius:10px; font-size:14px; font-weight:500;
                               cursor:pointer; opacity:0.5;">
                Add 0 members to group
            </button>
        </form>
    </div>
</div>

@* {{-- Filter Script --}} *@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
  <script src="~/js/admin/GroupMember.js"></script>

    <script>
        document.getElementById('sortMenu').addEventListener('click', function (e) {
        const item = e.target.closest('[data-sort]');
        if (!item) return;

        const mode = item.dataset.sort;
        const body = document.getElementById('membersBody');
        const rows = Array.from(body.querySelectorAll('tr[data-member-id]'));

        rows.sort((a, b) => {
        const nameA = a.dataset.name, nameB = b.dataset.name;
        const ptsA = Number(a.dataset.points), ptsB = Number(b.dataset.points);

        switch (mode) {
        case 'name-asc':   return nameA.localeCompare(nameB, undefined, { sensitivity: 'base' });
        case 'name-desc':  return nameB.localeCompare(nameA, undefined, { sensitivity: 'base' });
        case 'points-asc': return ptsA - ptsB || nameA.localeCompare(nameB);
        default:           return ptsB - ptsA || nameA.localeCompare(nameB); // points-desc
        }
        });

        rows.forEach(r => body.appendChild(r));

        document.querySelectorAll('#sortMenu .dropdown-item').forEach(i => i.classList.toggle('active', i === item));
        document.getElementById('sortLabel').textContent = item.textContent;
        });
    </script>

}
