@model GroupDetailsViewModel
@{
    ViewData["Title"] = "Group Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    @* {{-- Group Name + Member Count --}} *@
    <div class="d-flex align-items-center gap-3 mb-3">

        @* {{-- Back button --}} *@
        <a asp-action="Index"
           style="color:#6b7280; font-size:20px; text-decoration:none;"
           title="Back to Groups">
            <i class="ti ti-arrow-left"></i>
        </a>

        <h1 class="fs-4 fw-medium mb-0">@Model.GroupName</h1>
        <div class="d-flex align-items-center gap-1 px-2 py-1"
             style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;">
            <i class="ti ti-crown" style="color:#f59e0b; font-size:14px;"></i>
            <span class="fw-medium" style="font-size:13px;">@Model.TotalMembers</span>
            <span class="text-muted" style="font-size:11px;">members</span>
        </div>
    </div>

    @* {{-- Leader Info --}} *@
    <div class="d-flex align-items-start gap-3 mb-4">

        @* {{-- Leader Avatar --}} *@
        <div style="width:56px; height:56px; border-radius:50%;
                    background:#dbeafe; color:#1e40af;
                    display:flex; align-items:center; justify-content:center;
                    font-size:16px; font-weight:500; flex-shrink:0;">
            @(Model.LeaderName.Length >= 2
                        ? Model.LeaderName.Substring(0, 2).ToUpper()
                        : Model.LeaderName.ToUpper())
        </div>

        <div>
            @* {{-- Name + Status --}} *@
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fw-medium" style="font-size:16px;">@Model.LeaderName</span>
                @if (Model.Status == "Active")
                {
                    <span style="background:#dcfce7; color:#166534;
                                     font-size:11px; padding:3px 10px;
                                     border-radius:99px;">
                        Active
                    </span>
                }
                else
                {
                    <span style="background:#fee2e2; color:#991b1b;
                                     font-size:11px; padding:3px 10px;
                                     border-radius:99px;">
                        Inactive
                    </span>
                }
            </div>

            @* {{-- Email + Contact --}} *@
            <div class="d-flex gap-3 mb-2">
                <span class="text-muted" style="font-size:13px;">
                    <i class="ti ti-mail" style="font-size:14px;"></i>
                    @Model.LeaderEmail
                </span>
                <span class="text-muted" style="font-size:13px;">
                    <i class="ti ti-phone" style="font-size:14px;"></i>
                    @Model.LeaderContact
                </span>
            </div>

            @* {{-- Description --}} *@
            <p class="text-muted mb-0" style="font-size:13px;">
                <strong>Description</strong><br />
                @Model.Description
            </p>
        </div>
    </div>

    @* {{-- Filter Tabs + Buttons --}} *@
    @{
        var totalCount = Model.Members.Count;
        var activeCount = Model.Members.Count(m => m.Status == "Active");
        var inactiveCount = Model.Members.Count(m => m.Status == "Inactive");
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <button class="tab-btn active"
                    onclick="filterMembers('all', this)">
                All (@totalCount)
            </button>
            <button class="tab-btn"
                    onclick="filterMembers('Active', this)">
                Active (@activeCount)
            </button>
            <button class="tab-btn"
                    onclick="filterMembers('Inactive', this)">
                Inactive (@inactiveCount)
            </button>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-filter"></i> Filter
            </button>
            <button class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-calendar"></i> Date
            </button>

            @* {{-- Add Member — wire this to your AddMember action later --}} *@
            <button class="btn btn-primary btn-sm" onclick="openAddMemberModal()">
                <i class="ti ti-plus"></i> Add Member
            </button>
        </div>
    </div>

    @* {{-- Members Table --}} *@
    <div style="border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;">
        <table class="table members-table mb-0">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Contact Number</th>
                    <th class="text-center">Status</th>
                    <th>Joined Date</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody id="membersBody">
                @if (!Model.Members.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="6">
                            <div style="display:flex; flex-direction:column; align-items:center;
                                justify-content:center; padding:60px 20px; gap:12px;">

                                <div style="width:64px; height:64px; border-radius:50%;
                                    background:#eff6ff; display:flex;
                                    align-items:center; justify-content:center;">
                                    <i class="ti ti-users" style="font-size:28px; color:#93c5fd;"></i>
                                </div>

                                <p style="font-size:15px; font-weight:500; color:#111827; margin:0;">
                                    No members yet
                                </p>

                                <p style="font-size:13px; color:#9ca3af; margin:0; text-align:center;">
                                    This group has no members. Start by adding one.
                                </p>

                                <button onclick="openAddMemberModal()"
                                        style="margin-top:4px; padding:8px 20px;
                                       background:#2563eb; color:#fff; border:none;
                                       border-radius:8px; font-size:13px;
                                       font-weight:500; cursor:pointer;">
                                    <i class="ti ti-plus"></i> Add Member
                                </button>

                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var member in Model.Members)
                    {
                        <tr data-status="@member.Status" data-member-id = "@member.MemberId">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar">
                                        @(member.FullName.Length >= 2
                                                                        ? member.FullName.Substring(0, 2).ToUpper()
                                                                        : member.FullName.ToUpper())
                                    </div>
                                    @member.FullName
                                </div>
                            </td>
                            <td class="text-muted">@member.Email</td>
                            <td class="text-muted">@member.ContactNumber</td>
                            <td class="text-center">
                                @if (member.Status == "Active")
                                {
                                    <span style="background:#dcfce7; color:#166534;
                                                 font-size:11px; padding:3px 10px;
                                                 border-radius:99px;">Active</span>
                                }
                                else
                                {
                                    <span style="background:#fee2e2; color:#991b1b;
                                                 font-size:11px; padding:3px 10px;
                                                 border-radius:99px;">Inactive</span>
                                }
                            </td>
                            <td class="text-muted">
                                @member.DateRegistered.ToString("MMMM dd, yyyy")
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-3">
                                    <a asp-action="EditMember"
                                       asp-route-id="@member.MemberId"
                                       style="color:#2563eb;">
                                        <i class="ti ti-edit" style="font-size:16px;"></i>
                                    </a>
                                    <a href="javascript:void(0)"
                                       class="open-modal"
                                       data-url="@Url.Action("GetRemoveMemberForm", "Groups", new { groupId = Model.GroupId, memberId = member.MemberId })"
                                       data-title="Remove member"
                                       style="color:#dc2626;"
                                       title="Remove from group">
                                        <i class="ti ti-user-minus" style="font-size:16px;"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>


@* ===== ADD MEMBER MODAL ===== *@
<div id="addMemberModal"
     style="display:none; position:fixed; inset:0; z-index:1050;
                background:rgba(0,0,0,0.45);
                align-items:center; justify-content:center;">

    <div style="background:#fff; border-radius:16px; padding:1.5rem;
                    width:100%; max-width:460px; margin:auto; position:relative;">

        @* Header *@
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h5 style="margin:0; font-weight:500;">Add members</h5>
            <button onclick="closeAddMemberModal()"
                    style="background:none; border:none; font-size:20px; cursor:pointer; color:#6b7280;">
                <i class="ti ti-x"></i>
            </button>
        </div>

        @* Search Input *@
        <div style="display:flex; align-items:center; gap:8px;
                        border:1px solid #e5e7eb; border-radius:10px;
                        padding:8px 12px; margin-bottom:10px;">
            <i class="ti ti-search" style="color:#9ca3af;"></i>
            <input id="memberSearchInput"
                   type="text"
                   placeholder="Search name or email..."
                   oninput="searchMembers(this.value)"
                   style="border:none; outline:none; width:100%; font-size:14px;" />
        </div>

        @* Selected Tags *@
        <div id="selectedTags"
             style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; min-height:28px;">
        </div>

        @* Search Results *@
        <div id="searchResults"
             style="border:1px solid #e5e7eb; border-radius:10px;
                        overflow:hidden; max-height:220px; overflow-y:auto;">
            <div id="searchPlaceholder"
                 style="padding:16px; text-align:center; color:#9ca3af; font-size:13px;">
                Start typing to search members...
            </div>
        </div>

        @* Confirm Button — posts to your controller *@
        <form method="post"
              asp-action="AddMemberToGroup"
              asp-controller="Groups"
              id="addMemberForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.GroupId" />
            <div id="hiddenMemberInputs"></div>
            <button type="submit"
                    id="confirmAddBtn"
                    disabled
                    style="width:100%; margin-top:12px; padding:10px;
                               background:#2563eb; color:#fff; border:none;
                               border-radius:10px; font-size:14px; font-weight:500;
                               cursor:pointer; opacity:0.5;">
                Add 0 members to group
            </button>
        </form>
    </div>
</div>

@* {{-- Filter Script --}} *@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
  <script src="~/js/admin/GroupMember.js"></script>
}