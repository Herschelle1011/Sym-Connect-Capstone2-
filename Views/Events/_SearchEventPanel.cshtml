<div class="offcanvas offcanvas-end search-event-panel" tabindex="-1" id="searchEventPanel">

    <div class="offcanvas-header border-bottom pb-2">
        <h5 class="offcanvas-title fw-medium">Search Events</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <div class="position-relative mb-3">
            <div class="input-group border rounded-3 overflow-hidden">
                <span class="input-group-text bg-white border-0 ps-3">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text"
                       id="eventSearchInput"
                       class="form-control border-0"
                       placeholder="Search events here..."
                       autocomplete="off" />
            </div>
        </div>
        <div id="eventSearchResults">
            <!-- JS injects one .event-result-card per match -->
        </div>
    </div>

</div>

<!-- Reference template for ONE result card — JS will clone/build this per event -->
<template id="eventResultCardTemplate">
    <a href="#" class="event-result-card text-decoration-none text-dark d-flex gap-3 align-items-start p-2 mb-2 rounded border-0">
        <div class="event-date-badge bg-dark text-white text-center rounded flex-shrink-0"
             style="width:50px; height:50px;">
            <div class="fw-bold fs-6 lh-1 pt-1 event-day"></div>
            <div class="text-uppercase small event-month"></div>
        </div>
        <div>
            <div class="fw-bold event-title"></div>
            <div class="text-muted small event-time"></div>
            <div class="text-muted small">
                <i class="bi bi-geo-alt"></i>
                <span class="event-facility"></span>
            </div>
        </div>
    </a>
</template>

