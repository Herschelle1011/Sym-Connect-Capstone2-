@model SummaryEventsViewModel

@{
    ViewData["Title"] = "Event Requests";
    Layout = "_AdminLayout";
}

<style>
    .dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 4px;
    }

    .date-box {
        background: #eef1ff;
        border-radius: 8px;
        padding: 6px 12px;
        min-width: 56px;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 500;
    }

    .status-pending {
        background: #fff3cd;
        color: #997404;
    }

    .status-approved {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-rejected {
        background: #f8d7da;
        color: #842029;
    }

    .btn-approve-event {
        background: #d1e7dd;
        color: #0f5132;
        border: none;
    }

        .btn-approve-event:hover {
            background: #b8dfc9;
        }

    .btn-reject-event {
        background: #f8d7da;
        color: #842029;
        border: none;
    }

        .btn-reject-event:hover {
            background: #f1b0b7;
        }
</style>
<div class="container-fluid py-4">

    <div style="display:none">
        @Html.AntiForgeryToken()
    </div>

    <!-- ═══════════════ STAT CARDS ═══════════════ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h3 class="fw-bold mb-1">@Model.TotalRequests</h3>
                    <span class="text-muted small">
                        <span class="dot bg-secondary"></span> Total requests
                    </span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h3 class="fw-bold mb-1">@Model.PendingCount</h3>
                    <span class="text-muted small">
                        <span class="dot bg-warning"></span> Awaiting review
                    </span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h3 class="fw-bold mb-1">@Model.ApprovedCount</h3>
                    <span class="text-muted small">
                        <span class="dot bg-success"></span> Approved
                    </span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h3 class="fw-bold mb-1">@Model.RejectedCount</h3>
                    <span class="text-muted small">
                        <span class="dot bg-danger"></span> Rejected
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ FILTER TABS + SEARCH ═══════════════ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div class="btn-group filter-tabs" role="group">
            <button type="button" class="btn btn-dark active" data-filter="all">
                All (@Model.TotalRequests)
            </button>
            <button type="button" class="btn btn-outline-secondary" data-filter="pending">
                Pending (@Model.PendingCount)
            </button>
            <button type="button" class="btn btn-outline-secondary" data-filter="approved">
                Approved (@Model.ApprovedCount)
            </button>
            <button type="button" class="btn btn-outline-secondary" data-filter="rejected">
                Rejected (@Model.RejectedCount)
            </button>
        </div>

        <input type="text"
               id="eventRequestSearch"
               class="form-control"
               style="max-width: 280px;"
               placeholder="Search your events..." />
    </div>

    <!-- ═══════════════ EVENT LIST ═══════════════ -->
    <div id="eventRequestList" class="d-flex flex-column gap-2">
        @foreach (var e in Model.Events)
        {
            var statusKey = e.ApprovalStatus.ToString().ToLower(); // "pending" | "approved" | "rejected"

            <div class="card border-0 shadow-sm event-request-row"
                 data-status="@statusKey"
                 data-title="@e.EventTitle.ToLower()"
                 data-url="@Url.Action("Details", "Events", new { id = e.EventId })"
                 style="cursor: pointer;">

                <div class="card-body d-flex align-items-center gap-3">

                    <!-- Date box -->
                    <div class="date-box text-center flex-shrink-0">
                        <div class="fw-bold text-primary">@e.StartDate.Day</div>
                        <div class="text-uppercase small text-muted">@e.StartDate.ToString("MMM")</div>
                    </div>

                    <!-- Main info -->
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold">@e.EventTitle</div>
                        <div class="text-muted small text-truncate">
                            @if (e.FacilityNames.Any())
                            {
                                @string.Join(", ", e.FacilityNames)
                                <span class="mx-1">·</span>
                            }
                            @if (e.GroupNames.Any())
                            {
                                @string.Join(", ", e.GroupNames)
                                <span class="mx-1">·</span>
                            }

                            @switch (e.ApprovalStatus)
                            {
                                case ApprovalStatus.Pending:
                                    <span>Submitted @e.DateCreated.ToTimeAgo()</span>
                                    break;
                                case ApprovalStatus.Approved:
                                    <span>Approved by @(e.ApproveByName ?? "Admin")</span>
                                    break;
                                case ApprovalStatus.Rejected:
                                    <span>Reviewed @(e.ApprovedDate?.ToTimeAgo() ?? e.DateCreated.ToTimeAgo())</span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Right side: actions or status badge -->
                    <div class="flex-shrink-0 d-flex align-items-center gap-2">
                        @if (e.ApprovalStatus == ApprovalStatus.Pending)
                        {
                            <span class="badge status-badge status-pending">Pending review</span>
                            <button type="button"
                                    class="btn btn-sm btn-approve-event"
                                    data-event-id="@e.EventId">
                                Approve
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-reject-event"
                                    data-event-id="@e.EventId"
                                    data-event-title="@e.EventTitle">
                                Reject
                            </button>
                        }
                        else if (e.ApprovalStatus == ApprovalStatus.Approved)
                        {
                            <span class="badge status-badge status-approved">Approved</span>
                        }
                        else
                        {
                            <span class="badge status-badge status-rejected"
                                  title="@e.RejectionReason">
                                Rejected
                            </span>
                        }
                    </div>
                    </div>
                </div>
     
        }
        <div id="noResultsMessage" class="text-center text-muted py-5 d-none">
            No events match your search.
        </div>
    </div>
</div>

<!-- Reject Reason Modal (uses shared #appModal shell pattern) -->
<partial name="_RejectReasonModal" />