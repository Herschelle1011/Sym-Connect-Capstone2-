@model EventListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Events Calendar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var firstOfMonth = new DateTime(Model.Year, Model.Month, 1);
    var startOffset = (int)firstOfMonth.DayOfWeek;
    var gridStart = firstOfMonth.AddDays(-startOffset);
    var today = DateTime.Today;
}

<style>
  
</style>

<div class="calendar-wrapper mx-auto">

    <div class="calendar-breadcrumb d-flex align-items-center gap-2 mb-2">
        <a asp-action="Index">Events Screen</a>
        <span class="breadcrumb-sep">&gt;</span>
        <span class="fw-bold">Calendar</span>
        <i class="ti ti-help-circle breadcrumb-help"></i>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h1 class="calendar-page-title">@Model.MonthLabel</h1>

        <div class="calendar-toolbar d-flex align-items-center gap-2 mb-0">
            <a asp-action="Index" asp-route-year="@today.Year" asp-route-month="@today.Month"
               class="calendar-btn-today">Today</a>

            <select class="calendar-month-select" onchange="if(this.value){window.location.href=this.value;}">
                @for (int m = 1; m <= 12; m++)
                {
                    var optUrl = Url.Action("Index", new { year = Model.Year, month = m });
                    if (m == Model.Month)
                    {
                        <option value="@optUrl" selected>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                    else
                    {
                        <option value="@optUrl">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                }
            </select>

            <a asp-action="Index" asp-route-year="@Model.PreviousYear" asp-route-month="@Model.PreviousMonth"
               class="calendar-icon-circle"><i class="ti ti-chevron-left"></i></a>
            <a asp-action="Index" asp-route-year="@Model.NextYear" asp-route-month="@Model.NextMonth"
               class="calendar-icon-circle"><i class="ti ti-chevron-right"></i></a>

            <button type="button" class="calendar-icon-circle"><i class="ti ti-search"></i></button>

            <button type="button" class="btn btn-primary ms-2" data-bs-toggle="offcanvas" data-bs-target="#eventPanel">
                <i class="ti ti-plus"></i> Add Event
            </button>
        </div>
    </div>

    <!-- GRID: tablet and desktop only -->
    <div class="calendar-card d-none d-md-block">

        <div class="calendar-grid calendar-weekday-row">
            @foreach (var dayName in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
            {
                <div class="text-center py-3 calendar-weekday">@dayName</div>
            }
        </div>

        <div class="calendar-grid">
            @for (int week = 0; week < 6; week++)
            {
                @for (int day = 0; day < 7; day++)
                {
                    var cellDate = gridStart.AddDays(week * 7 + day);
                    var isCurrentMonth = cellDate.Month == Model.Month;
                    var isToday = cellDate.Date == today;
                    var eventsToday = Model.Events.Where(e => e.StartDate.Date == cellDate.Date).ToList();

                    var cellClasses = "day-cell"
                    + (isCurrentMonth ? "" : " is-outside")
                    + (isToday ? " is-today" : "");

                    <div class="@cellClasses" data-date="@cellDate.ToString("yyyy-MM-dd")">

                        <span class="day-number">@cellDate.Day</span>
                        <div class="event-container">
                            @foreach (var evt in eventsToday)
                            {
                                var dotColor = evt.Status switch
                                {
                                    Sym_Connect__Capstone2_.Models.Enums.EventStatus.Ongoing => "#22c55e",
                                    Sym_Connect__Capstone2_.Models.Enums.EventStatus.Completed => "#9ca3af",
                                    Sym_Connect__Capstone2_.Models.Enums.EventStatus.Cancelled => "#ef4444",
                                    _ => "#3b82f6"
                                };

                                <a asp-action="Details" asp-route-id="@evt.EventId"
                                   class="event-pill"
                                   onclick="event.stopPropagation();">
                                    @if (!evt.IsAllDay && evt.StartTime.HasValue)
                                    {
                                        <div class="event-time">
                                            <span class="event-dot" style="background:@dotColor;"></span>@DateTime.Today.Add(evt.StartTime.Value).ToString("h:mm tt")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="event-time">
                                            <span class="event-dot" style="background:@dotColor;"></span>All day
                                        </div>
                                    }
                                    <div class="event-title text-truncate">@evt.EventTitle</div>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- LIST: phone only -->
    <div class="d-md-none">
        @if (!Model.Events.Any())
        {
            <p class="text-muted text-center py-4">No events this month.</p>
        }

        @foreach (var evt in Model.Events.OrderBy(e => e.StartDate).ThenBy(e => e.StartTime))
        {
            var dotColor = evt.Status switch
            {
                Sym_Connect__Capstone2_.Models.Enums.EventStatus.Ongoing => "#22c55e",
                Sym_Connect__Capstone2_.Models.Enums.EventStatus.Completed => "#9ca3af",
                Sym_Connect__Capstone2_.Models.Enums.EventStatus.Cancelled => "#ef4444",
                _ => "#3b82f6"
            };

            <a asp-action="Details" asp-route-id="@evt.EventId"
               class="d-flex align-items-start gap-3 text-decoration-none text-dark py-3"
               style="border-bottom:1px solid #e5e7eb;">

                <div class="text-center" style="min-width:44px;">
                    <div style="font-size:11px; color:#6b7280;">@evt.StartDate.ToString("MMM")</div>
                    <div style="font-size:18px; font-weight:600; color:#111827;">@evt.StartDate.Day</div>
                </div>

                <div class="flex-fill">
                    <div class="fw-medium">@evt.EventTitle</div>
                    <div style="font-size:12px; color:#6b7280;">
                        <span class="event-dot" style="background:@dotColor;"></span>
                        @(evt.IsAllDay || !evt.StartTime.HasValue
                            ? "All day"
                            : DateTime.Today.Add(evt.StartTime.Value).ToString("h:mm tt"))
                    </div>
                </div>
            </a>
        }
    </div>

</div>

@if (ViewBag.ShowCreatePanel == true)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var panel = bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('eventPanel'));
            panel.show();
        });

                document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.event-pill').forEach(function (link) {
                link.addEventListener('click', function () {
                    showLoading();
                });
            });
        });
    </script>
}

@{
    var createVm = ViewBag.FailedCreateVm as CreateEventViewModel
                   ?? new CreateEventViewModel();
}
@await Html.PartialAsync("_CreateEventPanel", createVm)