@model EventListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Events Calendar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var firstOfMonth = new DateTime(Model.Year, Model.Month, 1);
    var startOffset = (int)firstOfMonth.DayOfWeek;
    var gridStart = firstOfMonth.AddDays(-startOffset);
    var today = DateTime.Today;
}

<style>
  
</style>

<div class="calendar-wrapper mx-auto">

    <!-- Page Header -->
    <div class="events-header">

        <h1 class="events-title">Events</h1>

        <div class="events-toolbar">

            <!-- View Controls -->
            <div class="calendar-view-buttons">
                <button type="button" class="view-btn active">Month</button>
                <button type="button" class="view-btn">Year</button>

                <a asp-action="Index"
                   asp-route-year="@today.Year"
                   asp-route-month="@today.Month"
                   class="view-btn">
                    Today
                </a>
            </div>

            <!-- Month Navigation -->
            <div class="month-navigation">

                <a asp-action="Index"
                   asp-route-year="@Model.PreviousYear"
                   asp-route-month="@Model.PreviousMonth"
                   class="month-arrow">
                    <i class="ti ti-chevron-left"></i>
                </a>

                <span class="current-month">
                    @Model.MonthLabel.Replace(Model.Year.ToString(), "")
                </span>


                <span class="current-year">
                    @Model.Year
                </span>

                <a asp-action="Index"
                   asp-route-year="@Model.NextYear"
                   asp-route-month="@Model.NextMonth"
                   class="month-arrow">
                    <i class="ti ti-chevron-right"></i>
                </a>

            </div>

            <!-- Right Actions -->
            <div class="events-actions">

                <!-- Search -->
                <button type="button"
                        class="event-search-btn"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#searchEventPanel">
                    <span>Search</span>
                    <i class="ti ti-search"></i>
                </button>

                <!-- Facilities -->
                <a asp-action="AvailableFacilities"
                   class="event-action-btn">
                    <i class="ti ti-building"></i>
                    <span>View Facilities</span>
                </a>

                <!-- Requests -->
                <a asp-action="ViewEventsRequests"
                   class="event-action-btn position-relative">

                    <i class="ti ti-clipboard-check"></i>
                    <span>Event Requests</span>

                    @if (ViewBag.PendingRequestCount != null &&
                         (int)ViewBag.PendingRequestCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">
                            @ViewBag.PendingRequestCount
                        </span>
                    }

                </a>

                <!-- Create Event -->
                <button type="button"
                        class="create-event-btn"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#eventPanel">
                    <i class="ti ti-plus"></i>
                    Create Events
                </button>

            </div>

        </div>

    </div>

    <!-- GRID: tablet and desktop only -->
    <div class="calendar-card d-none d-md-block">

        <div class="calendar-grid calendar-weekday-row">
            @foreach (var dayName in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
            {
                <div class="text-center py-3 calendar-weekday">@dayName</div>
            }
        </div>

        <div class="calendar-grid">
            @for (int week = 0; week < 6; week++)
            {
                @for (int day = 0; day < 7; day++)
                {
                    var cellDate = gridStart.AddDays(week * 7 + day);
                    var isCurrentMonth = cellDate.Month == Model.Month;
                    var isToday = cellDate.Date == today;
                    var isPast = cellDate.Date < today;
                    var eventsToday = Model.Events.Where(e => e.StartDate.Date == cellDate.Date).ToList();

                    var cellClasses = "day-cell"
                    + (isCurrentMonth ? "" : " is-outside")
                    + (isToday ? " is-today" : "")
                    + (isPast ? " is-past" : ""); 

                    <div class="@cellClasses" data-date="@cellDate.ToString("yyyy-MM-dd")">

                        <span class="day-number">@cellDate.Day</span>
                        <div class="event-container">
                            @foreach (var evt in eventsToday)
                            {
                                var dotColor = evt.Status switch
                                {
                                    Sym_Connect__Capstone2_.Models.Enums.EventStatus.Ongoing => "#22c55e",
                                    Sym_Connect__Capstone2_.Models.Enums.EventStatus.Completed => "#9ca3af",
                                    Sym_Connect__Capstone2_.Models.Enums.EventStatus.Cancelled => "#ef4444",
                                    _ => "#3b82f6"
                                };

                                <a asp-action="Details" asp-route-id="@evt.EventId"
                                   class="event-pill"
                                   onclick="event.stopPropagation();">
                                    @if (!evt.IsAllDay && evt.StartTime.HasValue)
                                    {
                                        <div class="event-time">
                                            <span class="event-dot" style="background:@dotColor;"></span>@DateTime.Today.Add(evt.StartTime.Value).ToString("h:mm tt")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="event-time">
                                            <span class="event-dot" style="background:@dotColor;"></span>All day
                                        </div>
                                    }
                                    <div class="event-title text-truncate">@evt.EventTitle</div>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- LIST: phone only -->
    <div class="d-md-none">
        @if (!Model.Events.Any())
        {
            <p class="text-muted text-center py-4">No events this month.</p>
        }

        @foreach (var evt in Model.Events.OrderBy(e => e.StartDate).ThenBy(e => e.StartTime))
        {
            var dotColor = evt.Status switch
            {
                Sym_Connect__Capstone2_.Models.Enums.EventStatus.Ongoing => "#22c55e",
                Sym_Connect__Capstone2_.Models.Enums.EventStatus.Completed => "#9ca3af",
                Sym_Connect__Capstone2_.Models.Enums.EventStatus.Cancelled => "#ef4444",
                _ => "#3b82f6"
            };

            <a asp-action="Details" asp-route-id="@evt.EventId"
               class="d-flex align-items-start gap-3 text-decoration-none text-dark py-3"
               style="border-bottom:1px solid #e5e7eb;">

                <div class="text-center" style="min-width:44px;">
                    <div style="font-size:11px; color:#6b7280;">@evt.StartDate.ToString("MMM")</div>
                    <div style="font-size:18px; font-weight:600; color:#111827;">@evt.StartDate.Day</div>
                </div>

                <div class="flex-fill">
                    <div class="fw-medium">@evt.EventTitle</div>
                    <div style="font-size:12px; color:#6b7280;">
                        <span class="event-dot" style="background:@dotColor;"></span>
                        @(evt.IsAllDay || !evt.StartTime.HasValue
                            ? "All day"
                            : DateTime.Today.Add(evt.StartTime.Value).ToString("h:mm tt"))
                    </div>
                </div>
            </a>
        }
    </div>

</div>

@if (ViewBag.ShowCreatePanel == true)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var panel = bootstrap.Offcanvas.getOrCreateInstance(document.getElementById('eventPanel'));
            panel.show();
        });

                document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.event-pill').forEach(function (link) {
                link.addEventListener('click', function () {
                    showLoading();
                });
            });
        });
    </script>
}

@{
    var createVm = ViewBag.FailedCreateVm as CreateEventViewModel
                   ?? new CreateEventViewModel();
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/admin/Eventsearchpanel.js"></script>
    <script src="~/js/admin/OpenScannerTime.js"></script>


    <script>
        function handleEventFormSubmit(formSelector, offcanvasId) {
        $(document).on("submit", formSelector, function (e) {
        e.preventDefault();

        const form = $(this);
        const formData = new FormData(this);

        fetch(form.attr("action"), {
        method: "POST",
        body: formData
        })
        .then(res => res.json())
        .then(data => {
        if (data.success) {
        bootstrap.Offcanvas.getInstance(document.getElementById(offcanvasId))?.hide();
        location.reload();
        } else {
        alert(data.message);
        }
        })
        .catch(err => console.error(`${formSelector} submit failed:`, err));
        });
        }

        // handleEventFormSubmit("#createEventForm", "eventPanel");
        handleEventFormSubmit("#editEventForm", "editEventPanel");
    </script>

}
@await Html.PartialAsync("_CreateEventPanel", createVm)
@await Html.PartialAsync("_SearchEventPanel")

