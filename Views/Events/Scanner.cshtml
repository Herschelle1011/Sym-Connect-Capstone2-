@model Sym_Connect__Capstone2_.ViewModels.Event.ScannerViewModel
@{
    ViewData["Title"] = "Scan QR Code";
    Layout = "_AdminLayout";
}

<style>
    .scanner-page {
        max-width: 420px;
        margin: 0 auto;
        padding: 1.5rem 0;
    }

    .scanner-box {
        background: #1a2035;
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        margin-bottom: 1rem;
    }

    #qr-reader {
        border-radius: 12px;
        overflow: hidden;
    }

    .scanner-hint {
        color: #cbd5e1;
        font-size: 13px;
        margin-top: 10px;
    }

    .stats-row {
        display: flex;
        gap: 10px;
        margin-bottom: 1rem;
    }

    .stat-box {
        flex: 1;
        background: #f8fafc;
        border-radius: 12px;
        padding: 14px;
        text-align: center;
    }

    .stat-number {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
    }

    .stat-label {
        font-size: 11px;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .participant-row {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 8px;
    }

    .participant-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        background: #e5e7eb;
    }

    .participant-name {
        font-weight: 600;
        font-size: 14px;
        color: #111827;
    }

    .participant-time {
        font-size: 12px;
        color: #9ca3af;
    }
</style>

<div class="scanner-page">

    <div class="scanner-box">
        <div id="qr-reader"></div>
        <p class="scanner-hint">Align the QR code with the frame</p>
    </div>

    <div class="stats-row">
        <div class="stat-box">
            <div class="stat-number" id="presentCount">@Model.PresentCount</div>
            <div class="stat-label">Present</div>
        </div>
        <div class="stat-box">
            <div class="stat-number" id="totalCount">@Model.TotalMembersCount</div>
            <div class="stat-label">Total Members</div>
        </div>
    </div>
    <div id="scan-result" class="text-center mt-3 fw-bold"></div>


    <h6 class="fw-bold mb-2">Participants</h6>
    <div id="participantsList">
        @foreach (var p in Model.Participants)
        {
            <div class="participant-row">
                <img src="@(p.PhotoUrl ?? "/images/default-avatar.png")" class="participant-avatar" />
                <div>
                    <div class="participant-name">@p.FullName</div>
                    <div class="participant-time">
                        Checked in @(p.CheckedInAt.HasValue ? p.CheckedInAt.Value.ToString("h:mm tt") : "-")
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<script src="https://unpkg.com/html5-qrcode"></script>
<script>
    const eventId = @Model.EventId;
    const resultEl = document.getElementById('scan-result');
    let isProcessing = false;

    function refreshScannerState() {
    fetch(`/Events/GetScannerState?eventId=${eventId}`)
    .then(res => res.json())
    .then(data => {
    document.getElementById('presentCount').innerText = data.presentCount;
    document.getElementById('totalCount').innerText = data.totalMembersCount;

    const listEl = document.getElementById('participantsList');
    listEl.innerHTML = data.participants.map(p => `
    <div class="participant-row">
    <img src="${p.photoUrl || '/images/default-avatar.png'}" class="participant-avatar" />
    <div>
    <div class="participant-name">${p.fullName}</div>
    <div class="participant-time">Checked in ${p.checkedInAt ? new Date(p.checkedInAt).toLocaleTimeString([], {hour: 'numeric', minute:'2-digit'}) : '-'}</div>
    </div>
    </div>
    `).join('');
    });
    }

    function onScanSuccess(decodedText) {
    if (isProcessing) return;
    isProcessing = true;

    fetch('/Events/ScanTimeIn', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ qrToken: decodedText, eventId: eventId })
    })
    .then(res => res.json())
    .then(data => {
    resultEl.innerText = data.message;
    resultEl.style.color = data.success ? 'green' : 'red';

    if (data.success) refreshScannerState();

    setTimeout(() => { isProcessing = false; }, 2000);
    })
    .catch(() => { isProcessing = false; });
    }

    function getQrBoxSize() {
    const container = document.getElementById('qr-reader');
    const minEdge = Math.min(container.offsetWidth, container.offsetHeight || container.offsetWidth);
    const boxSize = Math.floor(minEdge * 0.7);
    return { width: boxSize, height: boxSize };
    }

    const scanner = new Html5Qrcode("qr-reader");
    scanner.start(
    { facingMode: "environment" },
    { fps: 10, qrbox: getQrBoxSize() },
    onScanSuccess
    ).catch(err => {
    resultEl.innerText = 'Camera start failed: ' + err;
    resultEl.style.color = 'red';
    });
</script>