@model List<ExpectedGroupCardVM>

@{
    var groupColors = new[] { "#2563eb", "#16a34a", "#f59e0b", "#9333ea", "#0891b2" };
}

@for (int i = 0; i < Model.Count; i++)
{
    var g = Model[i];
    var color = groupColors[i % groupColors.Length];
    <div class="group-item">
        <span class="group-avatar" style="background:@color;">
            <i class="ti ti-users"></i>
        </span>
        <div>
            <div class="group-name">@g.GroupName</div>
            <div class="group-count">@g.MemberCount Members</div>
        </div>
    </div>
}