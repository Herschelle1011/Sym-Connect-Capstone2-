@model EditEventViewModel

<div class="offcanvas offcanvas-end event-panel" tabindex="-1" id="editEventPanel" style="width: 420px;">

    <div class="offcanvas-header border-bottom pb-2">
        <h5 class="offcanvas-title fw-medium">Edit Event</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <form asp-action="Edit" asp-controller="Events" asp-route-eventid="@Model.EventId" method="post" id="editEventForm"
              data-time-in="@Model.TimeInScannerOpenTime?.ToString(@"hh\:mm")"
              data-time-out="@Model.TimeOutScannerOpenTime?.ToString(@"hh\:mm")">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EventId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3" style="font-size:13px;"></div>
            }


            <div class="mb-3">
                <label class="form-label">Event Title <span class="text-danger">*</span></label>
                <input asp-for="EventTitle" class="form-control" placeholder="Enter a title for this event" />
                <span asp-validation-for="EventTitle" class="text-danger" style="font-size:12px;"></span>
            </div>

       

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsAllDay" id="editIsAllDayToggle" />
                <label class="form-check-label" style="font-size:14px;" for="editIsAllDayToggle">
                    This is an All Day Event
                    <i class="ti ti-help-circle text-muted" style="font-size:12px;"></i>
                </label>
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                    <input asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" id="editStartDateInput" />
                    <span asp-validation-for="StartDate" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="col-6" id="editStartTimeGroup">
                    <label class="form-label">Start Time <span class="text-danger">*</span></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label class="form-label">End Date <span class="text-danger">*</span></label>
                    <input asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" id="editEndDateInput" />
                    <span asp-validation-for="EndDate" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="col-6" id="editEndTimeGroup">
                    <label class="form-label">End Time <span class="text-danger">*</span></label>
                    <input asp-for="EndTime" type="time" class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>

           
            <div class="mb-3">
                <label class="form-label">Facilities <span class="text-danger">*</span></label>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="selectAllFacilities" />
                    <label class="form-check-label fw-medium" style="font-size:14px;" for="selectAllFacilities">
                        All Facilities
                    </label>
                </div>

                <div style="max-height:140px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:8px; padding:10px;">
                    @foreach (var f in (List<Sym_Connect__Capstone2_.ViewModels.Facility.FacilityListViewModel>)ViewBag.Facilities)
                    {
                        var isChecked = Model.SelectedFacilityIds != null && Model.SelectedFacilityIds.Contains(f.FacilityId);
                        <div class="form-check">
                            <input class="form-check-input facility-checkbox" type="checkbox" name="SelectedFacilityIds"
                                   value="@f.FacilityId" id="facility-@f.FacilityId" checked="@isChecked" />
                            <label class="form-check-label" style="font-size:14px;" for="facility-@f.FacilityId">
                                @f.FacilityName
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="SelectedFacilityIds" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Points <span class="text-danger">*</span></label>
                <input asp-for="Points" type="number" min="0" max="100" class="form-control" />
                <span asp-validation-for="Points" class="text-danger" style="font-size:12px;"></span>
                <div class="form-text" style="font-size:12px;">Points a member earns for attending this event.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Expected Groups</label>
                <div style="max-height:140px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:8px; padding:10px;">
                    @foreach (var g in (List<Sym_Connect__Capstone2_.ViewModels.Group.GroupListViewModel>)ViewBag.Groups)
                    {
                        var isChecked = Model.SelectedGroupIds != null && Model.SelectedGroupIds.Contains(g.GroupId);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedGroupIds"
                                   value="@g.GroupId" id="edit-group-@g.GroupId" checked="@isChecked" />
                            <label class="form-check-label" style="font-size:14px;" for="edit-group-@g.GroupId">
                                @g.GroupName
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Event Description</label>
                <textarea asp-for="EventDescription"
                          class="form-control"
                          rows="3"
                          maxlength="500"
                          placeholder="Add a description for this event..."></textarea>

                <span asp-validation-for="EventDescription"
                      class="text-danger"
                      style="font-size:12px;"></span>
            </div>

            <div class="d-flex gap-2 mt-4 pb-3">
                <button type="button" class="btn btn-outline-secondary w-50" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary w-50">
                    <i class="ti ti-device-floppy"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

                      <script>

                          
        const selectAllGroups = document.getElementById("selectAllGroups");
    const groupCheckboxes = document.querySelectorAll(".group-checkbox");

    selectAllGroups.addEventListener("change", function () {
        groupCheckboxes.forEach(cb => cb.checked = selectAllGroups.checked);
    });

    groupCheckboxes.forEach(cb => {
        cb.addEventListener("change", function () {
            selectAllGroups.checked = [...groupCheckboxes].every(c => c.checked);
        });
    });



                            const selectAllFacilities = document.getElementById("selectAllFacilities");
    const facilityCheckboxes = document.querySelectorAll(".facility-checkbox");

    selectAllFacilities.addEventListener("change", function () {
        facilityCheckboxes.forEach(cb => cb.checked = selectAllFacilities.checked);
    });

    facilityCheckboxes.forEach(cb => {
        cb.addEventListener("change", function () {
            selectAllFacilities.checked = [...facilityCheckboxes].every(c => c.checked);
        });
    });



                      </script>