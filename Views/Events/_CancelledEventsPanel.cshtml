@model List<Sym_Connect__Capstone2_.ViewModels.Event.EventListItemViewModel>

<div class="offcanvas offcanvas-end event-panel" tabindex="-1" id="cancelledEventsPanel" style="width: 420px;">

    <div class="offcanvas-header border-bottom pb-2">
        <h5 class="offcanvas-title fw-medium">Cancelled Events</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No cancelled events.</p>
        }

        @foreach (var evt in Model)
        {
            <div class="d-flex gap-3 align-items-start py-3" style="border-bottom:1px solid #e5e7eb;">

                <div class="bg-dark text-white text-center rounded flex-shrink-0" style="width:50px; height:50px;">
                    <div class="fw-bold fs-6 lh-1 pt-1">@evt.StartDate.Day</div>
                    <div class="text-uppercase small">@evt.StartDate.ToString("MMM")</div>
                </div>

                <div class="flex-grow-1">
                    <div class="fw-medium">@evt.EventTitle</div>
                    <div style="font-size:12px; color:#6b7280;">
                        Originally: @evt.StartDate.ToString("MMM d, yyyy")
                    </div>

                    @if (!string.IsNullOrWhiteSpace(evt.CancellationReason))
                    {
                        <div style="font-size:12px; color:#9ca3af;" class="mt-1">
                            Reason: @evt.CancellationReason
                        </div>
                    }
                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-success open-modal align-self-center"
                        data-url="@Url.Action("ConfirmationRestore", "Events", new { eventid = evt.EventId })"
                        data-title="Restore Event">
                    Restore
                </button>
            </div>
        }
    </div>
</div>