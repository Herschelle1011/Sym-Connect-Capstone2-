@model List<ExpectedFacilityCardVM>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:13px;">
        @Model.Count facilit@(Model.Count == 1 ? "y" : "ies")
    </span>
</div>

<div class="row g-3">
    @foreach (var facility in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="facility-card">
                <div class="facility-name">@facility.FacilityName</div>
                <div class="facility-capacity">
                    <i class="ti ti-users"></i>
                    @facility.FacilityCapacity people capacity
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-4">
        <p class="mb-0 text-muted" style="font-size:14px;">No facilities available</p>
    </div>
}

<style>
    .facility-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px 16px;
        height: 100%;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .facility-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        }

    .facility-name {
        font-weight: 500;
        font-size: 14px;
        color: #111827;
        margin-bottom: 6px;
    }

    .facility-capacity {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        color: #6b7280;
    }

        .facility-capacity i {
            font-size: 13px;
            color: #9ca3af;
        }
</style>