@using Sym_Connect__Capstone2_.Helpers
@model Sym_Connect__Capstone2_.ViewModels.MediaAndDocuments.MediaAndDocumentsIndexViewModel
@{
    ViewData["Title"] = "Media & Documents";
    Layout = "_AdminLayout";
}

<div class="media-page">
    <div class="page-header">
        <div>
            <h2>Documents &amp; Media</h2>
            <p class="page-subtitle">Manage and organize SYM files and media</p>
        </div>
    </div>

    <div class="breadcrumb-row">
        <span class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard")">Home</a> / Documents &amp; Media
        </span>

        <div class="media-header-actions">

                @if ((bool)(ViewBag.IsAdmin ?? false))
                {
                               <a href="@Url.Action("PendingFiles", "MediaAndDocuments")"
                           class="pending-files-btn">

                            <span class="pending-files-icon">
                                <i class="bi bi-clock-history"></i>
                            </span>

                            <span class="pending-files-text">
                                Pending Files
                            </span>

                            <span id="pendingFilesCount"
                                  class="pending-files-count @(ViewBag.PendingFilesCount == 0 ? "d-none" : "")">
                                @ViewBag.PendingFilesCount
                            </span>

                        </a>

                    <button type="button"
                            class="btn btn-primary open-modal"
                            data-url="@Url.Action("CreateFolder", "MediaAndDocuments")"
                            data-title="New Folder">
                        <i class="bi bi-plus-lg"></i>
                        New Folder
                    </button>
                }

        </div>
    </div>

    <div class="folder-grid">
        @if (Model.Folders == null || !Model.Folders.Any())
        {
            <p class="text-muted">No folders yet.</p>
        }
        else
        {
            foreach (var folder in Model.Folders)
            {
                <div class="folder-card">
                    <a href="@Url.Action("FolderDetails", new { id = folder.MediaFolderId })"
                       class="folder-card-link">

                        <i class="bi bi-folder-fill folder-icon"></i>

                        <div class="folder-info">
                            <span class="folder-name">@folder.FolderName</span>

                            @if (folder.IsPrivate)
                            {
                                <span class="visibility-badge badge-private">
                                    <i class="bi bi-lock-fill"></i> Private
                                </span>
                            }
                            else
                            {
                                <span class="visibility-badge badge-public">
                                    <i class="bi bi-globe"></i> Public
                                </span>
                            }
                        </div>
                    </a>

                    <span class="folder-count">@folder.FileCount</span>

                    <div class="dropdown folder-kebab-wrapper">
                        <button class="btn-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            ⋮
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item open-modal" href="#"
                                   data-url="@Url.Action("Rename", "MediaAndDocuments", new { id = folder.MediaFolderId })"
                                   data-title="Rename Folder">
                                    Rename
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item open-modal" href="#"
                                   data-url="@Url.Action("ChangeVisibility", "MediaAndDocuments", new { folderId = folder.MediaFolderId })"
                                   data-title="Change Folder Visibility">
                                    Visibility
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger open-modal" href="#"
                                   data-folder-id="@folder.MediaFolderId"
                                   data-url="@Url.Action("GetArchive", "MediaAndDocuments", new { id = folder.MediaFolderId })"
                                    data-title="Archive Folder">
                                    Archive
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        }
    </div>

    <div class="recent-files-section">
        <h4>Recent Files</h4>

        @if (Model.RecentFiles == null || !Model.RecentFiles.Any())
        {
            <p class="text-muted">No files uploaded yet.</p>
        }
        else
        {
            <div class="table-responsive recent-files-table-wrapper">
                <table class="table recent-files-table">
                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Type</th>
                            <th>Folder</th>
                            <th>Uploaded by</th>
                            <th>Date</th>
                            <th class="actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in Model.RecentFiles)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Download", "MediaAndDocuments", new { id = file.MediaFileId })"
                                       class="file-name-link">
                                        @file.FileName
                                    </a>
                                </td>
                                <td>@file.FileExtension</td>
                                <td>@file.folderName</td>
                                <td>@file.fullName</td>
                                <td>@file.UploadedDate.ToString("MMM. d, yyyy")</td>
                                <td class="actions-col">
                                    <div class="dropdown">
                                        <button class="btn-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            ⋮
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="@Url.Action("Download", "MediaAndDocuments", new { id = file.MediaFileId })">Download</a></li>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/Media.js"></script>
}