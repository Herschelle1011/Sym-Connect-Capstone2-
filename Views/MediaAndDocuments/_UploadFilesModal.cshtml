@model Sym_Connect__Capstone2_.ViewModels.MediaAndDocuments.MediaFileUploadViewModel

<form id="uploadFilesForm"
      class="modal-ajax-form"
      asp-controller="MediaAndDocuments"
      asp-action="Upload"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden"
           name="MediaFolderId"
           value="@Model.MediaFolderId" />

    <div class="form-group">

        <label>Select Files</label>

        <input type="file"
               name="Files"
               multiple
               class="form-control"
               accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" />

        <small class="hint-text">
            Images, PDF, Word, Excel, or PowerPoint. Max 10MB per file.
        </small>

        <span class="field-error"
              id="uploadFilesError">
        </span>

    </div>

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary"
                id="uploadFilesBtn">

            <i class="bi bi-upload me-1"></i>
            Upload

        </button>

    </div>

</form>

<script>
    document.getElementById("uploadFilesForm").addEventListener("submit", function () {

        const button = document.getElementById("uploadFilesBtn");

        // Disable button
        button.disabled = true;

        // Change the content INSIDE the button
        button.innerHTML = `
            <span class="spinner-border spinner-border-sm me-2"
                  role="status"
                  aria-hidden="true">
            </span>
            Uploading...
        `;
    });
</script>