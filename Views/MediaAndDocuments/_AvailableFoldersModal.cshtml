@model MediaFolderViewModel

<div class="move-folder-body">
    @Html.AntiForgeryToken()
    <div class="folder-search-wrap">
        <i class="bi bi-search"></i>
        <input type="text" id="folderSearchInput" class="form-control folder-search-input" placeholder="Search folders..." />
    </div>

    <div class="folder-list" id="folderList">
        @if (Model == null)
        {
            <p class="text-muted text-center py-4 mb-0">No folders available.</p>
        }
        else
        {
            for (int i = 0; i < Model.Folders.Count; i++)
            {
                var folder = Model.Folders[i];
                <label class="folder-row @(i == 0 ? "folder-row-selected" : "")" for="folder_@folder.MediaFolderId">
                    <span class="folder-icon @(i == 0 ? "folder-icon-active" : "")">
                        <i class="bi bi-folder-fill"></i>
                    </span>
                    <span class="folder-info">
                        <span class="folder-name-row">
                            <span class="folder-name">@folder.FolderName</span>
                            @if (folder.IsPrivate)
                            {
                                <span class="badge-private"><i class="bi bi-lock-fill"></i> Private</span>
                            }
                        </span>
                        <span class="folder-meta">Created by @folder.createByMemberName &bull; @folder.FileCount files</span>
                    </span>
                    <input type="radio" name="destinationFolder" id="folder_@folder.MediaFolderId" value="@folder.MediaFolderId" class="folder-radio" checked="@(i == 0)" />
           
                </label>
            }
        }
    </div>

    <div class="move-folder-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary move-here-btn" id="moveFileConfirmBtn" data-file-id="@ViewBag.FileId">
            <i class="bi bi-folder-symlink"></i> Move Here
        </button>
    </div>
</div>