@model Sym_Connect__Capstone2_.ViewModels.MediaAndDocuments.FileInformationViewModel

<div style="padding: 0 0.5rem 0.5rem;">

    <div style="display:flex; justify-content:center; margin-bottom: 1.25rem;">
        <div style="width:56px; height:56px; border-radius:50%;
            background:rgba(220,38,38,.12); border:1px solid rgba(220,38,38,.3);
            display:flex; align-items:center; justify-content:center;">
            <i class="bi bi-trash" style="font-size:1.4rem; color:#b91c1c;"></i>
        </div>
    </div>

    <h5 style="text-align:center; font-size:15px; font-weight:700;
        color:#111827; margin:0 0 6px;">
        Delete this file?
    </h5>
    <p style="text-align:center; font-size:13px; color:#6b7280;
        line-height:1.6; margin:0 0 1.25rem;">
        This action cannot be undone. The file will be permanently removed from storage.
    </p>

    <div style="background:#fef2f2; border:1px solid #fecaca;
        border-radius:10px; padding:14px 16px; margin-bottom:1.5rem;">
        <div style="display:flex; flex-direction:column; gap:8px;">

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-file-earmark" style="margin-right:4px;"></i>File Name
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.FileName
                </span>
            </div>

            <div style="height:1px; background:#fee2e2;"></div>

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-hdd" style="margin-right:4px;"></i>Size
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.Size
                </span>
            </div>

            <div style="height:1px; background:#fee2e2;"></div>

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-person" style="margin-right:4px;"></i>Uploaded By
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.UploadedBy
                </span>
            </div>

        </div>
    </div>

    <form id="deleteFileForm"
          class="modal-ajax-form"
          action="@Url.Action("DeleteFile", "MediaAndDocuments")"
          method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="mediaFileId" value="@Model.FileId" />

        <div style="display:flex; gap:10px;">
            <button type="button"
                    class="btn w-50"
                    data-bs-dismiss="modal"
                    style="font-size:13px;
                font-weight:500;
                border:1px solid #e5e7eb;
                border-radius:8px;
                padding:9px;
                background:#fff;
                color:#374151;">
                Cancel
            </button>

            <button type="submit" class="btn w-50"
                    style="font-size:13px; font-weight:600;
                border-radius:8px; padding:9px;
                background:#b91c1c; color:#fff; border:none;
                transition:background .15s;">
                <i class="bi bi-trash" style="margin-right:5px;"></i>Delete
            </button>
        </div>
    </form>

</div>