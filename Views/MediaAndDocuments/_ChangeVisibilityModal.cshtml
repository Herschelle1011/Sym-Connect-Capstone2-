@model Sym_Connect__Capstone2_.ViewModels.MediaAndDocuments.ChangeVisibilityViewModel

<form class="modal-ajax-form"
      asp-controller="MediaAndDocuments"
      asp-action="ChangeVisibility"
      method="post">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MediaFolderId" name="folderId" />

    <p>Change visibility for <strong>@Model.FolderName</strong>:</p>

    <div class="form-check">
        <input class="form-check-input" type="radio"
               name="isPrivate" id="visPublic" value="false"
               checked="@(!Model.IsPrivate)" />
        <label class="form-check-label" for="visPublic">
            Public — everyone can view
        </label>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="radio"
               name="isPrivate" id="visPrivate" value="true"
               checked="@Model.IsPrivate" />
        <label class="form-check-label" for="visPrivate">
            Private — only the owner and Admin can view
        </label>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </div>

</form>