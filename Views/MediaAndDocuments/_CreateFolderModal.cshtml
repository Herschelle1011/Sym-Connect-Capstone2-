@model Sym_Connect__Capstone2_.ViewModels.MediaAndDocuments.MediaFolderCreateViewModel

<form id="createFolderForm" class="modal-ajax-form" asp-controller="MediaAndDocuments" asp-action="CreateFolder" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="FolderName">Folder Name <span class="required">*</span></label>
        <input asp-for="FolderName" class="form-control" placeholder="e.g. Youth Camp 2026" />
        <span asp-validation-for="FolderName" class="field-error"></span>
    </div>

    <div class="form-group">
        <label class="checkbox-option">
            <input type="checkbox" asp-for="IsPrivate" />
            <span>Private (only visible to you and Admins)</span>
        </label>
    </div>


    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Folder</button>
    </div>
</form>
