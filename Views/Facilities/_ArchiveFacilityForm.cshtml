@model ArchiveFacilityViewModel

<div style="padding: 0 0.5rem 0.5rem;">

    <!-- Warning icon -->
    <div style="display:flex; justify-content:center; margin-bottom: 1.25rem;">
        <div style="width:56px; height:56px; border-radius:50%;
            background:rgba(234,179,8,.12); border:1px solid rgba(234,179,8,.3);
            display:flex; align-items:center; justify-content:center;">
            <i class="bi bi-archive"
               style="font-size:1.4rem; color:#b45309;"></i>
        </div>
    </div>

    <!-- Headline -->
    <h5 style="text-align:center; font-size:15px; font-weight:700;
        color:#111827; margin:0 0 6px;">
        Archive this facility?
    </h5>
    <p style="text-align:center; font-size:13px; color:#6b7280;
        line-height:1.6; margin:0 0 1.25rem;">
        This facility will be hidden from the list. You can restore it later from the archive.
    </p>

    <!-- Facility info card -->
    <div style="background:#f9fafb; border:1px solid #e5e7eb;
        border-radius:10px; padding:14px 16px; margin-bottom:1.5rem;">
        <div style="display:flex; flex-direction:column; gap:8px;">

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-building" style="margin-right:4px;"></i>Facility
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.FacilityName
                </span>
            </div>

            <div style="height:1px; background:#f0f0f0;"></div>

            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                    letter-spacing:.05em; color:#9ca3af;">
                    <i class="bi bi-people" style="margin-right:4px;"></i>Capacity
                </span>
                <span style="font-size:13px; font-weight:600; color:#111827;">
                    @Model.Capacity persons
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div style="height:1px; background:#f0f0f0;"></div>
                <div style="display:flex; flex-direction:column; gap:3px;">
                    <span style="font-size:11px; font-weight:600; text-transform:uppercase;
                        letter-spacing:.05em; color:#9ca3af;">
                        <i class="bi bi-card-text" style="margin-right:4px;"></i>Description
                    </span>
                    <span style="font-size:13px; color:#374151; line-height:1.5;">
                        @Model.Description
                    </span>
                </div>
            }

        </div>
    </div>

    <!-- Form -->
    <form asp-controller="Facilities"
          asp-action="Archived"
          asp-route-id="@Model.facilityId"
          method="post"
          class="archive-facility-form">

        @Html.AntiForgeryToken()

        <div style="display:flex; gap:10px;">

            <button type="button"
                    class="btn w-50"
                    data-bs-dismiss="modal"
                    style="font-size:13px; font-weight:500;
                border:1px solid #e5e7eb; border-radius:8px;
                padding:9px; background:#fff; color:#374151;">
                Cancel
            </button>

            <button type="submit"
                    class="btn w-50 archive-submit-btn"
                    style="font-size:13px; font-weight:600;
                border-radius:8px; padding:9px;
                background:#b45309; color:#fff; border:none;">

                <span class="archive-btn-content">
                    <i class="bi bi-archive" style="margin-right:5px;"></i>
                    Archive
                </span>

                <span class="archive-btn-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    Archiving...
                </span>
            </button>

        </div>
    </form>
</div>
