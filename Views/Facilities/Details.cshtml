@model FacilityDetailsViewModel

@{
    ViewData["Title"] = "Facility Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var types = Model.FacilityType.ToList();
    var photoUrls = Model.Photos?.Select(p => p.PhotoUrl).ToList() ?? new List<string>();
   
}

<div class="facility-page">

    <!-- Header -->
    <div class="facility-header d-flex align-items-center gap-3">
        <a asp-action="Index"
           class="page-back-btn" title="Back to Facilities" aria-label="Back to Facilities">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="mb-0">Facility Details</h1>
    </div>

    <!-- Detail wrapper -->
    <div class="fd-wrapper">

        <!-- LEFT: Photo carousel -->
        <div class="fd-photo-col">
            @if (photoUrls.Count > 0)
            {
                <div class="fd-carousel" id="fdCarousel"
                     data-photos="@string.Join("|", photoUrls)">

                    <img id="fdMainImg"
                         class="fd-main-img"
                         src="@photoUrls[0]"
                         alt="@Model.FacilityName" />

                    @if (photoUrls.Count > 1)
                    {
                        <div class="fd-dots">
                            @for (int i = 0; i < Math.Min(photoUrls.Count, 6); i++)
                            {
                                <span class="fd-dot @(i == 0 ? "active" : "")"
                                      data-index="@i"
                                      onclick="fdGoTo(this)"></span>
                            }
                        </div>

                        <div class="fd-thumbs">
                            @for (int i = 0; i < Math.Min(photoUrls.Count, 5); i++)
                            {
                                <img class="fd-thumb @(i == 0 ? "active" : "")"
                                     src="@photoUrls[i]"
                                     data-index="@i"
                                     alt="Photo @(i + 1)"
                                     onclick="fdGoToIndex(@i)" />
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="fd-no-photo">
                    <i class="bi bi-image" style="font-size:2.5rem;"></i>
                    <span>No photos available</span>
                </div>
            }
        </div>

        <!-- RIGHT: Info panel -->
        <div class="fd-info-col">

            <div class="fd-title-row">
                <h2 class="fd-name">@Model.FacilityName</h2>
                <span class="fd-status-pill @Model.StatusClass">
                    <span class="fd-status-dot"></span>
                    @Model.StatusLabel
                </span>
            </div>

            <div class="fd-capacity-row">
                <span class="fd-capacity-badge">
                    <i class="bi bi-people-fill"></i> @Model.Capacity cap
                </span>
            </div>

            <p class="fd-desc">@Model.FacilityDescription</p>

            <div class="fd-divider"></div>

            @if (types.Count > 0)
            {
                <div class="fd-section-label">Facility types</div>
                <div class="tags fd-tags">
                    @foreach (var type in types)
                    {
                        var icon = type.Trim() switch
                        {
                            "Basketball" => "🏀",
                            "OpenCourt" => "🏟️",
                            "Study" => "📚",
                            "MeetingRoom" => "🤝",
                            "EventHall" => "🎪",
                            "YouthActivities" => "⚡",
                            "Conference" => "💼",
                            "Library" => "📖",
                            "Music" => "🎵",
                            "PracticeRoom" => "🎤",
                            "ComputerLab" => "💻",
                            "Training" => "🧑‍💻",
                            "Chapel" => "🙏",
                            "Worship" => "✝️",
                            "Outdoor" => "🌿",
                            "EventSpace" => "🎉",
                            _ => "🏷️"
                        };
                        <span class="tag">@icon @type</span>
                    }
                </div>
            }

            <div class="fd-divider"></div>

            <div class="fd-meta-grid">
                <div class="fd-meta-item">
                    <span class="fd-meta-label"><i class="bi bi-people"></i> Capacity</span>
                    <span class="fd-meta-value">@Model.Capacity persons</span>
                </div>
                <div class="fd-meta-item">
                    <span class="fd-meta-label">Status</span>
                    <span class="fd-meta-value">@Model.StatusLabel</span>
                </div>
            </div>

            <div class="fd-actions">
                <a href="#"
                   class="fd-btn-edit edit-btn"
                   data-id="@Model.FacilityId">
                    <i class="bi bi-pencil-square"></i> Edit facility
                </a>

                @* Was a plain <a asp-action="Archived">, which just navigates the whole
                   page — no listener was catching the click to open a modal instead.
                   Now matches the same href="#" + data-id + JS-intercept pattern as Edit. *@
                <a href="#"
                   class="fd-btn-archive archive-btn"
                   data-id="@Model.FacilityId">
                    <i class="bi bi-archive"></i> Archive
                </a>
            </div>

        </div> <!-- closes fd-info-col -->
    </div> <!-- closes fd-wrapper -->
    <!-- Schedule -->
    <div class="fd-schedule-card">
        <div class="fd-schedule-header">
            <i class="bi bi-calendar3"></i> Schedule
        </div>

        <div class="fd-schedule-subheader">
            <span class="label">Upcoming Reservations</span>
            <a asp-controller="Events" asp-action="Index">
                View All <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        @if (!Model.UpcomingReservations.Any())
        {
            <p class="fd-schedule-empty">No events currently scheduled here.</p>
        }
        else
        {
            <table class="fd-schedule-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Event / Activity</th>
                        <th>Groups</th>
                        <th>Status</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model.UpcomingReservations)
                    {
                        <tr>
                            <td class="sched-date">@res.Date.ToString("MMM d, yyyy (ddd)")</td>
                            <td>@res.EventTitle</td>
                            <td>@(res.GroupName.Any() ? string.Join(", ", res.GroupName) : "N/A")</td>
                            <td>
                                <span class="sched-status-badge">@res.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div> <!-- closes fd-schedule-card -->

</div> <!-- closes facility-page -->
<!-- Edit Facility Modal -->
<div class="modal fade" id="editFacilityModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Edit Facility</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                @await Html.PartialAsync(
                    "~/Views/Facilities/_EditFacilityForm.cshtml",
                    new EditFacilityViewModel()
                )
            </div>
        </div>
    </div>
</div>

<!-- Archive Facility Modal -->
<div class="modal fade" id="archiveFacilityModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Archive Facility</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <!-- Filled in by JS: fetch('/Facilities/Archived/{id}') -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/admin/facilityPhotos.js" asp-append-version="true"></script>
    <script src="~/js/admin/ErrorModalHandler.js" asp-append-version="true"></script>

    <script>
        function fdGoTo(dot) {
        var carousel = document.getElementById('fdCarousel');
        var photos = carousel.getAttribute('data-photos').split('|');
        var idx = parseInt(dot.getAttribute('data-index'));
        fdSetIndex(idx, photos);
        }

        function fdGoToIndex(idx) {
        var carousel = document.getElementById('fdCarousel');
        var photos = carousel.getAttribute('data-photos').split('|');
        fdSetIndex(idx, photos);
        }

        function fdSetIndex(idx, photos) {
        document.getElementById('fdMainImg').src = photos[idx];
        document.querySelectorAll('.fd-dot').forEach(function(d) {
        d.classList.toggle('active', parseInt(d.getAttribute('data-index')) === idx);
        });
        document.querySelectorAll('.fd-thumb').forEach(function(t) {
        t.classList.toggle('active', parseInt(t.getAttribute('data-index')) === idx);
        });
        }

        document.querySelectorAll('.edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
        e.preventDefault();
        var facilityId = this.getAttribute('data-id');
        fetch('/Facilities/Edit/' + facilityId)
        .then(r => r.text())
        .then(html => {
        document.querySelector('#editFacilityModal .modal-body').innerHTML = html;
        if (typeof initEditPhotoUpload === 'function') initEditPhotoUpload();
        new bootstrap.Modal(document.getElementById('editFacilityModal')).show();
        });
        });
        });

        // Same intercept-and-fetch pattern as Edit, just pointed at the
        // Archived action and the archive modal instead.
        document.querySelectorAll('.archive-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
        e.preventDefault();
        var facilityId = this.getAttribute('data-id');
        fetch('/Facilities/Archived/' + facilityId)
        .then(r => r.text())
        .then(html => {
        document.querySelector('#archiveFacilityModal .modal-body').innerHTML = html;
        new bootstrap.Modal(document.getElementById('archiveFacilityModal')).show();
        });
        });
        });
    </script>
}
