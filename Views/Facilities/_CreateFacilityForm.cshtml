@model FacilityViewModel.CreateFacilityViewModel
@{

}

<form id="createFacilityForm"
      asp-action="Create"
      asp-controller="Facilities"
      method="post"
      enctype="multipart/form-data"
      data-modal-body="#createModalBody">

    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <!-- Facility Name -->
    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="FacilityName"
                   class="form-control"
                   placeholder="Facility Name" />
            <label asp-for="FacilityName">Facility Name</label>
            <span asp-validation-for="FacilityName" class="text-danger small"></span>
        </div>
    </div>

    <!-- Description -->
    <div class="mb-3">
        <div class="form-floating">
            <textarea asp-for="FacilityDescription"
                      class="form-control"
                      placeholder="Description"
                      style="height: 100px;"></textarea>
            <label asp-for="FacilityDescription">Description</label>
            <span asp-validation-for="FacilityDescription" class="text-danger small"></span>
        </div>
    </div>

    <!-- Capacity + Status -->
    <div class="row mb-3">
        <div class="col-6">
            <div class="form-floating">
                <input asp-for="Capacity"
                       class="form-control"
                       placeholder="Capacity"
                       type="number" />
                <label asp-for="Capacity">Capacity</label>
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
        </div>
        <div class="col-6">
            <div class="form-floating">
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="UnderMaintenance">Under Maintenance</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <label asp-for="Status">Status</label>
            </div>
        </div>
    </div>

    <!-- Facility Types -->
    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="FacilityTypes"
                   class="form-control"
                   placeholder="e.g. Gym,Basketball" />
            <label asp-for="FacilityTypes">Facility Types (comma-separated)</label>
            <span asp-validation-for="FacilityTypes" class="text-danger small"></span>
        </div>
    </div>


    <!-- Photos -->
    <div class="mb-3">
        <label class="form-label text-muted small fw-semibold">
            Upload Photos <span class="text-muted">(max 5)</span>
        </label>

        <!-- Click to upload area -->
        <div id="photoDropArea" style="
            border: 2px dashed #d1d5db;
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            color: #9ca3af;
            font-size: 0.85rem;
            margin-bottom: 0.75rem;
            transition: border-color 0.2s;">
            📁 Click to select photos
        </div>

        <!-- Hidden actual file input -->
        <input type="file"
               id="facilityPhotos"
               name="Photos"
               multiple
               accept="image/*"
               style="display:none;" />

        <!-- Error and count messages -->
        <div id="photoError" class="text-danger small mt-1" style="display:none;"></div>
        <div id="photoCount" class="text-muted small mt-1"></div>

        <!-- Preview thumbnails appear here -->
        <div id="photoPreviewArea" style="
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin-top: 0.75rem;">
        </div>
    </div>

    <!-- Footer -->
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button"
                class="btn btn-light px-4"
                data-bs-dismiss="modal">
            Cancel
        </button>
        <button type="submit" class="btn btn-primary px-4">
            Create
        </button>
    </div>

</form>

