@model EditFacilityViewModel

<form id="editFacilityForm"
      class="modal-ajax-form"
      asp-action="Edit"
      asp-controller="Facilities"
      method="post"
      enctype="multipart/form-data"
      data-modal-body="#editModalBody">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="FacilityId" />

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    @* {{!-- Facility Name --}} *@
    <div class="mb-3">
        <div class="form-floating">
            <input asp-for="FacilityName" class="form-control" placeholder="Facility Name" />
            <label asp-for="FacilityName">Facility Name</label>
            <span asp-validation-for="FacilityName" class="text-danger small"></span>
        </div>
    </div>

    @* {{!-- Description --}} *@
    <div class="mb-3">
        <div class="form-floating">
            <textarea asp-for="FacilityDescription"
                      class="form-control"
                      placeholder="Description"
                      style="height: 100px;"></textarea>
            <label asp-for="FacilityDescription">Description</label>
            <span asp-validation-for="FacilityDescription" class="text-danger small"></span>
        </div>
    </div>

    @* {{!-- Capacity + Status --}} *@
    <div class="row mb-3">
        <div class="col-6">
            <div class="form-floating">
                <input asp-for="Capacity" class="form-control" placeholder="Capacity" type="number" />
                <label asp-for="Capacity">Capacity</label>
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
        </div>
        <div class="col-6">
            <div class="form-floating">
                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<Sym_Connect__Capstone2_.Models.Enums.FacilityStatus>()"
                        class="form-select">
                </select>
                <label asp-for="Status">Status</label>
            </div>
        </div>
    </div>

    @* {{!-- Facility Types --}} *@
    <div class="mb-3">
        <div class="form-floating">
            <input name="FacilityTypes"
                   class="form-control"
                   value="@(Model.FacilityTypes != null ? string.Join(", ", Model.FacilityTypes) : "")"
                   placeholder="e.g. Gym,Basketball" />
            <label>Facility Types (comma-separated)</label>
            <span asp-validation-for="FacilityTypes" class="text-danger small"></span>
        </div>
    </div>

    @* {{!-- EXISTING PHOTOS WITH X BUTTON --}} *@
    @if (Model.ExistingPhotos != null && Model.ExistingPhotos.Count > 0)
    {
        <div class="mb-3">
            <label class="form-label text-muted small fw-semibold">Current Photos</label>
            <div id="existingPhotoArea" style="display:flex; flex-wrap:wrap; gap:0.6rem;">
                @foreach (var photo in Model.ExistingPhotos)
                {
                    <div class="existing-photo-item" id="photo-@photo.PhotoId" style="position:relative;">
                        <img src="@photo.PhotoUrl"
                             style="width:80px; height:80px; object-fit:cover; border-radius:8px;" />

                        @* {{!-- X button: marks this photo for deletion --}} *@
                        <button type="button"
                                onclick="removeExistingPhoto(@photo.PhotoId)"
                                style="position:absolute; top:-6px; right:-6px;
                            background:red; color:white; border:none;
                            border-radius:50%; width:20px; height:20px;
                            font-size:12px; cursor:pointer; line-height:1;">
                            &times;
                        </button>

                        @* {{!-- Hidden input — tells the server to DELETE this photo on save --}} *@
                        <input type="hidden"
                               name="RemovedPhotoIds"
                               id="remove-@photo.PhotoId"
                               value="@photo.PhotoId"
                               disabled />
                    </div>
                }
            </div>
        </div>
    }

    @* {{!-- NEW PHOTO UPLOAD --}} *@
    <div class="mb-3">
        <label class="form-label text-muted small fw-semibold">
            Add New Photos <span class="text-muted">(max 5)</span>
        </label>

        <div id="editPhotoDropArea" style="
            border: 2px dashed #d1d5db;
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            color: #9ca3af;
            font-size: 0.85rem;
            margin-bottom: 0.75rem;">
            📁 Click to select photos
        </div>

        <input type="file"
               id="editFacilityPhotos"
               name="Photos"
               multiple
               accept="image/*"
               style="display:none;" />

        <div id="editPhotoError" class="text-danger small mt-1" style="display:none;"></div>
        <div id="editPhotoCount" class="text-muted small mt-1"></div>
        <div id="editPhotoPreviewArea" style="display:flex; flex-wrap:wrap; gap:0.6rem; margin-top:0.75rem;"></div>
    </div>

    @* {{!-- Footer --}} *@
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-savechanges">Save Changes</button>
    </div>

</form>
