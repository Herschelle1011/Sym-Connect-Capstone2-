@model GetPartyListPositionViewModel
@{
    ViewData["Title"] = "Details";
    Layout = "_AdminLayout";

    var palette = new[]
    {
        ("#dcfce7", "#166534"),
        ("#dbeafe", "#1e40af"),
        ("#fce7f3", "#9d174d"),
        ("#ede9fe", "#5b21b6"),
        ("#fef3c7", "#92400e"),
        ("#e0f2fe", "#0369a1"),
        ("#fee2e2", "#991b1b"),
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .partylist-details-page, .partylist-details-page * {
        font-family: 'Poppins', sans-serif;
    }

    .partylist-details-page {
        padding: 1.5rem 0;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: #7b8397;
        text-decoration: none;
        font-size: 17px;
        transition: background .15s, color .15s;
        flex-shrink: 0;
    }

        .back-link:hover {
            background: #f1f2f6;
            color: #0d6efd;
        }

    .page-heading {
        font-size: 22px;
        font-weight: 700;
        color: #1a1f2b;
        margin: 0;
    }

    .page-subtext {
        font-size: 13px;
        color: #9aa3b8;
        margin-left: 46px;
    }

    .positions-card {
        background: #fff;
        border: 1px solid #eef0f5;
        border-radius: 18px;
        padding: 28px;
    }

    .positions-card-title {
        text-align: center;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: .06em;
        color: #7b8397;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    /* ── Position group (new) ── */
    .position-group {
        border: 1px solid #eef0f5;
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 16px;
        background: #fcfcfe;
        transition: background .15s, border-color .15s;
    }

        .position-group:last-child {
            margin-bottom: 0;
        }

        .position-group:not(.locked) {
            border-color: #bcd6ff;
            background: #f5f9ff;
        }

    .position-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .position-group-title {
        font-size: 13px;
        font-weight: 700;
        color: #1a1f2b;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .btn-edit-group {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #eef4ff;
        color: #0d6efd;
        border: none;
        font-size: 12px;
        font-weight: 600;
        border-radius: 999px;
        padding: 5px 12px;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-edit-group:hover {
            background: #dce9ff;
        }

    /* Buttons inside a locked group become inert */
    .position-group.locked .btn-choose,
    .position-group.locked .btn-change-icon {
        opacity: .35;
        pointer-events: none;
        cursor: not-allowed;
    }

    .position-slot {
        border: 1px solid #eef0f5;
        border-radius: 12px;
        padding: 12px 16px;
        background: #fbfbfd;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: border-color .15s, background .15s;
        height: 100%;
    }

        .position-slot:hover {
            border-color: #dfe3ec;
            background: #f8f9fc;
        }

        .position-slot.filled {
            background: #fff;
        }

    .position-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .position-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a1f2b;
        margin-bottom: 1px;
    }

    .position-candidate-name {
        font-size: 12px;
        color: #9aa3b8;
    }

    .btn-choose {
        background: #0d6efd;
        color: #fff;
        border: none;
        font-size: 12px;
        font-weight: 600;
        border-radius: 999px;
        padding: 6px 14px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .btn-choose:hover {
            background: #0b5ed7;
            color: #fff;
        }

    .btn-change-icon {
        color: #0d6efd;
        font-size: 17px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
        cursor: pointer;
    }

        .btn-change-icon:hover {
            background: #eef4ff;
        }

    .btn-save-positions {
        background: #0d6efd;
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 14px;
        border-radius: 999px;
        padding: 11px 26px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background .15s;
    }

        .btn-save-positions:hover {
            background: #0b5ed7;
        }

        .btn-save-positions:disabled {
            opacity: .6;
        }

    .back-to-list-link {
        font-size: 13px;
        color: #7b8397;
        text-decoration: none;
        font-weight: 500;
    }

        .back-to-list-link:hover {
            color: #0d6efd;
        }

    /* ── Modal ── */
    .cc-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(15, 23, 42, .5);
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
    }

    .cc-modal-box {
        background: #fff;
        border-radius: 18px;
        padding: 24px;
        width: 100%;
        max-width: 460px;
        margin: auto;
        box-shadow: 0 12px 40px rgba(15, 23, 42, .18);
    }

    .cc-modal-title {
        margin: 0;
        font-weight: 700;
        font-size: 16px;
        color: #1a1f2b;
    }

    .cc-modal-close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: #9aa3b8;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        transition: background .15s;
    }

        .cc-modal-close:hover {
            background: #f1f2f6;
        }

    .cc-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #e3e6ee;
        border-radius: 10px;
        padding: 9px 14px;
        margin-bottom: 12px;
        transition: border-color .15s;
    }

        .cc-search-box:focus-within {
            border-color: #0d6efd;
        }

        .cc-search-box i {
            color: #9aa3b8;
        }

        .cc-search-box input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14px;
        }

    .cc-results-box {
        border: 1px solid #eef0f5;
        border-radius: 10px;
        overflow: hidden;
        max-height: 260px;
        overflow-y: auto;
    }

    .cc-results-placeholder {
        padding: 18px;
        text-align: center;
        color: #9aa3b8;
        font-size: 13px;
    }

    .search-result-item {
        padding: 9px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f5f6fa;
        transition: background .12s;
    }

        .search-result-item:last-child {
            border-bottom: none;
        }

        .search-result-item:hover {
            background: #f3f7fc;
        }

    /* ── Toast ── */
    .cc-toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .cc-toast {
        min-width: 280px;
        max-width: 360px;
        background: #fff;
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .16);
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        color: #1a1f2b;
        border-left: 4px solid #0d6efd;
        animation: cc-toast-in .25s ease-out;
    }

        .cc-toast.success {
            border-left-color: #16a34a;
        }

        .cc-toast.error {
            border-left-color: #dc2626;
        }

        .cc-toast.warning {
            border-left-color: #d97706;
        }

        .cc-toast i {
            font-size: 16px;
            margin-top: 1px;
            flex-shrink: 0;
        }

        .cc-toast.success i {
            color: #16a34a;
        }

        .cc-toast.error i {
            color: #dc2626;
        }

        .cc-toast.warning i {
            color: #d97706;
        }

    .cc-toast-close {
        margin-left: auto;
        background: none;
        border: none;
        color: #9aa3b8;
        cursor: pointer;
        font-size: 13px;
        flex-shrink: 0;
    }

    .cc-toast.cc-toast-out {
        animation: cc-toast-out .2s ease-in forwards;
    }

    @@keyframes cc-toast-in {
        from {
            transform: translateX(30px);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes cc-toast-out {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(30px);
            opacity: 0;
        }
    }
</style>

<div id="ccToastContainer" class="cc-toast-container"></div>

<div class="partylist-details-page">

    <div style="display:none">
        @Html.AntiForgeryToken()
    </div>

    <div class="d-flex align-items-center gap-3 mb-1">
        <a asp-action="Index" class="back-link" title="Back to Party Lists">
            <i class="ti ti-arrow-left"></i>
        </a>
        <h1 class="page-heading">@Model.PartyListName</h1>
    </div>

    <div class="positions-card">
        <div class="positions-card-title">Positions Available</div>

        <div id="positionsGrid">
            @{
                var i = 0;
            }
            @foreach (var position in Model.Positions.OrderBy(p => p.DisplayOrder))
            {
                var (bg, fg) = palette[i % palette.Length];
                i++;

                var hasSlots = position.Slots != null && position.Slots.Any();
                var filledCount = hasSlots ? position.Slots.Count(s => !s.IsEmpty) : 0;
                var isLocked = filledCount > 0;

                <div class="position-group @(isLocked ? "locked" : "")" data-position-id="@position.positionId">
                    <div class="position-group-header">
                        <span class="position-group-title">@position.positionName</span>

                        @if (isLocked)
                        {
                            <button type="button" class="btn-edit-group"
                                    onclick="toggleGroupEdit(@position.positionId, this)">
                                <i class="ti ti-lock"></i>
                                <span class="edit-label">Edit</span>
                            </button>
                        }
                    </div>

                    <div class="row g-3">
                        @if (hasSlots)
                        {
                            @foreach (var slot in position.Slots)
                            {
                                var hasCandidate = !slot.IsEmpty;
                                var slotDomId = hasCandidate
                                    ? $"slot-{slot.Candidate.CandidateId}"
                                    : $"slot-new-{position.positionId}-{position.Slots.IndexOf(slot)}";

                                <div class="col-md-6">
                                    <div class="position-slot @(hasCandidate ? "filled" : "")"
                                         id="@slotDomId"
                                         data-position-id="@position.positionId"
                                         data-position-name="@position.positionName"
                                         data-candidate-id="@(hasCandidate ? slot.Candidate.CandidateId.ToString() : "")">

                                        <div class="d-flex align-items-center gap-2">
                                            <div class="position-avatar" style="background:@bg; color:@fg;">
                                                @if (hasCandidate && !string.IsNullOrEmpty(slot.Candidate.PhotoUrl))
                                                {
                                                    <img src="@slot.Candidate.PhotoUrl" alt="@slot.Candidate.FullName"
                                                         style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <i class="ti ti-user-plus" style="font-size:16px;"></i>
                                                }
                                            </div>
                                            <div>
                                                <p class="position-name mb-0">@position.positionName</p>
                                                <p class="position-candidate-name text-muted mb-0">
                                                    @(hasCandidate ? slot.Candidate.FullName : "choose a candidate")
                                                </p>
                                            </div>
                                        </div>

                                        @if (hasCandidate)
                                        {
                                            <span class="btn-change-icon"
                                                  onclick="openChooseCandidateModal(@position.positionId, '@position.positionName', this.closest('.position-slot'))"
                                                  title="Change candidate">
                                                <i class="ti ti-edit"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="btn-choose"
                                                    onclick="openChooseCandidateModal(@position.positionId, '@position.positionName', this.closest('.position-slot'))">
                                                <i class="ti ti-circle-plus"></i> Choose
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-md-6">
                                <div class="position-slot"
                                     id="slot-new-@(position.positionId)-0"
                                     data-position-id="@position.positionId"
                                     data-position-name="@position.positionName"
                                     data-candidate-id="">

                                    <div class="d-flex align-items-center gap-2">
                                        <div class="position-avatar" style="background:@bg; color:@fg;">
                                            <i class="ti ti-user-plus" style="font-size:16px;"></i>
                                        </div>
                                        <div>
                                            <p class="position-name mb-0">@position.positionName</p>
                                            <p class="position-candidate-name text-muted mb-0">choose a candidate</p>
                                        </div>
                                    </div>

                                    <button class="btn-choose"
                                            onclick="openChooseCandidateModal(@position.positionId, '@position.positionName', this.closest('.position-slot'))">
                                        <i class="ti ti-circle-plus"></i> Choose
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button id="savePositionsBtn" class="btn-save-positions" onclick="savePositions(@Model.partyListId)">
                <i class="ti ti-device-floppy"></i> Click to Save
            </button>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="back-to-list-link">&larr; Back to List</a>
    </div>
</div>

@* ===== CHOOSE CANDIDATE MODAL — unchanged HTML ===== *@
<div id="chooseCandidateModal" class="cc-modal-overlay">
    <div class="cc-modal-box">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="cc-modal-title">
                Choose candidate for <span id="modalPositionLabel"></span>
            </h5>
            <button onclick="closeChooseCandidateModal()" class="cc-modal-close">
                <i class="ti ti-x"></i>
            </button>
        </div>

        <div class="cc-search-box">
            <i class="ti ti-search"></i>
            <input id="candidateSearchInput"
                   type="text"
                   placeholder="Search candidate name..."
                   oninput="searchCandidates(this.value)" />
        </div>

        <div id="candidateSearchResults" class="cc-results-box">
            <div id="candidateSearchPlaceholder" class="cc-results-placeholder">
                Start typing to search candidates...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Staged assignments now keyed by the slot's DOM id (one entry per chair, not per position).
        const stagedAssignments = {
            @foreach (var position in Model.Positions)
            {
                    @foreach (var slot in position.Slots.Where(s => !s.IsEmpty))
                    {
                            @:"slot-@slot.Candidate.CandidateId": { positionId: @position.positionId, candidateId: @slot.Candidate.CandidateId, memberId: @slot.Candidate.MemberId, fullName: "@slot.Candidate.FullName.Replace("\"", "\\\"")", photoUrl: "@Html.Raw(slot.Candidate.PhotoUrl)" },
                    }
            }
        };

        let currentPositionId = null;
        let currentSlotDomId = null;
        let searchDebounce = null;

        function showToast(message, type = 'info', duration = 3500) {
            const container = document.getElementById('ccToastContainer');
            const icons = {
                success: 'ti ti-circle-check',
                error: 'ti ti-circle-x',
                warning: 'ti ti-alert-triangle',
                info: 'ti ti-info-circle'
            };
            const toast = document.createElement('div');
            toast.className = `cc-toast ${type}`;
            toast.innerHTML = `
                <i class="${icons[type] || icons.info}"></i>
                <span>${message}</span>
                <button class="cc-toast-close" onclick="this.parentElement.remove()">
                    <i class="ti ti-x"></i>
                </button>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('cc-toast-out');
                toast.addEventListener('animationend', () => toast.remove());
            }, duration);
        }

        // ── Per-position lock/unlock toggle ──
        function toggleGroupEdit(positionId, btnEl) {
            const group = document.querySelector(`.position-group[data-position-id="${positionId}"]`);
            if (!group) return;

            group.classList.toggle('locked');
            const isLocked = group.classList.contains('locked');

            const icon = btnEl.querySelector('i');
            const label = btnEl.querySelector('.edit-label');

            if (isLocked) {
                icon.className = 'ti ti-lock';
                label.innerText = 'Edit';
                showToast('Position locked again.', 'info', 1500);
            } else {
                icon.className = 'ti ti-lock-open';
                label.innerText = 'Done';
                showToast('You can now choose or change candidates for this position.', 'info', 2000);
            }
        }

        function openChooseCandidateModal(positionId, positionLabel, slotElement) {
            // Defense in depth: block if the group is locked, even if CSS pointer-events was bypassed.
            const group = slotElement.closest('.position-group');
            if (group && group.classList.contains('locked')) {
                showToast('Click "Edit" on this position first to make changes.', 'warning', 2500);
                return;
            }

            currentPositionId = positionId;
            currentSlotDomId = slotElement.id;
            document.getElementById('modalPositionLabel').innerText = positionLabel;
            document.getElementById('candidateSearchInput').value = '';
            document.getElementById('candidateSearchResults').innerHTML =
                '<div id="candidateSearchPlaceholder" class="cc-results-placeholder">Start typing to search candidates...</div>';
            document.getElementById('chooseCandidateModal').style.display = 'flex';
        }

        function closeChooseCandidateModal() {
            document.getElementById('chooseCandidateModal').style.display = 'none';
            currentPositionId = null;
            currentSlotDomId = null;
        }

        function searchCandidates(term) {
            clearTimeout(searchDebounce);
            const resultsEl = document.getElementById('candidateSearchResults');

            if (!term || term.trim().length === 0) {
                resultsEl.innerHTML =
                    '<div class="cc-results-placeholder">Start typing to search candidates...</div>';
                return;
            }

            searchDebounce = setTimeout(async () => {
                try {
                    const response = await fetch(`/PartyLists/SearchMembers?term=${encodeURIComponent(term)}&partyListId=@Model.partyListId`);

                    if (!response.ok) {
                        resultsEl.innerHTML = '<div class="cc-results-placeholder" style="color:#dc2626;">Connection error.</div>';
                        return;
                    }

                    const members = await response.json();
                    resultsEl.innerHTML = '';

                    if (!Array.isArray(members) || members.length === 0) {
                        resultsEl.innerHTML = '<div class="cc-results-placeholder">No available members found.</div>';
                        return;
                    }

                    members.forEach(member => {
                        const row = document.createElement("div");
                        row.className = "search-result-item";
                        row.innerHTML = `
                            <div class="d-flex align-items-center gap-2">
                                <img src="${member.photoUrl || '/images/default-avatar.png'}"
                                     alt="${member.fullName}"
                                     style="width:36px; height:36px; border-radius:50%; object-fit:cover; border:1px solid #e5e7eb;" />
                                <span class="fw-medium" style="font-size:14px;">
                                    ${member.fullName}
                                </span>
                            </div>
                        `;
                        row.onclick = function () {
                            selectCandidate(member.memberId, member.fullName, member.photoUrl);
                        };
                        resultsEl.appendChild(row);
                    });
                } catch (error) {
                    console.error("Asynchronous member search failed:", error);
                    resultsEl.innerHTML = '<div class="cc-results-placeholder" style="color:#dc2626;">Something went wrong.</div>';
                }
            }, 300);
        }

        function selectCandidate(memberId, fullName, photoUrl) {
            if (currentSlotDomId === null) return;

            const duplicateKey = Object.keys(stagedAssignments).find(
                key => key !== currentSlotDomId && stagedAssignments[key].memberId === memberId
            );

            if (duplicateKey) {
                showToast(`${fullName} is already assigned to another position for this party list.`, 'warning');
                return;
            }

            const existing = stagedAssignments[currentSlotDomId];
            stagedAssignments[currentSlotDomId] = {
                positionId: currentPositionId,
                candidateId: existing ? existing.candidateId : null, // null = this is a brand-new chair
                memberId, fullName, photoUrl
            };

            const slot = document.getElementById(currentSlotDomId);
            const nameEl = slot.querySelector('p.position-candidate-name');
            const avatarEl = slot.querySelector('.position-avatar');

            if (avatarEl) {
                avatarEl.style.background = "transparent";
                avatarEl.innerHTML = `
                    <img src="${photoUrl || '/images/default-avatar.png'}"
                         alt="${fullName}"
                         style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
                `;
            }
            if (nameEl) nameEl.innerText = fullName;
            slot.classList.add('filled');

            showToast(`${fullName} staged.`, 'success', 2000);
            closeChooseCandidateModal();
        }

        async function savePositions(partyListId) {
            const assignments = Object.values(stagedAssignments).map(a => ({
                positionId: a.positionId,
                memberId: a.memberId,
                existingCandidateId: a.candidateId
            }));

            if (assignments.length === 0) {
                showToast('Pick at least one candidate before saving.', 'warning');
                return;
            }

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenInput) {
                showToast('Security token missing — please refresh the page and try again.', 'error');
                return;
            }
            const token = tokenInput.value;

            const btn = document.getElementById('savePositionsBtn');
            btn.disabled = true;

            try {
                const response = await fetch('/PartyLists/AddCandidates', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ partyListId, assignments })
                });

                const result = await response.json();

                if (result.success) {
                    showToast('Positions saved successfully.', 'success');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showToast(result.message || 'Failed to save.', 'error');
                }
            } catch (err) {
                console.error('Save failed:', err);
                showToast('Something went wrong while saving.', 'error');
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}