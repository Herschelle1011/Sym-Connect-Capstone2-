@model PartyListDetailsViewModel
@using System.ComponentModel.DataAnnotations
@using Sym_Connect__Capstone2_.Models.Enums

@{
    ViewData["Title"] = "Details";
    Layout = "_AdminLayout";

    string GetDisplayName(Positions position)
    {
        var field = position.GetType().GetField(position.ToString());
        var attr = field?.GetCustomAttributes(typeof(DisplayAttribute), false)
                        .FirstOrDefault() as DisplayAttribute;
        return attr?.Name ?? position.ToString();
    }

    // Palette cycles per card so avatars don't all look the same
    var palette = new[]
    {
        ("#dcfce7", "#166534"), // green
        ("#dbeafe", "#1e40af"), // blue
        ("#fce7f3", "#9d174d"), // pink
        ("#ede9fe", "#5b21b6"), // purple
        ("#fef3c7", "#92400e"), // amber
        ("#e0f2fe", "#0369a1"), // sky
        ("#fee2e2", "#991b1b"), // red
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .partylist-details-page, .partylist-details-page * {
        font-family: 'Poppins', sans-serif;
    }

    .partylist-details-page {
        padding: 1.5rem 0;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        color: #7b8397;
        text-decoration: none;
        font-size: 17px;
        transition: background .15s, color .15s;
        flex-shrink: 0;
    }

        .back-link:hover {
            background: #f1f2f6;
            color: #0d6efd;
        }

    .page-heading {
        font-size: 22px;
        font-weight: 700;
        color: #1a1f2b;
        margin: 0;
    }

    .page-subtext {
        font-size: 13px;
        color: #9aa3b8;
        margin-left: 46px;
    }

    .positions-card {
        background: #fff;
        border: 1px solid #eef0f5;
        border-radius: 18px;
        padding: 28px;
    }

    .positions-card-title {
        text-align: center;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: .06em;
        color: #7b8397;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .position-slot {
        border: 1px solid #eef0f5;
        border-radius: 12px;
        padding: 12px 16px;
        background: #fbfbfd;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: border-color .15s, background .15s;
    }

        .position-slot:hover {
            border-color: #dfe3ec;
            background: #f8f9fc;
        }

        .position-slot.filled {
            background: #fff;
        }

    .position-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .position-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a1f2b;
        margin-bottom: 1px;
    }

    .position-candidate-name {
        font-size: 12px;
        color: #9aa3b8;
    }

    .btn-choose {
        background: #0d6efd;
        color: #fff;
        border: none;
        font-size: 12px;
        font-weight: 600;
        border-radius: 999px;
        padding: 6px 14px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .btn-choose:hover {
            background: #0b5ed7;
            color: #fff;
        }

    .btn-change-icon {
        color: #0d6efd;
        font-size: 17px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
        cursor: pointer;
    }

        .btn-change-icon:hover {
            background: #eef4ff;
        }

    .btn-save-positions {
        background: #0d6efd;
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 14px;
        border-radius: 999px;
        padding: 11px 26px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background .15s;
    }

        .btn-save-positions:hover {
            background: #0b5ed7;
        }

        .btn-save-positions:disabled {
            opacity: .6;
        }

    .back-to-list-link {
        font-size: 13px;
        color: #7b8397;
        text-decoration: none;
        font-weight: 500;
    }

        .back-to-list-link:hover {
            color: #0d6efd;
        }

    /* ── Modal ── */
    .cc-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(15, 23, 42, .5);
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
    }

    .cc-modal-box {
        background: #fff;
        border-radius: 18px;
        padding: 24px;
        width: 100%;
        max-width: 460px;
        margin: auto;
        box-shadow: 0 12px 40px rgba(15, 23, 42, .18);
    }

    .cc-modal-title {
        margin: 0;
        font-weight: 700;
        font-size: 16px;
        color: #1a1f2b;
    }

    .cc-modal-close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: #9aa3b8;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        transition: background .15s;
    }

        .cc-modal-close:hover {
            background: #f1f2f6;
        }

    .cc-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #e3e6ee;
        border-radius: 10px;
        padding: 9px 14px;
        margin-bottom: 12px;
        transition: border-color .15s;
    }

        .cc-search-box:focus-within {
            border-color: #0d6efd;
        }

        .cc-search-box i {
            color: #9aa3b8;
        }

        .cc-search-box input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14px;
        }

    .cc-results-box {
        border: 1px solid #eef0f5;
        border-radius: 10px;
        overflow: hidden;
        max-height: 260px;
        overflow-y: auto;
    }

    .cc-results-placeholder {
        padding: 18px;
        text-align: center;
        color: #9aa3b8;
        font-size: 13px;
    }

    .search-result-item {
        padding: 9px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f5f6fa;
        transition: background .12s;
    }

        .search-result-item:last-child {
            border-bottom: none;
        }

        .search-result-item:hover {
            background: #f3f7fc;
        }
</style>

<div class="partylist-details-page">

    <div style="display:none">
        @Html.AntiForgeryToken()
    </div>

    <div class="d-flex align-items-center gap-3 mb-1">
        <a asp-action="Index" class="back-link" title="Back to Party Lists">
            <i class="ti ti-arrow-left"></i>
        </a>
        <h1 class="page-heading">@Model.partyListName</h1>
    </div>
    <p class="page-subtext mb-4">@Model.partyDescription</p>

    <div class="positions-card">
        <div class="positions-card-title">Positions Available</div>

        <div class="row g-3" id="positionsGrid">
            @{
                var positions = Enum.GetValues(typeof(Positions)).Cast<Positions>().ToList();
                var i = 0;
            }
            @foreach (var position in positions)
            {
                var candidate = Model.Candidates?.FirstOrDefault(c => c.Positions == position);
                var (bg, fg) = palette[i % palette.Length];
                i++;

                <div class="col-md-6">
                    <div class="position-slot @(candidate != null ? "filled" : "")"
                         id="slot-@position"
                         data-position="@position">

                        <div class="d-flex align-items-center gap-2">
                            <div class="position-avatar" style="background:@bg; color:@fg; border-radius:50%;">
                                @if (candidate != null && !string.IsNullOrEmpty(candidate.PhotoUrl))
                                {
                                    <img src="@candidate.PhotoUrl"
                                         alt="@candidate.FullName"
                                         style="width:100%; height:100%; border-radius:50%; object-fit:cover;" />
                                }
                                else if (candidate != null)
                                {
                                    @(candidate.FullName.Length >= 2
                                        ? candidate.FullName.Substring(0, 2).ToUpper()
                                        : candidate.FullName.ToUpper())
                                }
                                else
                                {
                                    <i class="ti ti-user-plus" style="font-size:16px;"></i>
                                }
                            </div>
                            <div>
                                <p class="position-name mb-0">@GetDisplayName(position)</p>
                                <p class="position-candidate-name text-muted mb-0">
                                    @(candidate != null ? candidate.FullName : "choose a candidate")
                                </p>
                            </div>
                        </div>

                        @if (candidate != null)
                        {
                            <span class="btn-change-icon"
                                  onclick="openChooseCandidateModal('@position', '@GetDisplayName(position)')"
                                  title="Change candidate">
                                <i class="ti ti-edit"></i>
                            </span>
                        }
                        else
                        {
                            <button class="btn-choose" onclick="openChooseCandidateModal('@position', '@GetDisplayName(position)')">
                                <i class="ti ti-circle-plus"></i> Choose
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button id="savePositionsBtn" class="btn-save-positions" onclick="savePositions(@Model.partyListid)">
                <i class="ti ti-device-floppy"></i> Click to Save
            </button>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="back-to-list-link">&larr; Back to List</a>
    </div>
</div>

@* ===== CHOOSE CANDIDATE MODAL ===== *@
<div id="chooseCandidateModal" class="cc-modal-overlay">
    <div class="cc-modal-box">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="cc-modal-title">
                Choose candidate for <span id="modalPositionLabel"></span>
            </h5>
            <button onclick="closeChooseCandidateModal()" class="cc-modal-close">
                <i class="ti ti-x"></i>
            </button>
        </div>

        <div class="cc-search-box">
            <i class="ti ti-search"></i>
            <input id="candidateSearchInput"
                   type="text"
                   placeholder="Search candidate name..."
                   oninput="searchCandidates(this.value)" />
        </div>

        <div id="candidateSearchResults" class="cc-results-box">
            <div id="candidateSearchPlaceholder" class="cc-results-placeholder">
                Start typing to search candidates...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Staged assignments: { "President": { id, name }, ... }
        const stagedAssignments = {};

        let currentPosition = null;
        let searchDebounce = null;

        function openChooseCandidateModal(position, positionLabel) {
            currentPosition = position;
            document.getElementById('modalPositionLabel').innerText = positionLabel;
            document.getElementById('candidateSearchInput').value = '';
            document.getElementById('candidateSearchResults').innerHTML =
                '<div id="candidateSearchPlaceholder" class="cc-results-placeholder">Start typing to search candidates...</div>';

            document.getElementById('chooseCandidateModal').style.display = 'flex';
        }

        function closeChooseCandidateModal() {
            document.getElementById('chooseCandidateModal').style.display = 'none';
            currentPosition = null;
        }

        function searchCandidates(term) {
            clearTimeout(searchDebounce);
            const resultsEl = document.getElementById('candidateSearchResults');

            if (!term || term.trim().length === 0) {
                resultsEl.innerHTML =
                    '<div class="cc-results-placeholder">Start typing to search candidates...</div>';
                return;
            }

            searchDebounce = setTimeout(async () => {
                try {
                    const response = await fetch(`/PartyLists/SearchMembers?term=${encodeURIComponent(term)}&partyListId=@Model.partyListid`);

                    if (!response.ok) {
                        resultsEl.innerHTML = '<div class="cc-results-placeholder" style="color:#dc2626;">Connection error.</div>';
                        return;
                    }

                    const members = await response.json();
                    resultsEl.innerHTML = '';

                    if (!Array.isArray(members) || members.length === 0) {
                        resultsEl.innerHTML = '<div class="cc-results-placeholder">No available members found.</div>';
                        return;
                    }

                    members.forEach(member => {
                        const row = document.createElement("div");
                        row.className = "search-result-item";
                        row.innerHTML = `
                            <div class="d-flex align-items-center gap-2">
                                <img src="${member.photoUrl || '/images/default-avatar.png'}"
                                     alt="${member.fullName}"
                                     style="width:36px; height:36px; border-radius:50%; object-fit:cover; border:1px solid #e5e7eb;" />
                                <span class="fw-medium" style="font-size:14px;">
                                    ${member.fullName}
                                </span>
                            </div>
                        `;
                        row.onclick = function () {
                            selectCandidate(
                                member.memberId,
                                member.fullName,
                                member.photoUrl
                            );
                        };

                        resultsEl.appendChild(row);
                    });

                } catch (error) {
                    console.error("Asynchronous member search failed:", error);
                    resultsEl.innerHTML = '<div class="cc-results-placeholder" style="color:#dc2626;">Something went wrong.</div>';
                }
            }, 300);
        }

        function selectCandidate(candidateId, fullName, photoUrl) {
            if (!currentPosition) return;

            stagedAssignments[currentPosition] = {
                candidateId,
                fullName,
                photoUrl
            };

            const slot = document.getElementById(`slot-${currentPosition}`);
            const nameEl = slot.querySelector('p.position-candidate-name');
            const avatarEl = slot.querySelector('.position-avatar');

            if (avatarEl) {
                avatarEl.style.background = "transparent";
                avatarEl.innerHTML = `
                    <img src="${photoUrl || '/images/default-avatar.png'}"
                         alt="${fullName}"
                         style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
                `;
            }

            if (nameEl) {
                nameEl.innerText = fullName;
            }

            slot.classList.add('filled');

            closeChooseCandidateModal();
        }

        async function savePositions(partyListId) {
            const assignments = Object.keys(stagedAssignments).map(position => ({
                position: position,
                candidateId: stagedAssignments[position].candidateId
            }));

            if (assignments.length === 0) {
                return;
            }

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenInput) {
                console.error('Antiforgery token not found on page.');
                alert('Security token missing — please refresh the page and try again.');
                return;
            }
            const token = tokenInput.value;

            const btn = document.getElementById('savePositionsBtn');
            btn.disabled = true;

            try {
                const response = await fetch('/PartyLists/AddCandidates', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ partyListId, assignments })
                });

                const result = await response.json();

                if (result.success) {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to save.');
                }
            } catch (err) {
                console.error('Save failed:', err);
                alert('Something went wrong while saving.');
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
