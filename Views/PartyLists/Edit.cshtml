@model Sym_Connect__Capstone2_.ViewModels.Election.PartyList.EditPartyListViewModel
@{
    ViewData["Title"] = "Edit Party List";
    Layout = "_AdminLayout";
}

<div style="padding: 1.5rem 0; max-width: 620px; margin: 0 auto;">

    @* {{-- Header --}} *@
    <div class="d-flex align-items-center gap-3 mb-1">
        <a asp-action="Details" asp-route-id="@Model.partyListId"
           style="color:#6b7280; font-size:20px; text-decoration:none;"
           title="Back to Details">
            <i class="ti ti-arrow-left"></i>
        </a>
        <h1 class="fs-4 fw-medium mb-0">Edit Party List</h1>
    </div>
    <p class="text-muted mb-4" style="font-size:13px; margin-left:2.25rem;">
        Update the name and description for this party list.
    </p>

    @* {{-- Form Panel --}} *@
    <div class="card border" style="border-radius:16px;">
        <div class="card-body p-4">

            @* Avatar preview that mirrors the candidate-avatar style from Details *@
            <div class="d-flex align-items-center gap-3 mb-4"
                 style="padding:14px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:12px;">
                <div id="editAvatarPreview"
                     style="width:44px; height:44px; border-radius:50%;
                    background:#dbeafe; color:#1e40af;
                    display:flex; align-items:center; justify-content:center;
                    font-size:15px; font-weight:600; flex-shrink:0;">
                    @(!string.IsNullOrWhiteSpace(Model.PartyListName) && Model.PartyListName.Length >= 2
                        ? Model.PartyListName.Substring(0, 2).ToUpper()
                        : "PL")
                </div>
                <div>
                    <p class="mb-0 text-muted" style="font-size:12px;">Editing</p>
                    <p class="mb-0 fw-medium" style="font-size:14px;" id="editNamePreview">
                        @(string.IsNullOrWhiteSpace(Model.PartyListName) ? "Untitled Party List" : Model.PartyListName)
                    </p>
                </div>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.partyListId">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>
                <input type="hidden" asp-for="partyListId" />

                <div class="mb-3">
                    <label asp-for="PartyListName" class="form-label fw-medium" style="font-size:13px; color:#374151;"></label>
                    <input asp-for="PartyListName" class="form-control"
                           oninput="document.getElementById('editNamePreview').innerText = this.value || 'Untitled Party List';
                    document.getElementById('editAvatarPreview').innerText=this.value.length>= 2 ? this.value.substring(0,2).toUpperCase() : 'PL';"
                           style="border-radius:10px; border:1px solid #e5e7eb; padding:10px 14px; font-size:14px;" />
                    <span asp-validation-for="PartyListName" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PartyListDescription" class="form-label fw-medium" style="font-size:13px; color:#374151;"></label>
                    <textarea asp-for="PartyListDescription" class="form-control" rows="3"
                              style="border-radius:10px; border:1px solid #e5e7eb; padding:10px 14px; font-size:14px; resize:vertical;"></textarea>
                    <span asp-validation-for="PartyListDescription" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.partyListId"
                       class="btn rounded-pill px-4"
                       style="background:#f3f4f6; color:#374151; border:1px solid #e5e7eb; font-size:13px;">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" style="font-size:13px;">
                        <i class="ti ti-device-floppy"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index">&larr; Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
