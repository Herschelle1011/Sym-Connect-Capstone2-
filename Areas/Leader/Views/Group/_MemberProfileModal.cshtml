<div class="modal fade" id="memberProfileModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; border:none;">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6;">
                <h5 class="modal-title" style="font-weight:700;">Member Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div style="display:flex; align-items:center; gap:16px; margin-bottom:20px;">
                    <img id="profilePhoto" src="" alt=""
                         style="width:64px; height:64px; border-radius:50%; object-fit:cover;" />
                    <div>
                        <div id="profileName" style="font-size:17px; font-weight:700; color:#1a1f2b;"></div>
                        <span id="profileStatus" class="leader-status-badge"></span>
                    </div>
                </div>

                <div style="display:flex; flex-direction:column; gap:12px; font-size:13.5px;">
                    <div><i class="ti ti-mail" style="color:#9aa3b8; width:18px;"></i> <span id="profileEmail"></span></div>
                    <div><i class="ti ti-phone" style="color:#9aa3b8; width:18px;"></i> <span id="profileContact"></span></div>
                    <div><i class="ti ti-star" style="color:#9aa3b8; width:18px;"></i> <span id="profilePoints"></span> points</div>
                    <div><i class="ti ti-calendar" style="color:#9aa3b8; width:18px;"></i> Joined <span id="profileJoined"></span></div>
                </div>
            </div>
        </div>
    </div>
</div>