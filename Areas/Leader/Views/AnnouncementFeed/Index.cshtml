@model List<VisibleAnnouncementViewModel>
@using Sym_Connect__Capstone2_.Models.Enums.AnnouncementEnums
@{
    ViewData["Title"] = "Announcements";
    Layout = "_LeaderLayout";
    string? currentUserId = ViewBag.CurrentUserId as string;
}

<div class="announcement-page">
    <div class="page-header">
        <div>
            <div class="page-eyebrow">Communication</div>
            <h2>Announcements</h2>
            <p class="page-subtitle">Announcements for your group and all leaders.</p>
        </div>
        <button type="button" class="btn btn-primary" id="openCreateAnnouncementBtn">
            <span>&#43;</span> New Announcement
        </button>
    </div>

    <div class="announcement-toolbar">
        <div class="ann-tabs">
            <button type="button" class="ann-tab active" data-tab="all">All</button>
            <button type="button" class="ann-tab" data-tab="admin">From Admin</button>
            <button type="button" class="ann-tab" data-tab="mine">My Announcements</button>
        </div>
    </div>

    <div class="ann-card-list" id="announcementListBody">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div>No announcements right now.</div>
            </div>
        }
        else
        {
            foreach (var a in Model.OrderByDescending(x => x.IsPinned)
                        .ThenByDescending(x => x.TargetType == TargetAudience.SpecificGroup)
                        .ThenByDescending(x => x.PublishedAt))
            {
                bool isOwner = currentUserId != null && a.CreatedByUserId == currentUserId;
                bool isFromAdmin = a.TargetType != TargetAudience.SpecificGroup;
                var avatarSrc = string.IsNullOrWhiteSpace(a.PhotoUrl) ? "/images/default.png" : a.PhotoUrl;

                var audiencePillClass = a.TargetType switch
                {
                    TargetAudience.Everyone => "pill-audience-everyone",
                    TargetAudience.AllLeaders => "pill-audience-leaders",
                    TargetAudience.SpecificGroup => "pill-audience-group",
                    _ => "pill-audience"
                };

                <div class="ann-card @(a.IsPinned ? "pinned" : "")"
                     data-id="@a.AnnouncementId"
                     data-source="@(isFromAdmin ? "admin" : "leader")"
                     data-owner="@isOwner.ToString().ToLower()">
                    <div class="ann-card-header">
                        <img class="ann-avatar" src="@avatarSrc" alt="@a.PostedByName"
                             onerror="this.onerror=null;this.src='/images/default.png';" />

                        <div class="ann-card-headtext">
                            <div class="ann-card-title-row">
                                <h3 class="ann-card-title">@a.Title</h3>

                                @if (isOwner)
                                {
                                    <div class="ann-card-menu-wrapper">
                                        <button type="button" class="btn-icon btn-more" data-id="@a.AnnouncementId" title="More">
                                            <i class="ti ti-dots-vertical"></i>
                                        </button>
                                        <div class="ann-dropdown-menu" hidden>
                                            <button type="button" class="dropdown-item btnEditAnnouncement" data-id="@a.AnnouncementId">
                                                <i class="ti ti-pencil"></i> Edit
                                            </button>
                                            <button type="button" class="dropdown-item dropdown-item-danger btnArchiveAnnouncement" data-id="@a.AnnouncementId">
                                                <i class="ti ti-trash"></i> Archive
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="ann-card-meta">
                                <span class="pill pill-posted-by">Posted by @a.PostedByName</span>

                                @if (a.IsPinned)
                                {
                                    <span class="badge-pinned">PINNED</span>
                                }

                                <span class="pill @audiencePillClass">@a.TargetType</span>

                                @if (!string.IsNullOrEmpty(a.GroupName))
                                {
                                    <span class="ann-meta-plain">@a.GroupName</span>
                                }

                                <span class="ann-meta-plain">
                                    @(a.PublishedAt.HasValue ? a.PublishedAt.Value.ToString("MMM d, yyyy h:mm tt") : "")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="ann-card-body">
                        <p class="ann-card-desc">@a.Content</p>
                    </div>

                    @if (a.ExpiresAt.HasValue)
                    {
                        <div class="ann-card-footer">
                            Expires @a.ExpiresAt.Value.ToString("MMM d, yyyy") at @a.ExpiresAt.Value.ToString("h:mm tt")
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // ==== TAB FILTERING ====
            const tabs = document.querySelectorAll('.ann-tab');
            const cards = document.querySelectorAll('#announcementListBody .ann-card');

            tabs.forEach(tab => {
                tab.addEventListener('click', function () {
                    tabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.dataset.tab;

                    cards.forEach(card => {
                        if (filter === 'all') {
                            card.style.display = '';
                        } else if (filter === 'admin') {
                            card.style.display = card.dataset.source === 'admin' ? '' : 'none';
                        } else if (filter === 'mine') {
                            card.style.display = card.dataset.owner === 'true' ? '' : 'none';
                        }
                    });

                    // Show/hide empty-state message if a filter yields zero visible cards
                    const anyVisible = Array.from(cards).some(c => c.style.display !== 'none');
                    const emptyState = document.querySelector('#announcementListBody .empty-state');
                    if (!anyVisible && cards.length > 0) {
                        if (!document.getElementById('noResultsMsg')) {
                            const msg = document.createElement('div');
                            msg.className = 'empty-state';
                            msg.id = 'noResultsMsg';
                            msg.innerHTML = '<div>No announcements in this tab.</div>';
                            document.getElementById('announcementListBody').appendChild(msg);
                        }
                    } else {
                        document.getElementById('noResultsMsg')?.remove();
                    }
                });
            });

            function initializeAnnouncementForm() {
                const publishSelect = document.getElementById("publishOptionSelect");
                const scheduleField = document.getElementById("scheduleField");
                const expirationSelect = document.getElementById("expirationOptionSelect");
                const customExpirationField = document.getElementById("customExpirationField");

                function updatePublishField() {
                    if (!publishSelect || !scheduleField) return;
                    scheduleField.style.display = publishSelect.value === "Scheduled" ? "block" : "none";
                }
                function updateExpirationField() {
                    if (!expirationSelect || !customExpirationField) return;
                    customExpirationField.style.display = expirationSelect.value === "Custom" ? "block" : "none";
                }

                publishSelect?.addEventListener("change", updatePublishField);
                expirationSelect?.addEventListener("change", updateExpirationField);

                updatePublishField();
                updateExpirationField();
            }

            document.getElementById("openCreateAnnouncementBtn").addEventListener("click", async function () {
                const response = await fetch("/Leader/AnnouncementFeed/Create");
                const html = await response.text();
                document.getElementById("appModalLabel").textContent = "New Announcement";
                document.getElementById("appModalBody").innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById("appModal")).show();
                initializeAnnouncementForm();
            });

            document.getElementById("announcementListBody").addEventListener("click", function (e) {
                const moreBtn = e.target.closest(".btn-more");
                document.querySelectorAll(".ann-dropdown-menu").forEach(menu => {
                    if (!moreBtn || menu !== moreBtn.nextElementSibling) menu.hidden = true;
                });
                if (moreBtn) {
                    const menu = moreBtn.nextElementSibling;
                    menu.hidden = !menu.hidden;
                }
            });
            document.addEventListener("click", function (e) {
                if (!e.target.closest(".ann-card-menu-wrapper")) {
                    document.querySelectorAll(".ann-dropdown-menu").forEach(menu => menu.hidden = true);
                }
            });

            document.getElementById("announcementListBody").addEventListener("click", async function (e) {
                const editBtn = e.target.closest(".btnEditAnnouncement");
                if (!editBtn) return;

                const id = editBtn.dataset.id;
                const response = await fetch(`/Leader/AnnouncementFeed/Edit/${id}`);

                if (!response.ok) {
                    showAlertDialog("You can't edit this announcement.", "error", "Not allowed");
                    return;
                }
                const html = await response.text();
                document.getElementById("appModalLabel").textContent = "Edit Announcement";
                document.getElementById("appModalBody").innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById("appModal")).show();
                initializeAnnouncementForm();
            });

            document.getElementById("appModalBody").addEventListener("submit", async function (e) {
                const form = e.target.closest("#announcementForm");
                if (!form) return;
                e.preventDefault();

                const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
                const result = await response.json();

                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById("appModal")).hide();
                    showAlertDialog(result.message || "Announcement saved successfully.", "success", "Success");
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showAlertDialog(result.message || "Unable to save announcement.", "error", "Failed");
                }
            });

            document.getElementById("announcementListBody").addEventListener("click", async function(e) {
                const archiveBtn = e.target.closest(".btnArchiveAnnouncement");
                if (!archiveBtn) return;

                const id = archiveBtn.dataset.id;

                const response = await fetch(`/Leader/AnnouncementFeed/GetArchive?announcementId=${id}`);
                if (!response.ok) {
                    showAlertDialog("Unable to load this announcement.", "error", "Failed");
                    return;
                }
                const html = await response.text();

                document.getElementById("appModalLabel").textContent = "Archive Announcement";
                document.getElementById("appModalBody").innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById("appModal")).show();
            });

            document.getElementById("appModalBody").addEventListener("submit", async function (e) {
                const form = e.target.closest("form[asp-action='Archive']") || e.target.closest("form");
                if (!form || !form.action.includes("/Archive")) return;
                e.preventDefault();

                const response = await fetch(form.action, { method: "POST", body: new FormData(form) });
                const result = await response.json();

                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById("appModal")).hide();
                    showAlertDialog(result.message || "Announcement archived.", "success", "Success");
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showAlertDialog(result.message || "Unable to archive announcement.", "error", "Failed");
                }
            });
        });
    </script>
}