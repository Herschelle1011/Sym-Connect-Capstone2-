@model Sym_Connect__Capstone2_.Areas.Leader.ViewModels.Dashboard.DashboardViewModel;


@{
    Layout = "_LeaderLayout";
    ViewData["Title"] = "Dashboard";
}


@* // WONT SHOW PINNED ANNOUNCEMENTS *@

<h1>Leaders Dashboard</h1>

@if (Model != null)
{
    <div class="pinned-announcement">
        <div class="pinned-label">📌 Pinned</div>
        <h3>@Model.PinnedAnnouncement.Title</h3>
        <p>@Model.PinnedAnnouncement.Content</p>
        <div class="pinned-meta">
            Posted @Model.PinnedAnnouncement.PublishedAt.Value.ToString("MMM d, yyyy")
        </div>
    </div>
}

