@using Microsoft.AspNetCore.Identity
@using Sym_Connect__Capstone2_.Models
@using Sym_Connect__Capstone2_.Data
@using Microsoft.EntityFrameworkCore;
@inject AppDbContext DbContext
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYM-Connect</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/admin/group-attendance-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/ParticipationMemberModal.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sym_Connect__Capstone2_.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/leader/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/MediaAndDocuments.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/announcement.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/event.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ViewAttendanceGroupDetails.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/facility.css" asp-append-version="true" />


    <link rel="stylesheet"
          href="~/css/notification-dropdown.css"
          asp-append-version="true" />


</head>
<body>

    <div style="display:none;">
        @Html.AntiForgeryToken()
    </div>

    @{
        var userId = UserManager.GetUserId(User);

        var currentUser = await DbContext.Users
            .AsNoTracking()
            .Include(u => u.Member)
            .FirstOrDefaultAsync(u => u.Id == userId);

        var profilePicture = currentUser?.Member?.User.ProfilePictureUrl;

        var userName = currentUser?.Member != null
            ? $"{currentUser.Member.FirstName} {currentUser.Member.LastName}"
            : "User";

        var fallbackAvatar =
            $"https://ui-avatars.com/api/?name={userName}&background=4a6cf7&color=fff&size=34";
    }

    <!-- ═══════════════════════════════ TOP BAR ═══════════════════════════════ -->
    <div id="topbar">

    <button id="sidebar-toggle"
            title="Open menu">
        <i class="bi bi-list"></i>
    </button>

    <span class="topbar-brand">
        SYM-Connect
    </span>

    <div class="topbar-actions">

            <div class="notification-wrapper" id="notificationWrapper">

                <a asp-area="Leader"
                   asp-controller="Notifications"
                   asp-action="Index"
                   class="topbar-icon-btn"
                   id="notifBell"
                   data-dropdown-url="@Url.Action("Dropdown", "Notifications", new { area = "Leader" })"
                   data-count-url="@Url.Action("UnreadCount", "Notifications", new { area = "Leader" })"
                   data-mark-read-url="@Url.Action("MarkAsRead", "Notifications", new { area = "Leader" })"
                   title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notif-count"
                          id="notifCount"
                          style="display:none;">
                        0
                    </span>
                </a>

                <div id="notifDropdownPanel"
                     class="notif-dropdown-panel">
                </div>

            </div>
        <img class="topbar-avatar"
             src="@(string.IsNullOrEmpty(profilePicture)
                 ? fallbackAvatar
                 : profilePicture)"
             alt="User Avatar" />

    </div>
</div>

    <!-- ═══════════════════════════════ OVERLAY ═══════════════════════════════ -->
    <div id="sidebar-overlay"></div>

    <!-- ═══════════════════════════════ SIDEBAR ═══════════════════════════════ -->
    <nav id="sidebar">

        <div class="sidebar-brand">
            <img src="https://res.cloudinary.com/dxzmz62w4/image/upload/q_auto/f_auto/v1778759822/profiles/8f97c2e0-2fc4-46d0-a8ad-499b0f30e2c1.png"
                 alt="SYM-Connect Logo"
                 onerror="this.src='https://ui-avatars.com/api/?name=SYM&background=4a6cf7&color=fff&size=36'" />

            <div class="sidebar-brand-text">
                <span class="sidebar-brand-name">SYM-Connect</span>
                <span class="sidebar-brand-subname">Salesian Youth Movement</span>
            </div>

            <button id="sidebar-close" title="Close menu" aria-label="Close menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="sidebar-nav">

            <a asp-controller="AnnouncementFeed" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcement" ? "active" : "")">
                <i class="bi bi-megaphone"></i>
                <span class="nav-label">Announcements</span>
            </a>

            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid"></i>
                <span class="nav-label">Dashboard</span>
            </a>

            <div class="nav-item-group">
                <a href="#leaderEventsSubmenu"
                   class="nav-item nav-item-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")"
                   data-bs-toggle="collapse"
                   role="button"
                   aria-expanded="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "true" : "false")"
                   aria-controls="leaderEventsSubmenu">
                    <i class="bi bi-calendar-event"></i>
                    <span class="nav-label">Events</span>
                    <i class="bi bi-chevron-down nav-toggle-caret"></i>
                </a>

                <div class="collapse @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "show" : "")"
                     id="leaderEventsSubmenu">
                    <div class="nav-submenu">
                        <a asp-area="Leader" asp-controller="Events" asp-action="Index"
                           class="nav-subitem @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-person-badge"></i>
                            <span class="nav-label">My Events</span>
                        </a>

                        <a asp-area="Leader"
                           asp-controller="Events"
                           asp-action="AssignedEvents"
                           class="nav-subitem @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" &&
                                                   ViewContext.RouteData.Values["action"]?.ToString() == "AssignedEvents"
                                                   ? "active" : "")">

                            <i class="bi bi-calendar2-check"></i>
                            <span class="nav-label">Assigned Events</span>
                        </a>

                        <a asp-area="Leader" asp-controller="Events" asp-action="AllEvents"
                           class="nav-subitem @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" && ViewContext.RouteData.Values["action"]?.ToString() == "AllEvents" ? "active" : "")">
                            <i class="bi bi-globe"></i>
                            <span class="nav-label">All Events</span>
                        </a>
                    </div>
                </div>
            </div>

            <a asp-area="Leader"
               asp-controller="Facility"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Facility" ? "active" : "")">
                <i class="bi bi-hospital"></i>
                <span class="nav-label">Facility</span>
            </a>

            <a asp-area="Leader"
               asp-controller="Group"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "MyGroups" ? "active" : "")">
                <i class="bi bi-people-fill"></i>
                <span class="nav-label">My Groups</span>
            </a>

            <div class="nav-item-group">

                <a href="#leaderEvaluationSubmenu"
                   class="nav-item nav-item-toggle
                    @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluations"
                       ? "active"
                       : "")"
                   data-bs-toggle="collapse"
                   role="button"
                   aria-expanded="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluations"
                              ? "true"
                              : "false")"
                   aria-controls="leaderEvaluationSubmenu">

                    <i class="bi bi-star-half"></i>

                    <span class="nav-label">
                        Evaluation
                    </span>

                    <i class="bi bi-chevron-down nav-toggle-caret"></i>

                </a>


                <div class="collapse
                    @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluations"
                         ? "show"
                         : "")"
                     id="leaderEvaluationSubmenu">

                    <div class="nav-submenu">

                        <!-- CREATED EVALUATIONS -->
                        <a asp-area="Leader"
                           asp-controller="Evaluations"
                           asp-action="Index"
                           class="nav-subitem
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluations"
                               && ViewContext.RouteData.Values["action"]?.ToString() == "Index"
                               ? "active"
                               : "")">

                            <i class="bi bi-pencil-square"></i>

                            <span class="nav-label">
                                Created Evaluations
                            </span>

                        </a>


                        <!-- ASSIGNED TO ME -->
                        <a asp-area="Leader"
                           asp-controller="Evaluations"
                           asp-action="AssignedToMe"
                           class="nav-subitem
                            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluations"
                               && (
                                   ViewContext.RouteData.Values["action"]?.ToString() == "AssignedToMe"
                                   || ViewContext.RouteData.Values["action"]?.ToString() == "TakeEvaluation"
                                   || ViewContext.RouteData.Values["action"]?.ToString() == "ThankYou"
                               )
                               ? "active"
                               : "")">

                            <i class="bi bi-clipboard-check"></i>

                            <span class="nav-label">
                                Assigned To Me
                            </span>

                        </a>

                    </div>

                </div>

            </div>

            <a asp-area="Leader"
               asp-controller="Election"
               asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Election" ? "active" : "")">
                <i class="bi bi-hand-index-thumb"></i>
                <span class="nav-label">Election</span>
            </a>


            <a asp-controller="MediaAndDocuments" asp-action="Index" asp-area="Leader"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "MediaAndDocuments" ? "active" : "")">
                <i class="bi bi-folder2-open"></i>
                <span class="nav-label">Media and Documents</span>
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-bottom">

   

            @* <a asp-controller="Help" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Help" ? "active" : "")">
                <i class="bi bi-question-circle"></i>
                <span class="nav-label">Help</span>
            </a> *@

            <a asp-controller="Account" asp-action="Login" asp-area="Identity"
               asp-route-returnUrl="@Url.Action("Account", "Login")"
               class="nav-item"
               onclick="return confirm('Are you sure you want to logout?')">
                <i class="bi bi-box-arrow-right"></i>
                <span class="nav-label">Logout</span>
            </a>

        </div>

        <a asp-area="Leader"
           asp-controller="Profile"
           asp-action="Index"
           class="sidebar-user sidebar-user-link">

            <img src="@(string.IsNullOrEmpty(profilePicture)
                                          ? fallbackAvatar
                                          : profilePicture)"
                 alt="User Avatar" />

            <div class="sidebar-user-info">

                <div class="sidebar-user-details">
                    <div class="sidebar-user-name">
                        @userName
                    </div>

                    <div class="sidebar-user-role">
                        Leader
                    </div>
                </div>

                <i class="bi bi-chevron-right sidebar-user-chevron"></i>

            </div>

        </a>


    </nav>
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <div id="main-content">
        <div class="content-wrapper">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/alertDialog.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/admin/notification.js" asp-append-version="true"></script>
    <script src="~/js/admin/announcement.js" asp-append-version="true"></script>



@await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        const openBtn = document.getElementById('sidebar-toggle');
        const closeBtn = document.getElementById('sidebar-close');

        function openSidebar() {
        sidebar.classList.add('show');
        overlay.classList.add('show');
        document.body.classList.add('sidebar-open');
        }

        function closeSidebar() {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
        document.body.classList.remove('sidebar-open');
        }

        openBtn.addEventListener('click', openSidebar);
        closeBtn.addEventListener('click', closeSidebar);
        overlay.addEventListener('click', closeSidebar);

        document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebar.classList.contains('show')) closeSidebar();
        });


        function showToast(message, success) {
        const container = document.querySelector('.toast-container');
        const delay = 9000;

        const toastEl = document.createElement('div');
        toastEl.className = `toast app-toast align-items-center border-0 ${success ? 'toast-success' : 'toast-danger'}`;
        toastEl.setAttribute('role', 'alert');
        toastEl.setAttribute('aria-live', 'assertive');
        toastEl.setAttribute('aria-atomic', 'true');
        toastEl.setAttribute('data-bs-delay', delay);

        const icon = success ? 'bi-check-circle-fill' : 'bi-x-circle-fill';

        toastEl.innerHTML = `
        <div class="toast-body-wrapper">
        <i class="bi ${icon} toast-icon"></i>
        <div class="toast-text">${message}</div>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-progress" style="animation-duration: ${delay}ms;"></div>
        `;

        container.appendChild(toastEl);

        const toast = new bootstrap.Toast(toastEl);
        toast.show();

        toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }

    </script>

    <partial name="_Modal" />
    <partial name="_AlertDialog" />

</body>
</html>