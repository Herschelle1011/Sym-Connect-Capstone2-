@using Sym_Connect__Capstone2_.Helpers
@model List<Sym_Connect__Capstone2_.ViewModels.Event.EventListItemViewModel>
@{
    ViewData["Title"] = "Assigned Events";

    string FormatTime(TimeSpan? t) => t.HasValue ? DateTime.Today.Add(t.Value).ToString("h:mm tt") : "";

    (string Text, string BadgeClass) GetStatus(DateTime startDate, TimeSpan? startTime, DateTime? endDate, TimeSpan? endTime)
    {
        var start = startDate.Date + (startTime ?? TimeSpan.Zero);
        var end = (endDate ?? startDate).Date + (endTime ?? TimeSpan.Zero);
        var now = DateTime.Now;

        if (now < start) return ("Upcoming", "bg-success-subtle text-success");
        if (now <= end) return ("Ongoing", "bg-warning-subtle text-warning");
        return ("Completed", "bg-secondary-subtle text-secondary");
    }

    // Distinct facility list for the Facility filter dropdown
    var allFacilities = Model
        .SelectMany(e => e.FacilityNames)
        .Distinct()
        .OrderBy(f => f)
        .ToList();
}

<style>
    /* ============================
           CARD (matches My Events layout)
           ============================ */

    .assigned-events-card {
        background: transparent;
        border: none;
        border-radius: 0;
        overflow: visible;
    }

    #assignedEventsList {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .assigned-event-row {
        background: #ffffff;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(15, 23, 42, 0.06);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        padding: 20px 22px;
    }

        .assigned-event-row:hover {
            transform: translateY(-1px);
            box-shadow: 0 7px 22px rgba(15, 23, 42, 0.09);
            border-color: #dfe5ee;
        }

    .assigned-event-row-inner {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    /* Date badge */
    .assigned-event-date-badge {
        width: 90px;
        min-width: 90px;
        height: 118px;
        background: linear-gradient(180deg, #edf4ff 0%, #f3f7ff 100%);
        border-radius: 12px;
        padding: 14px 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
    }

    .assigned-event-month {
        font-size: 14px;
        font-weight: 700;
        color: #007ec8;
        letter-spacing: 0.02em;
    }

    .assigned-event-day {
        font-size: 38px;
        font-weight: 700;
        color: #007ec8;
        line-height: 1.05;
        margin: 4px 0;
    }

    .assigned-event-weekday {
        font-size: 13px;
        font-weight: 500;
        color: #8290a3;
    }

    /* Title + meta */
    .assigned-event-title {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 6px;
    }

    .assigned-event-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 500;
        color: #667085;
        margin-bottom: 6px;
    }

        .assigned-event-meta i {
            color: #64748b;
            margin-right: 3px;
        }

    .assigned-event-meta-divider {
        color: #94a3b8;
        font-size: 11px;
        margin: 0 1px;
    }

    .assigned-event-subline {
        font-size: 13px;
        color: #667085;
        margin-bottom: 8px;
    }

        .assigned-event-subline i {
            color: #94a3b8;
            margin-right: 4px;
        }

    /* Tags (groups) */
    .assigned-event-group-badge {
        background: #f8fafc;
        border: 1px solid #e4e7ec;
        color: #344054;
        font-size: 12px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 10px;
        margin-right: 4px;
        margin-bottom: 4px;
        display: inline-block;
    }

    /* Right side: status + action */
    .assigned-event-actions {
        margin-left: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
        min-width: 165px;
    }

    .assigned-event-status-badge {
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        padding: 7px 14px;
    }

        .assigned-event-status-badge.bg-success-subtle {
            background: #dff3e9 !important;
            color: #14804a !important;
        }

        .assigned-event-status-badge.bg-warning-subtle {
            background: #fff2cc !important;
            color: #9a6700 !important;
        }

        .assigned-event-status-badge.bg-secondary-subtle {
            background: #eef0f3 !important;
            color: #5f6b7a !important;
        }

    .assigned-event-details-btn {
        min-width: 150px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid #007ec8;
        color: #007ec8;
        background: #ffffff;
    }

        .assigned-event-details-btn:hover {
            background: #eff6ff;
            color: #1d4ed8;
            border-color: #007ec8;
        }

    /* ============================
           FILTER TOOLBAR
           ============================ */

    .assigned-events-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }

    .assigned-search-box {
        flex: 1;
        min-width: 220px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 9px 12px;
        color: #9ca3af;
    }

        .assigned-search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: #111827;
            width: 100%;
            font-size: 0.9rem;
        }

    .assigned-filter-select {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        color: #374151;
        padding: 9px 12px;
        min-width: 170px;
        font-size: 0.88rem;
    }

    .assigned-event-row.d-none {
        display: none !important;
    }

    .assigned-events-empty {
        background: #ffffff;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        padding: 2.5rem;
        text-align: center;
        color: #667085;
    }

    .assigned-event-details-btn {
        text-decoration: none;
    }

        .assigned-event-details-btn:hover,
        .assigned-event-details-btn:focus,
        .assigned-event-details-btn:active {
            text-decoration: none;
        }

    /* ============================
           RESPONSIVE
           ============================ */

    @@media (max-width: 992px) {
        .assigned-event-actions {
            min-width: 100%;
            width: 100%;
            flex-direction: row;
            align-items: center;
            justify-content: flex-end;
            margin-top: 6px;
            margin-left: 0;
        }
    }

    @@media (max-width: 576px) {
        .assigned-event-row {
            padding: 16px;
        }

        .assigned-event-date-badge {
            width: 66px;
            min-width: 66px;
            height: 92px;
        }

        .assigned-event-month {
            font-size: 12px;
        }

        .assigned-event-day {
            font-size: 27px;
        }

        .assigned-event-title {
            font-size: 15px;
        }
    }
</style>

<div class="mb-3">
    <h4 class="mb-1"><i class="bi bi-calendar-check me-2" style="color:#007ec8;"></i>Assigned Events</h4>
    <p class="text-muted mb-0">Events created by admins and assigned to your group.</p>
</div>

<div class="assigned-events-toolbar">
    <div class="assigned-search-box">
        <i class="bi bi-search"></i>
        <input type="text" id="assignedEventSearch" placeholder="Search event title or facility..." />
    </div>

    <select id="assignedDateFilter" class="assigned-filter-select">
        <option value="all">All Dates</option>
        <option value="today">Today</option>
        <option value="week">This Week</option>
        <option value="month">This Month</option>
        <option value="upcoming">Upcoming</option>
        <option value="past">Past</option>
    </select>

    <select id="assignedFacilityFilter" class="assigned-filter-select">
        <option value="">All Facilities</option>
        @foreach (var facility in allFacilities)
        {
            <option value="@facility">@facility</option>
        }
    </select>
</div>

<div class="assigned-events-card">
    <div id="assignedEventsList">
        @foreach (var ev in Model)
        {
            var status = GetStatus(ev.StartDate, ev.StartTime, ev.EndDate, ev.EndTime);
            var facilityText = ev.FacilityNames.Any() ? string.Join(", ", ev.FacilityNames) : "-";
            var searchBlob = $"{ev.EventTitle} {facilityText}".ToLowerInvariant();
            var facilityAttr = string.Join("|", ev.FacilityNames);

            <div class="assigned-event-row"
                 data-search="@searchBlob"
                 data-date="@ev.StartDate.ToString("yyyy-MM-dd")"
                 data-facilities="@facilityAttr">
                <div class="assigned-event-row-inner">

                    <!-- Date badge -->
                    <div class="assigned-event-date-badge">
                        <div class="assigned-event-month">@ev.StartDate.ToString("MMM").ToUpper()</div>
                        <div class="assigned-event-day">@ev.StartDate.Day</div>
                        <div class="assigned-event-weekday">@ev.StartDate.ToString("ddd").ToUpper()</div>
                    </div>

                    <!-- Title + meta + tags -->
                    <div class="flex-grow-1" style="min-width:240px;">
                        <div class="assigned-event-title">@ev.EventTitle</div>

                        <div class="assigned-event-meta">
                            <span>
                                <i class="bi bi-clock"></i>
                                @(ev.StartTime.HasValue ? $"{FormatTime(ev.StartTime)} - {FormatTime(ev.EndTime)}" : "All Day")
                            </span>

                            @if (ev.FacilityNames.Any())
                            {
                                <span class="assigned-event-meta-divider">&bull;</span>
                                <span>
                                    <i class="bi bi-geo-alt"></i>
                                    @facilityText
                                </span>
                            }
                        </div>

                        <div class="assigned-event-subline">
                            <i class="bi bi-person-circle"></i>Created by @ev.SubmittedByName
                        </div>

                        <div>
                            @foreach (var g in ev.GroupNames)
                            {
                                <span class="assigned-event-group-badge">@g</span>
                            }
                        </div>
                    </div>

                    <!-- Status + action -->
                    <div class="assigned-event-actions">
                        <span class="badge assigned-event-status-badge @status.BadgeClass">@status.Text</span>
                        <a asp-action="EventViewScannerDetails"
                           asp-route-id="@ev.EventId"
                           class="assigned-event-details-btn">
                            View Details <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>

                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="assigned-events-empty">
                No events have been assigned to your group yet.
            </div>
        }
    </div>

    <div id="assignedEventsNoResults" class="assigned-events-empty d-none">
        No events match your filters.
    </div>
</div>

<script>
    (function () {
        const searchInput = document.getElementById('assignedEventSearch');
        const dateFilter = document.getElementById('assignedDateFilter');
        const facilityFilter = document.getElementById('assignedFacilityFilter');
        const rows = Array.from(document.querySelectorAll('#assignedEventsList .assigned-event-row[data-date]'));
        const noResults = document.getElementById('assignedEventsNoResults');

        function startOfDay(d) {
            return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        }

        function matchesDateFilter(rowDate, filterValue) {
            if (filterValue === 'all') return true;

            const today = startOfDay(new Date());
            const eventDate = startOfDay(rowDate);

            if (filterValue === 'today') {
                return eventDate.getTime() === today.getTime();
            }

            if (filterValue === 'week') {
                const dayOfWeek = today.getDay(); // 0 = Sunday
                const weekStart = new Date(today);
                weekStart.setDate(today.getDate() - dayOfWeek);
                const weekEnd = new Date(weekStart);
                weekEnd.setDate(weekStart.getDate() + 6);
                return eventDate >= weekStart && eventDate <= weekEnd;
            }

            if (filterValue === 'month') {
                return eventDate.getFullYear() === today.getFullYear() &&
                       eventDate.getMonth() === today.getMonth();
            }

            if (filterValue === 'upcoming') {
                return eventDate.getTime() >= today.getTime();
            }

            if (filterValue === 'past') {
                return eventDate.getTime() < today.getTime();
            }

            return true;
        }

        function applyFilters() {
            const searchTerm = (searchInput.value || '').toLowerCase().trim();
            const dateValue = dateFilter.value;
            const facilityValue = facilityFilter.value;

            let visibleCount = 0;

            rows.forEach(row => {
                const searchBlob = row.dataset.search || '';
                const rowDate = new Date(row.dataset.date + 'T00:00:00');
                const rowFacilities = (row.dataset.facilities || '').split('|');

                const matchesSearch = !searchTerm || searchBlob.includes(searchTerm);
                const matchesDate = matchesDateFilter(rowDate, dateValue);
                const matchesFacility = !facilityValue || rowFacilities.includes(facilityValue);

                const show = matchesSearch && matchesDate && matchesFacility;
                row.classList.toggle('d-none', !show);
                if (show) visibleCount++;
            });

            noResults.classList.toggle('d-none', visibleCount > 0);
        }

        searchInput?.addEventListener('input', applyFilters);
        dateFilter?.addEventListener('change', applyFilters);
        facilityFilter?.addEventListener('change', applyFilters);
    })();
</script>
