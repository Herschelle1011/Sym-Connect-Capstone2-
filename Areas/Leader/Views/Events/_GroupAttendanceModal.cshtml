@model GroupAttendanceDetailsViewModel

<link rel="stylesheet" href="~/css/ViewAttendanceGroupDetails.css" asp-append-version="true" />


<div class="d-flex align-items-center gap-2 mb-3">
    <div style="width:40px;height:40px;border-radius:10px;background:#eef4ff;display:flex;align-items:center;justify-content:center;">
        <i class="bi bi-people-fill" style="color:#4a6cf7;"></i>
    </div>
    <div>
        <h4 class="mb-0 fw-bold">@Model.eventTitle</h4>
        <div class="d-flex align-items-center gap-2">
            <span class="fw-semibold">@Model.GroupName</span>
            <span class="badge status-badge status-@Model.GroupAttendanceStatus.ToString().ToLower()">
                @(Model.GroupAttendanceStatus switch
                {
                    GroupAttendanceStatus.FullyPresent => "Fully Present",
                    GroupAttendanceStatus.PartiallyPresent => "Partially Present",
                    _ => "Absent"
                })
            </span>
        </div>
        <div class="text-muted small">
            @Model.PresentCount of @Model.TotalMembers members attended (@Model.AttendancePercentage%)
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- LEFT: Group Status only (Event Information card removed) -->
    <div class="col-lg-4">
        <div class="details-card">
            <div class="details-card-title">Group Status</div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:70px;height:70px;border-radius:50%;border:6px solid #4a6cf7;display:flex;align-items:center;justify-content:center;font-weight:700;">
                    @Model.AttendancePercentage%
                </div>
                <div>
                    <span class="badge status-badge status-@Model.GroupAttendanceStatus.ToString().ToLower()">
                        @(Model.GroupAttendanceStatus switch
                        {
                            GroupAttendanceStatus.FullyPresent => "Fully Present",
                            GroupAttendanceStatus.PartiallyPresent => "Partially Present",
                            _ => "Absent"
                        })
                    </span>
                    <div class="text-muted small mt-1">Some members of this group have not attended yet.</div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <div class="flex-fill text-center p-2" style="background:#eafbf1;border-radius:8px;">
                    <div class="fw-bold" style="color:#15803d;">@Model.PresentCount</div>
                    <div class="small text-muted">Present</div>
                </div>
                <div class="flex-fill text-center p-2" style="background:#fef7e6;border-radius:8px;">
                    <div class="fw-bold" style="color:#b45309;">@Model.PendingCount</div>
                    <div class="small text-muted">Pending</div>
                </div>
                <div class="flex-fill text-center p-2" style="background:#fdecec;border-radius:8px;">
                    <div class="fw-bold" style="color:#b91c1c;">@Model.AbsentCount</div>
                    <div class="small text-muted">Absent</div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: Members table -->
    <div class="col-lg-8">
        <div class="members-card">

            <div class="members-card-header">
                <div class="members-title">
                    <i class="bi bi-people-fill"></i>
                    <span>Group Members (@Model.TotalMembers)</span>
                </div>

                <div class="aov-toolbar">

                    <div class="aov-search-box">
                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="memberSearch"
                               class="form-control"
                               placeholder="Search member..." />
                    </div>

                    <select id="statusFilter" class="form-select aov-status-filter">
                        <option value="all">All Status</option>
                        <option value="Present">Present</option>
                        <option value="Pending">Pending</option>
                        <option value="Absent">Absent</option>
                    </select>

                </div>
            </div>

            <div class="table-responsive members-table-wrap">
                <table class="table aov-table mb-0"
                       id="attendanceTable">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Member</th>
                            <th>Status</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Remarks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int rowNum = 1;
                        }

                        @foreach (var row in Model.attendanceRowViewModels)
                        {
                            <tr data-status="@row.Status"
                                data-name="@row.FullName.ToLower()">

                                <td>@(rowNum++)</td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <div class="aov-avatar-circle">
                                            @if (!string.IsNullOrEmpty(row.PhotoUrl))
                                            {
                                                <img src="@row.PhotoUrl"
                                                     alt="@row.FullName" />
                                            }
                                            else
                                            {
                                                <span>
                                                    @row.FullName.Substring(0, 1).ToUpper()
                                                </span>
                                            }
                                        </div>

                                        <div>
                                            @row.FullName

                                            @if (row.FullName == Model.GroupLeader)
                                            {
                                                <br />
                                                <small class="text-primary">
                                                    Group Leader
                                                </small>
                                            }
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="aov-status-pill aov-status-pill-@row.Status.ToLower()">
                                        <span class="dot"></span>
                                        @row.Status
                                    </span>
                                </td>

                                <td>
                                    @(row.TimeIn.HasValue
                                        ? row.TimeIn.Value.ToString("h:mm tt")
                                        : "—")
                                </td>

                                <td>
                                    @(row.TimeOut.HasValue
                                        ? row.TimeOut.Value.ToString("h:mm tt")
                                        : "—")
                                </td>

                                <td class="text-muted">
                                    @row.Remarks
                                </td>

                                <td>
                                    <div class="dropdown">

                                        <button class="btn btn-sm btn-light rounded-circle"
                                                data-bs-toggle="dropdown">
                                            <i class="bi bi-chevron-down"></i>
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <span class="dropdown-item-text small text-muted">
                                                    Scanned by: @row.ScanByName
                                                </span>
                                            </li>
                                        </ul>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
</div>

<script>
    (function () {
        var searchInput = document.getElementById('memberSearch');
        var statusFilter = document.getElementById('statusFilter');

        function applyFilters() {
            var query = searchInput.value.trim().toLowerCase();
            var status = statusFilter.value;
            document.querySelectorAll('#attendanceTable tbody tr').forEach(function (row) {
                var matchesStatus = status === 'all' || row.dataset.status === status;
                var matchesSearch = !query || row.dataset.name.indexOf(query) !== -1;
                row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
    })();
</script>
