@using Microsoft.AspNetCore.Identity
@using Sym_Connect__Capstone2_.Models
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SYM-Connect</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sym_Connect__Capstone2_.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ═══════════════════════════════ SIDEBAR ═══════════════════════════════ -->
    @{
        var currentUser = await UserManager.GetUserAsync(User);
        var profilePicture = currentUser?.ProfilePictureUrl;
        var fallbackAvatar =
        $"https://ui-avatars.com/api/?name={User.Identity?.Name ?? "User"}&background=4a6cf7&color=fff&size=34";
    }

    <nav id="sidebar">

        <button id="sidebar-toggle" title="Pin sidebar">
            <i class="bi bi-layout-sidebar-inset"></i>
        </button>

        <div class="sidebar-brand">
            <img src="https://res.cloudinary.com/dxzmz62w4/image/upload/q_auto/f_auto/v1778759822/profiles/8f97c2e0-2fc4-46d0-a8ad-499b0f30e2c1.png"
                 alt="SYM-Connect Logo"
                 onerror="this.src='https://ui-avatars.com/api/?name=SYM&background=4a6cf7&color=fff&size=36'" />
            <span class="sidebar-brand-name">SYM-Connect</span>
        </div>

        <div class="sidebar-nav">

            <a asp-controller="Notifications" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")">
                <i class="bi bi-bell"></i>
                <span class="nav-label">Notifications</span>
                <span class="nav-tooltip">Notifications</span>
            </a>

            <a asp-controller="Home" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="bi bi-grid"></i>
                <span class="nav-label">Dashboard</span>
                <span class="nav-tooltip">Dashboard</span>
            </a>

            @* <a asp-controller="Events" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")">
                <i class="bi bi-calendar-event"></i>
                <span class="nav-label">Events</span>
                <span class="nav-tooltip">Events</span>
            </a> *@

            <a asp-controller="Evaluations" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evaluations" ? "active" : "")">
                <i class="bi bi-star-half"></i>
                <span class="nav-label">Evaluations</span>
                <span class="nav-tooltip">Evaluations</span>
            </a>

        </div>

        <div class="sidebar-bottom">

            <a asp-controller="Profile" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
                <i class="bi bi-person-circle"></i>
                <span class="nav-label">Profile</span>
                <span class="nav-tooltip">Profile</span>
            </a>

            <a asp-controller="Help" asp-action="Index"
               class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Help" ? "active" : "")">
                <i class="bi bi-question-circle"></i>
                <span class="nav-label">Help</span>
                <span class="nav-tooltip">Help</span>
            </a>

            <a asp-controller="Account" asp-action="Logout"
               asp-route-returnUrl="@Url.Action("Account", "Login")"
               class="nav-item"
               onclick="return confirm('Are you sure you want to logout?')">
                <i class="bi bi-box-arrow-right"></i>
                <span class="nav-label">Logout</span>
                <span class="nav-tooltip">Logout</span>
            </a>

        </div>

        <div class="sidebar-user">
            <img src="@(string.IsNullOrEmpty(profilePicture) ? fallbackAvatar : profilePicture)"
                 alt="User Avatar" />
            <div class="sidebar-user-info">
                <div class="sidebar-user-name">@(User.Identity?.Name ?? "Guest")</div>
                <div class="sidebar-user-role">Member</div>
            </div>
            <i class="bi bi-chevron-down sidebar-user-chevron"></i>
        </div>

    </nav>
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <div id="main-content">
        <div class="content-wrapper">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebar-toggle');

        if (localStorage.getItem('sidebarPinned') === 'true') {
        sidebar.classList.add('expanded');
        toggleBtn.innerHTML = '<i class="bi bi-layout-sidebar"></i>';
        }

        toggleBtn.addEventListener('click', () => {
        const isPinned = sidebar.classList.toggle('expanded');
        localStorage.setItem('sidebarPinned', isPinned);
        toggleBtn.innerHTML = isPinned
        ? '<i class="bi bi-layout-sidebar"></i>'
        : '<i class="bi bi-layout-sidebar-inset"></i>';
        });
    </script>

    <partial name="_Modal" />
</body>
</html>