@{
    ViewData["Title"] = "Already Submitted";
    Layout = "_MemberLayout";
}
<div class="container text-center py-5">
    <i class="bi bi-info-circle-fill text-primary" style="font-size: 3.5rem;"></i>
    <h3 class="mt-3 fw-bold">You've already submitted this evaluation</h3>
    <p class="text-muted">Thanks again for your feedback — no need to fill it out twice.</p>
    <a asp-area="Member" asp-controller="Evaluation" asp-action="Index" class="btn btn-primary mt-3 rounded-pill px-4">
        Back to Evaluations
    </a>
</div>