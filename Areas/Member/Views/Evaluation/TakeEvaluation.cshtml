@using Sym_Connect__Capstone2_.Areas.Member.ViewModels.Evaluation
@model TakeEvaluationViewModel
@{
    ViewData["Title"] = Model.EvaluationTitle;
    Layout = "_MemberLayout";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2">
        <i class="bi bi-check-circle"></i> @TempData["Message"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<div class="container py-4" style="max-width: 800px;">

    <div class="eval-header-card">
        <h2 class="fw-bold mb-1">@Model.EvaluationTitle</h2>
        <p class="mb-0" style="opacity:0.9;">Tell us how the event went — it takes about 2 minutes.</p>
    </div>

    <div class="card eval-detail-card mb-4">
        <div class="card-body">
            <h6 class="fw-semibold mb-3 text-muted" style="font-size:13px; letter-spacing:0.5px;">YOUR DETAILS</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Full name</label>
                    <input type="text" class="form-control bg-light" value="@Model.MemberFullName" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Email</label>
                    <input type="email" class="form-control bg-light" value="@Model.MemberEmail" readonly />
                </div>
            </div>
        </div>
    </div>

    <form asp-action="TakeEvaluation" method="post">
        <input type="hidden" name="EvaluationId" value="@Model.EvaluationId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <input type="hidden" name="Answers[@i].EvaluationDetailId" value="@q.EvaluationDetailId" />

            <div class="card eval-question-card mb-3">
                <div class="card-body d-flex gap-3">
                    <span class="eval-question-number">@(i + 1)</span>

                    <div class="flex-grow-1">
                        <p class="fw-semibold mb-2">@q.QuestionText</p>

                        @if (q.AnswerType == Sym_Connect__Capstone2_.Models.Enums.AnswerType.RatingScale)
                        {
                            <div class="d-flex gap-3 star-rating" data-index="@i">
                                @for (int star = 1; star <= 5; star++)
                                {
                                    <label class="text-center">
                                        <input type="radio" name="Answers[@i].Answer" value="@star" class="d-none star-input" />
                                        <i class="bi bi-star fs-3 star-icon" data-value="@star"></i>
                                        <div class="small text-muted">@(star == 1 ? "Very Poor" : star == 5 ? "Excellent" : star.ToString())</div>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <textarea name="Answers[@i].Answer" class="form-control" rows="3" maxlength="500"
                                      placeholder="Type your answer here..."></textarea>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-2 mt-4 mb-5">
            <button type="submit" name="IsFinalSubmit" value="true" class="btn btn-primary">
                <i class="bi bi-send"></i> Submit Feedback
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.star-rating').forEach(group => {
            const icons = group.querySelectorAll('.star-icon');
            icons.forEach(icon => {
                icon.addEventListener('click', () => {
                    const value = parseInt(icon.dataset.value);
                    const radio = group.querySelector(`input[value="${value}"]`);
                    radio.checked = true;

                    icons.forEach(i => {
                        i.classList.toggle('bi-star-fill', parseInt(i.dataset.value) <= value);
                        i.classList.toggle('bi-star', parseInt(i.dataset.value) > value);
                    });
                });
            });
        });

                document.querySelector('form').addEventListener('submit', function (e) {
            let hasError = false;

            document.querySelectorAll('.eval-question-card').forEach(function (card) {
                const textarea = card.querySelector('textarea');
                const radios = card.querySelectorAll('input[type="radio"]');

                let answered = true;

                if (textarea) {
                    answered = textarea.value.trim() !== '';
                } else if (radios.length > 0) {
                    answered = Array.from(radios).some(r => r.checked);
                }

                card.classList.toggle('has-error', !answered);

                if (!answered) hasError = true;
            });

            if (hasError) {
                e.preventDefault(); // stop the form from submitting
            }
        });

                document.querySelectorAll('.eval-question-card').forEach(function (card) {
            card.addEventListener('input', function () {
                const textarea = card.querySelector('textarea');
                const radios = card.querySelectorAll('input[type="radio"]');

                let answered = textarea
                    ? textarea.value.trim() !== ''
                    : Array.from(radios).some(r => r.checked);

                if (answered) card.classList.remove('has-error');
            });
        });
    </script>
}