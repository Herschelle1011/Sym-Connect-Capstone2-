@{
    ViewData["Title"] = "Thank You";
    Layout = "_MemberLayout";

    int pointsEarned = 0;

    if (TempData["PointsEarned"] != null)
    {
        pointsEarned =
            Convert.ToInt32(
                TempData["PointsEarned"]
            );
    }
}

<div class="container text-center py-5">

    <i class="bi bi-check-circle-fill text-success"
       style="font-size: 3.5rem;">
    </i>

    <h3 class="mt-3 fw-bold">
        Thank you for your feedback!
    </h3>

    <p class="text-muted">
        Your response has been recorded.
    </p>

    @if (pointsEarned > 0)
    {
        <div class="points-earned-card mx-auto mt-4">

            <div class="points-earned-icon">
                <i class="bi bi-stars"></i>
            </div>

            <div class="points-earned-content">

                <span class="points-earned-label">
                    Points Earned
                </span>

                <strong class="points-earned-value">
                    +@pointsEarned points
                </strong>

            </div>

        </div>
    }

    <a asp-area="Member"
       asp-controller="Evaluation"
       asp-action="Index"
       class="btn btn-primary mt-4 rounded-pill px-4">

        Back to Evaluations

    </a>

</div>

<style>

    .points-earned-card {
        max-width: 320px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        background: #F5F8FF;
        border: 1px solid #DCE7FF;
        border-radius: 12px;
    }

    .points-earned-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #E8F0FF;
        font-size: 21px;
        color: #2F6FED;
    }

    .points-earned-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .points-earned-label {
        font-size: 13px;
        color: #6B7280;
    }

    .points-earned-value {
        font-size: 20px;
        color: #2F6FED;
    }

</style>