<div class="text-center px-3 py-4">

    <div class="restored-icon mx-auto mb-3">
        <i class="bi bi-calendar-check"></i>
    </div>

    <h5 class="fw-bold mb-2">
        Event Restored
    </h5>

    <p class="text-muted mb-2">
        The event
        <strong class="text-dark">
            "@ViewBag.EventTitle"
        </strong>
        was previously cancelled.
    </p>

    <p class="text-muted mb-4">
        This event has been restored and is now active again.
    </p>

    <div class="d-flex justify-content-center gap-2">

        <button type="button"
                class="btn btn-light"
                data-bs-dismiss="modal">
            Close
        </button>

        <a asp-area="Member"
           asp-controller="Events"
           asp-action="Index"
           asp-route-openEventId="@ViewBag.EventId"
           class="btn btn-primary">
            View Event
        </a>

    </div>

</div>

<style>
    .restored-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #eaf1fe;
        color: #3d6de0;
        font-size: 1.6rem;
    }
</style>