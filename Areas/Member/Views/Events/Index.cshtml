@model Sym_Connect__Capstone2_.Areas.Member.ViewModels.Events.MemberEventsViewModel

@{
    ViewData["Title"] = "Events Schedule";
    Layout = "_MemberLayout";
}

@section Styles {
    <style>
        .events-page {
            padding: 28px 32px;
        }

        /* =========================
                   HEADER
                ========================== */

        .events-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 10px;
        }

        .events-title {
            margin: 0;
            font-size: 1.75rem;
            font-weight: 700;
            color: #202a35;
        }

        /* =========================
                   GROUP CARD
                ========================== */

        .member-group-card {
            min-width: 195px;
            background: #0d91e8;
            color: white;
            border-radius: 11px;
            padding: 11px 16px;
            display: flex;
            align-items: center;
            gap: 11px;
            text-decoration: none;
            transition: transform .15s ease;
        }

            .member-group-card:hover {
                color: white;
                transform: translateY(-1px);
            }

        .group-icon {
            font-size: 1.7rem;
        }

        .group-label {
            display: block;
            font-size: .65rem;
            margin-bottom: 1px;
        }

        .group-name {
            font-size: 1.15rem;
            font-weight: 600;
            line-height: 1.1;
        }

        .group-members {
            display: block;
            font-size: .62rem;
            margin-top: 3px;
        }

        .group-arrow {
            margin-left: auto;
            font-size: 1.1rem;
        }

        /* =========================
                   TOOLBAR
                ========================== */

        .events-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .event-filters {
            display: inline-flex;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }

        .event-filter-btn {
            border: none;
            background: transparent;
            color: #343d49;
            padding: 8px 20px;
            font-size: .82rem;
            font-weight: 600;
        }

            .event-filter-btn.active {
                background: #078ed4;
                color: white;
                border-radius: 9px;
            }

        /* =========================
                   EVENT LIST
                ========================== */

        .events-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .member-event-card {
            display: grid;
            grid-template-columns: 150px 1fr 70px;
            align-items: stretch;
            background: #fff;
            border: 1px solid #e5e9ee;
            border-radius: 13px;
            overflow: hidden;
            min-height: 112px;
            cursor: pointer;
            transition: box-shadow .15s ease, transform .15s ease;
        }

            .member-event-card:hover {
                transform: translateY(-1px);
                box-shadow: 0 5px 16px rgba(0, 0, 0, .06);
            }

        /* =========================
                   EVENT IMAGE
                ========================== */

        .event-image-wrapper {
            padding: 7px;
        }

        .event-image {
            width: 100%;
            height: 98px;
            object-fit: cover;
            border-radius: 10px;
        }

        .event-image-placeholder {
            width: 100%;
            height: 98px;
            border-radius: 10px;
            background: #edf2f6;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #9aa5b1;
            font-size: 1.7rem;
        }

        /* =========================
                   EVENT INFORMATION
                ========================== */

        .event-info {
            padding: 13px 14px;
        }

        .event-title-row {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .event-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: #27313d;
        }

        .event-status {
            display: inline-flex;
            align-items: center;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: .62rem;
            font-weight: 600;
        }

        .status-ongoing {
            background: #d9f3e4;
            color: #278450;
        }

        .status-upcoming {
            background: #dcf3ff;
            color: #1689c6;
        }

        .status-completed {
            background: #eceff2;
            color: #727b84;
        }

        .event-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 22px;
            margin-top: 13px;
            color: #65707d;
            font-size: .78rem;
            font-weight: 500;
        }

        .event-meta-item {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .event-host {
            margin-top: 12px;
            color: #078ed4;
            font-size: .68rem;
            font-weight: 600;
        }

        /* =========================
                   DATE BOX
                ========================== */

        .event-date-container {
            display: flex;
            align-items: center;
            justify-content: center;
            padding-right: 14px;
        }

        .event-date-box {
            width: 58px;
            height: 76px;
            border-radius: 12px;
            background: #ddf4ff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #078ed4;
        }

        .event-date-day {
            font-size: 1.3rem;
            line-height: 1;
            font-weight: 700;
        }

        .event-date-month {
            margin-top: 5px;
            font-size: .76rem;
            font-weight: 700;
        }

        /* =========================
                   EMPTY STATE
                ========================== */

        .events-empty {
            background: #fff;
            border: 1px solid #e5e9ee;
            border-radius: 12px;
            text-align: center;
            padding: 50px 20px;
            color: #7a8591;
        }

            .events-empty i {
                display: block;
                font-size: 2rem;
                margin-bottom: 10px;
            }

        /* =========================
                   RESPONSIVE
                ========================== */

        @@media (max-width: 768px) {

            .events-page {
                padding: 20px 15px;
            }

            .events-header {
                flex-direction: column;
            }

            .member-group-card {
                width: 100%;
            }

            .member-event-card {
                grid-template-columns: 105px 1fr;
            }

            .event-date-container {
                display: none;
            }

            .event-meta {
                gap: 10px;
            }
        }
    </style>
}


<div class="events-page">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="events-header">

        <div>
            <h1 class="events-title">
                Events Schedule
            </h1>
        </div>


        @if (Model.GroupId.HasValue)
        {
            <a asp-action="Index" asp-controller="MyGroup" asp-area="Member"
               class="member-group-card">

                <i class="bi bi-people group-icon"></i>

                <div>
                    <span class="group-label">
                        Your group
                    </span>

                    <div class="group-name">
                        @Model.GroupName
                    </div>

                    <span class="group-members">
                        @Model.GroupMemberCount members
                    </span>
                </div>

                <i class="bi bi-chevron-right group-arrow"></i>

            </a>
        }

    </div>


    <!-- =========================================
         FILTERS
    ========================================== -->

    <div class="events-toolbar">

        <div class="event-filters">

            <button type="button"
                    class="event-filter-btn active"
                    data-filter="all">
                All
            </button>

            <button type="button"
                    class="event-filter-btn"
                    data-filter="upcoming">
                Upcoming
            </button>

            <button type="button"
                    class="event-filter-btn"
                    data-filter="ongoing">
                Ongoing
            </button>

        </div>

    </div>


    <!-- =========================================
         EVENTS
    ========================================== -->

    <div class="events-list"
         id="memberEventsList">

        @if (Model.Events != null && Model.Events.Any())
        {
            foreach (var ev in Model.Events)
            {
                string statusClass = ev.Status.ToLower() switch
                {
                    "ongoing" => "status-ongoing",
                    "upcoming" => "status-upcoming",
                    _ => "status-completed"
                };


                <div class="member-event-card"
                    role="button"
                     data-event-id="@ev.EventId"
                     data-status="@ev.Status.ToLower()">


                    <!-- =====================
                         FACILITY IMAGE
                    ====================== -->

                    <div class="event-image-wrapper">

                        @if (!string.IsNullOrWhiteSpace(ev.FacilityPhotoUrl))
                        {
                            <img src="@ev.FacilityPhotoUrl"
                                 class="event-image"
                                 alt="@ev.EventTitle" />
                        }
                        else
                        {
                            <div class="event-image-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                        }

                    </div>


                    <!-- =====================
                         EVENT INFORMATION
                    ====================== -->

                    <div class="event-info">

                        <div class="event-title-row">

                            <h5 class="event-title">
                                @ev.EventTitle
                            </h5>

                            <span class="event-status @statusClass">
                                @ev.Status
                            </span>

                        </div>


                        <div class="event-meta">

                            <!-- TIME -->

                            <div class="event-meta-item">

                                <i class="bi bi-clock"></i>

                                @if (ev.IsAllDay)
                                {
                                    <span>All day</span>
                                }
                                else
                                {
                                    <span>
                                        @(ev.StartTime.HasValue
                                            ? DateTime.Today
                                                .Add(ev.StartTime.Value)
                                                .ToString("h:mm tt")
                                            : "")

                                        -

                                        @(ev.EndTime.HasValue
                                            ? DateTime.Today
                                                .Add(ev.EndTime.Value)
                                                .ToString("h:mm tt")
                                            : "")
                                    </span>
                                }

                            </div>


                            <!-- FACILITIES -->

                            <div class="event-meta-item">

                                <i class="bi bi-geo-alt"></i>

                                @if (ev.FacilityName != null &&
                                     ev.FacilityName.Any())
                                {
                                    <span>
                                        @string.Join(", ", ev.FacilityName)
                                    </span>
                                }
                                else
                                {
                                    <span>No facility</span>
                                }

                            </div>

                        </div>


                        <!-- HOST -->

                        <div class="event-host">

                            Hosted by

                            @if (ev.HostedByRole == "Admin")
                            {
                                <span>ADMIN</span>
                            }
                            else
                            {
                                <span>
                                    @ev.HostedByName.ToUpper()
                                </span>
                            }

                        </div>

                    </div>


                    <!-- =====================
                         DATE
                    ====================== -->

                    <div class="event-date-container">

                        <div class="event-date-box">

                            <span class="event-date-day">
                                @ev.StartDate.Day
                            </span>

                            <span class="event-date-month">
                                @ev.StartDate.ToString("MMM")
                            </span>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="events-empty">

                <i class="bi bi-calendar-event"></i>

                <div>
                    No events assigned to your group.
                </div>

            </div>
        }

    </div>

</div>



<div class="modal fade"
     id="memberEventDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content event-details-modal">

            <div id="memberEventDetailsContent">
                <!-- Event details loaded here -->
            </div>

        </div>
    </div>

</div>



@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const filterButtons = document.querySelectorAll(".event-filter-btn");
            const eventCards = document.querySelectorAll(".member-event-card");
            const modalElement = document.getElementById("memberEventDetailsModal");
            const modalContent = document.getElementById("memberEventDetailsContent");

            const eventDetailsUrl = '@Url.Action("EventDetails", "Events", new { area = "Member" })';


            // =====================================
            // FILTER EVENTS
            // =====================================

            filterButtons.forEach(function (button) {
                button.addEventListener("click", function () {

                    const selectedFilter = button.dataset.filter;

                    filterButtons.forEach(btn => btn.classList.remove("active"));
                    button.classList.add("active");

                    eventCards.forEach(function (card) {
                        const show =
                            selectedFilter === "all" ||
                            card.dataset.status === selectedFilter;

                        card.style.display = show ? "" : "none";
                    });
                });
            });


            // =====================================
            // OPEN EVENT DETAILS MODAL (single loader)
            // =====================================

            async function openEventDetailsModal(eventId) {

                if (!eventId) {
                    return;
                }

                modalContent.innerHTML = `
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="mt-3 text-muted small">Loading event details...</div>
                    </div>
                `;

                bootstrap.Modal.getOrCreateInstance(modalElement).show();

                try {

                    const response = await fetch(
                        eventDetailsUrl + "?id=" + encodeURIComponent(eventId),
                        {
                            method: "GET",
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        }
                    );

                    if (!response.ok) {
                        throw new Error("Unable to load event details.");
                    }

                    modalContent.innerHTML = await response.text();

                    wirePhotoStrip();

                }
                catch (error) {

                    console.error("Event details error:", error);

                    modalContent.innerHTML = `
                        <div class="text-center py-5 px-4">
                            <i class="bi bi-exclamation-circle text-danger fs-2"></i>
                            <h6 class="mt-3 mb-1">Unable to load event</h6>
                            <p class="text-muted small mb-0">Please try again.</p>
                        </div>
                    `;
                }
            }


            // =====================================
            // PHOTO STRIP ARROWS
            // =====================================

            function wirePhotoStrip() {

                const strip = modalContent.querySelector("#eventPhotoStrip");

                if (!strip) {
                    return;
                }

                const prevBtn = modalContent.querySelector(".event-strip-btn.prev");
                const nextBtn = modalContent.querySelector(".event-strip-btn.next");

                if (prevBtn) {
                    prevBtn.addEventListener("click", function () {
                        strip.scrollBy({ left: -strip.clientWidth, behavior: "smooth" });
                    });
                }

                if (nextBtn) {
                    nextBtn.addEventListener("click", function () {
                        strip.scrollBy({ left: strip.clientWidth, behavior: "smooth" });
                    });
                }
            }


            // =====================================
            // EVENT CARD CLICK
            // =====================================

            eventCards.forEach(function (card) {
                card.addEventListener("click", function () {
                    openEventDetailsModal(card.dataset.eventId);
                });
            });


            // =====================================
            // OPEN FROM ?openEventId=  (notifications, redirects)
            // =====================================

            const params = new URLSearchParams(window.location.search);
            const openEventId = params.get("openEventId");

            if (openEventId) {

                openEventDetailsModal(openEventId);

                // Remove the parameter so a refresh doesn't reopen the modal
                params.delete("openEventId");

                const newUrl =
                    window.location.pathname +
                    (params.toString() ? "?" + params.toString() : "");

                window.history.replaceState({}, "", newUrl);
            }

        });
    </script>

}