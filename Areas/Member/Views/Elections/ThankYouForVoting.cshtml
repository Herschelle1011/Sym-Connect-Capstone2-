@{
    ViewData["Title"] = "Thank You";
    Layout = "_MemberLayout";
}

<div class="container text-center py-5">
    <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
    <h3 class="mt-3 fw-bold">Thank you for your Vote!</h3>
    <p class="text-muted">Your vote has been recorded.</p>
    <a asp-area="Member" asp-controller="Evaluation" asp-action="Index" class="btn btn-primary mt-3 rounded-pill px-4">
        Back to Evaluations
    </a>
</div>