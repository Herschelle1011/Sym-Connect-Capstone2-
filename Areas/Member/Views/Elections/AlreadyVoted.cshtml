@{
    ViewData["Title"] = "Already Voted";
    Layout = "_MemberLayout";
}
<div class="container text-center py-5">
    <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i> 
    <h3 class="mt-3 fw-bold">You've already voted this election</h3>
    <p class="text-muted">Thanks again for your Vote — no need to vote twice.</p>
    <a asp-area="Member" asp-controller="Elections" asp-action="Index" class="btn btn-primary mt-3 rounded-pill px-4">
        Back to Election Page
    </a>
</div>