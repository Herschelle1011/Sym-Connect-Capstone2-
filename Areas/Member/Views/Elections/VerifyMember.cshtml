@* @{
    ViewData["Title"] = "Verify Your Identity";
    Layout = "_MemberLayout";

}

<div class="verify-wrapper d-flex align-items-center justify-content-center min-vh-100">
    <div class="verify-card shadow-sm">

        <div class="text-center mb-4">
            <div class="verify-icon mb-3">
                <i class="bi bi-shield-check"></i>
            </div>
            <h3 class="fw-bold mb-1">Verify Your Identity</h3>
            <p class="text-muted mb-0">Enter your details to access available evaluations.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2">
                <i class="bi bi-exclamation-circle"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div class="small">@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form method="post">

            <input type="hidden"
                   name="electionId"
                   value="@ViewBag.ElectionId" />

            <div class="mb-3">
                <label class="form-label fw-semibold">First Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-person text-muted"></i>
                    </span>
                    <input type="text" name="firstName" class="form-control border-start-0 ps-0"
                           placeholder="Enter your first name" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input type="email" name="email" class="form-control border-start-0 ps-0"
                           placeholder="Enter your email" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                Continue <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>

    </div>
</div>

<style>
    .verify-wrapper {
        background-color: #f4f6fb;
    }

    .verify-card {
        background: #fff;
        border-radius: 16px;
        padding: 2.5rem;
        width: 100%;
        max-width: 420px;
    }

    .verify-icon {
        width: 56px;
        height: 56px;
        background: #e8edff;
        color: #4a6cf7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto;
    }

    .verify-card .input-group-text {
        border-color: #dee2e6;
    }

    .verify-card .form-control {
        border-color: #dee2e6;
    }

        .verify-card .form-control:focus {
            box-shadow: none;
            border-color: #4a6cf7;
        }

    .verify-card .input-group:focus-within .input-group-text,
    .verify-card .input-group:focus-within .form-control {
        border-color: #4a6cf7;
    }

    .verify-card .btn-primary {
        background-color: #4a6cf7;
        border-color: #4a6cf7;
        border-radius: 8px;
    }

        .verify-card .btn-primary:hover {
            background-color: #3a5ce0;
            border-color: #3a5ce0;
        }
</style> *@