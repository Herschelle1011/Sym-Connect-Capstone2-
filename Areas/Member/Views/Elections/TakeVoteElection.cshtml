@model TakeVoteViewModel

@{
    ViewData["Title"] = "Cast Your Vote";
    Layout = null;

    var ballot = ViewBag.BallotLayout as List<PositionBallot>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Cast Your Vote</title>

    <!-- Bootstrap because Layout = null -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: #f5f7fb;
                color: #111827;
            }

            .voting-page {
                max-width: 1400px;
                margin: 0 auto;
                padding: 55px 60px;
            }

            .voting-header {
                margin-bottom: 28px;
            }

            .voting-title {
                margin: 0;
                font-size: 36px;
                font-weight: 700;
            }

            .voting-subtitle {
                margin-top: 5px;
                color: #6b7280;
                font-size: 14px;
            }

            .ballot-card {
                background: #fff;
                border-radius: 18px;
                padding: 35px;
                box-shadow: 0 2px 10px rgba(0, 0, 0, .06);
            }

            .position-count {
                text-align: center;
                color: #6b7280;
                font-size: 13px;
                margin-bottom: 4px;
            }

            .position-name {
                text-align: center;
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 35px;
            }

            .candidate-container {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 40px;
            }

            .candidate-option {
                cursor: pointer;
                text-align: center;
            }

            .candidate-images {
                display: flex;
                justify-content: center;
                gap: 10px;
            }

            .candidate-photo {
                width: 160px;
                height: 160px;
                object-fit: cover;
                cursor: pointer;
                border: 4px solid transparent;
                border-radius: 50%;
                transition: .18s ease;
            }

            .candidate-option:hover .candidate-photo {
                transform: translateY(-3px);
            }

            .candidate-option:has(.candidate-radio:checked)
            .candidate-photo {
                border-color: #0d6efd;
                box-shadow: 0 0 0 5px rgba(13, 110, 253, .12);
            }

            .candidate-name {
                margin-top: 12px;
                font-size: 16px;
                font-weight: 600;
            }

            .party-name {
                margin-top: 2px;
                color: #6b7280;
                font-size: 13px;
            }

            .ballot-footer {
                margin-top: 40px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .step-text {
                color: #6b7280;
                font-size: 13px;
            }

            .ballot-actions {
                display: flex;
                gap: 10px;
            }

            .ballot-btn {
                border-radius: 999px;
                padding: 10px 26px;
                font-size: 14px;
                font-weight: 600;
            }

            @@media (max-width: 768px) {

                .voting-page {
                    padding: 30px 18px;
                }

                .voting-title {
                    font-size: 28px;
                }

                .ballot-card {
                    padding: 25px 18px;
                }

                .candidate-photo {
                    width: 120px;
                    height: 120px;
                }

                .ballot-footer {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 20px;
                }

                .ballot-actions {
                    justify-content: flex-end;
                }
            }
    </style>
</head>

<body>

    <div class="voting-page">

        <div class="voting-header">
            <h1 class="voting-title">
                Cast Your Vote
            </h1>

            <p class="voting-subtitle">
                Vote for your future leaders
            </p>
        </div>


        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        @if (ballot == null || ballot.Count == 0)
        {
            <div class="alert alert-warning">
                No ballot is currently available.
            </div>
        }
        else
        {
            <form asp-action="TakeVoteElection"
                  method="post"
                  id="ballotForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="electionId" />

                <input type="hidden"
                       asp-for="memberId" />


                <div class="ballot-card">

                    @for (int i = 0; i < ballot.Count; i++)
                    {
                        var position = ballot[i];

                        <div class="ballot-slide"
                             data-index="@i"
                             style="display:@(i == 0 ? "block" : "none")">

                            <div class="position-count">
                                Position @(i + 1) of @ballot.Count
                            </div>

                            <div class="position-name">
                                @position.positionName.ToString().ToUpper()
                            </div>


                            <input type="hidden"
                                   asp-for="selectedVotes[i].positionId"
                                   value="@position.PositionId" />


                            <div class="candidate-container">

                                @foreach (var ticket in position.Tickets)
                                {
                                    <label class="candidate-option">

                                        <input type="radio"
                                               name="selectedVotes[@i].CandidateId"
                                               value="@ticket.candidates[0].CandidateId"
                                               class="candidate-radio d-none" />

                                        <div class="candidate-images">

                                            @foreach (var member in ticket.candidates)
                                            {
                                                <img src="@member.PhotoUrl"
                                                     class="candidate-photo"
                                                     alt="@member.MemberName" />
                                            }

                                        </div>


                                        <div class="candidate-name">

                                            @string.Join(
                                                " & ",
                                                ticket.candidates
                                                    .Select(m => m.MemberName)
                                            )

                                        </div>

                                        <div class="party-name">
                                            @ticket.PartyListName
                                        </div>

                                    </label>
                                }

                            </div>


                            <div class="ballot-footer">

                                <span class="step-text">
                                    Step @(i + 1) of @ballot.Count
                                </span>


                                <div class="ballot-actions">

                                    @if (i > 0)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary ballot-btn back-btn"
                                                data-index="@i">

                                            <i class="bi bi-arrow-left"></i>
                                            Back

                                        </button>
                                    }


                                    @if (i == ballot.Count - 1)
                                    {
                                        <button type="submit"
                                                class="btn btn-primary ballot-btn"
                                                id="submitBallotBtn"
                                                style="display:none;">

                                            <span class="submit-text">
                                                Submit Ballot
                                            </span>

                                            <span class="submit-loading d-none">

                                                <span class="spinner-border spinner-border-sm me-1">
                                                </span>

                                                Submitting...

                                            </span>

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-primary ballot-btn next-btn"
                                                data-index="@i"
                                                style="display:none;">

                                            Next
                                            <i class="bi bi-arrow-right"></i>

                                        </button>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </form>
        }

    </div>


    <script>

            const slides =
                document.querySelectorAll('.ballot-slide');

            let current = 0;


            function toggleActionButton() {

                if (slides.length === 0) {
                    return;
                }

                const currentSlide = slides[current];

                const answered =
                    currentSlide.querySelector(
                        '.candidate-radio:checked'
                    ) !== null;

                const isLast =
                    current === slides.length - 1;


                if (isLast) {

                    const submitBtn =
                        document.getElementById('submitBallotBtn');

                    if (submitBtn) {

                        submitBtn.style.display =
                            answered
                                ? 'inline-block'
                                : 'none';
                    }

                }
                else {

                    const nextBtn =
                        currentSlide.querySelector('.next-btn');

                    if (nextBtn) {

                        nextBtn.style.display =
                            answered
                                ? 'inline-block'
                                : 'none';
                    }
                }
            }


            document
                .querySelectorAll('.candidate-radio')
                .forEach(function (radio) {

                    radio.addEventListener(
                        'change',
                        function () {

                            toggleActionButton();
                        }
                    );
                });


            document
                .querySelectorAll('.next-btn')
                .forEach(function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            const index =
                                parseInt(button.dataset.index);

                            goToSlide(index + 1);
                        }
                    );
                });


            document
                .querySelectorAll('.back-btn')
                .forEach(function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            const index =
                                parseInt(button.dataset.index);

                            goToSlide(index - 1);
                        }
                    );
                });


            function goToSlide(index) {

                if (index < 0 || index >= slides.length) {
                    return;
                }

                slides[current].style.display = 'none';

                current = index;

                slides[current].style.display = 'block';

                toggleActionButton();
            }


            const ballotForm =
                document.getElementById('ballotForm');


            if (ballotForm) {

                ballotForm.addEventListener(
                    'submit',
                    function () {

                        const submitBtn =
                            document.getElementById(
                                'submitBallotBtn'
                            );

                        if (!submitBtn) {
                            return;
                        }

                        submitBtn.disabled = true;

                        const text =
                            submitBtn.querySelector(
                                '.submit-text'
                            );

                        const loading =
                            submitBtn.querySelector(
                                '.submit-loading'
                            );

                        if (text) {
                            text.classList.add('d-none');
                        }

                        if (loading) {
                            loading.classList.remove('d-none');
                        }
                    }
                );
            }

    </script>

</body>
</html>