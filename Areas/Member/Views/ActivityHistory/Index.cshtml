@model Sym_Connect__Capstone2_.ViewModels.ActivityHistoryViewModel.ActivityHistoryViewModel

@{
    ViewData["Title"] = "Activity History";
    Layout = "_MemberLayout";

    var groupedActivities = Model.Activities
        .GroupBy(a => new
        {
            a.Date.Year,
            a.Date.Month
        })
        .OrderByDescending(g => g.Key.Year)
        .ThenByDescending(g => g.Key.Month);
}

@section Styles {
    <style>

        /* =========================================
                   PAGE
                ========================================= */

        .history-page {
            padding: 28px;
            background: #f8fafc;
            min-height: 100vh;
        }

        .history-container {
            max-width: 1500px;
            margin: 0 auto;
        }


        /* =========================================
                   HEADER
                ========================================= */

        .history-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        .history-header-left {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .history-back {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid #e5e7eb;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            text-decoration: none;
            flex-shrink: 0;
            transition: 0.2s ease;
        }

            .history-back:hover {
                background: #eff6ff;
                color: #1d4ed8;
            }

        .history-title {
            font-size: 24px;
            font-weight: 700;
            color: #172033;
            margin: 0 0 5px 0;
        }

        .history-subtitle {
            font-size: 13px;
            color: #7b8495;
            margin: 0;
        }


        /* HEADER TIP */

        .history-tip {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-right: 20px;
        }

        .history-tip-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: #eaf5ff;
            color: #2997f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .history-tip-title {
            font-size: 12px;
            font-weight: 700;
            color: #344054;
            margin-bottom: 2px;
        }

        .history-tip-text {
            font-size: 11px;
            line-height: 1.45;
            color: #8992a3;
            max-width: 155px;
        }


        /* =========================================
                   FILTER BAR
                ========================================= */

        .history-toolbar {
            background: white;
            border: 1px solid #edf0f4;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.025);
        }

        .history-tabs {
            display: flex;
            align-items: center;
            gap: 4px;
            background: #f7f9fc;
            padding: 4px;
            border-radius: 7px;
        }

        .history-tab {
            min-width: 92px;
            padding: 8px 18px;
            border: none;
            background: transparent;
            color: #667085;
            font-size: 12px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s ease;
        }

            .history-tab:hover {
                color: #2563eb;
            }

            .history-tab.active {
                background: #2f80ed;
                color: white;
                box-shadow: 0 2px 5px rgba(47, 128, 237, 0.22);
            }


        /* RIGHT SIDE */

        .history-toolbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .history-search {
            position: relative;
            width: 290px;
        }

            .history-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: #98a2b3;
                font-size: 13px;
            }

            .history-search input {
                width: 100%;
                height: 38px;
                border: 1px solid #e4e7ec;
                border-radius: 7px;
                outline: none;
                padding: 0 13px 0 38px;
                font-size: 12px;
                color: #344054;
                background: white;
            }

                .history-search input:focus {
                    border-color: #84adff;
                    box-shadow: 0 0 0 3px rgba(47, 128, 237, 0.08);
                }

                .history-search input::placeholder {
                    color: #98a2b3;
                }


        /* =========================================
                   MONTH GROUP
                ========================================= */

        .history-month {
            margin-bottom: 20px;
        }

        .history-month-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 9px;
        }

        .history-month-title {
            font-size: 14px;
            font-weight: 700;
            color: #344054;
            margin: 0;
        }

        .history-month-count {
            background: #eef2f6;
            color: #667085;
            padding: 4px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 500;
        }


        /* =========================================
                   ACTIVITY ROW
                ========================================= */

        .history-item {
            display: grid;
            grid-template-columns: minmax(280px, 2.2fr) minmax(135px, 1fr) minmax(150px, 1.1fr) minmax(150px, 1.1fr) 110px 25px;
            align-items: center;
            gap: 15px;
            min-height: 67px;
            background: white;
            border: 1px solid #e9edf2;
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 7px;
            transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
        }

            .history-item:hover {
                border-color: #d8e3f3;
                box-shadow: 0 4px 12px rgba(16, 24, 40, 0.05);
                transform: translateY(-1px);
            }


        /* =========================================
                   ACTIVITY INFORMATION
                ========================================= */

        .history-main {
            display: flex;
            align-items: center;
            min-width: 0;
            gap: 12px;
        }

        .history-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 17px;
        }

            .history-icon.event {
                background: #e8f5ff;
                color: #2494eb;
            }

            .history-icon.election {
                background: #eef2ff;
                color: #6366f1;
            }

            .history-icon.evaluation {
                background: #f0f9ff;
                color: #0ea5e9;
            }

        .history-main-content {
            min-width: 0;
        }

        .history-title-row {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
        }

        .activity-type {
            flex-shrink: 0;
            padding: 3px 7px;
            border-radius: 4px;
            background: #eaf5ff;
            color: #258ee8;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2px;
        }

            .activity-type.election {
                background: #eef2ff;
                color: #6366f1;
            }

            .activity-type.evaluation {
                background: #ecf9ff;
                color: #0284c7;
            }

        .activity-name {
            font-size: 12px;
            font-weight: 650;
            color: #344054;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        /* =========================================
                   ROW META
                ========================================= */

        .history-meta {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #7c8799;
            font-size: 10.5px;
            white-space: nowrap;
        }

            .history-meta i {
                color: #7891b5;
                font-size: 11px;
            }


        /* =========================================
                   STATUS
                ========================================= */

        .history-status {
            display: flex;
            justify-content: flex-end;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 70px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-present {
            background: #dcfce7;
            color: #15803d;
        }

        .status-late {
            background: #fff7d6;
            color: #b7791f;
        }

        .status-absent {
            background: #fee2e2;
            color: #dc2626;
        }

        .status-voted {
            background: #e0e7ff;
            color: #4f46e5;
        }

        .status-submitted {
            background: #dcfce7;
            color: #15803d;
        }


        /* =========================================
                   ARROW
                ========================================= */

        .history-arrow {
            color: #98a2b3;
            text-align: right;
            font-size: 13px;
        }


        /* =========================================
                   EMPTY
                ========================================= */

        .history-empty {
            background: white;
            border: 1px solid #e9edf2;
            border-radius: 10px;
            text-align: center;
            padding: 70px 20px;
            color: #98a2b3;
        }

            .history-empty i {
                display: block;
                font-size: 35px;
                color: #b9c4d3;
                margin-bottom: 12px;
            }

        .history-empty-title {
            font-size: 14px;
            font-weight: 700;
            color: #475467;
            margin-bottom: 4px;
        }

        .history-empty-text {
            font-size: 12px;
        }


        /* No search/filter results */

        #noFilteredActivities {
            display: none;
        }


        /* =========================================
                   RESPONSIVE
                ========================================= */

        @@media (max-width: 1100px) {

            .history-item {
                grid-template-columns: minmax(260px, 2fr) 130px 150px 100px 25px;
            }

            .history-location {
                display: none;
            }
        }


        @@media (max-width: 850px) {

            .history-page {
                padding: 20px 15px;
            }

            .history-tip {
                display: none;
            }

            .history-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .history-tabs {
                overflow-x: auto;
            }

            .history-tab {
                flex: 1;
                min-width: 85px;
            }

            .history-toolbar-right {
                width: 100%;
            }

            .history-search {
                width: 100%;
            }

            .history-item {
                grid-template-columns: 1fr auto;
                gap: 10px;
            }

            .history-date,
            .history-time,
            .history-location {
                display: none;
            }

            .history-status {
                justify-content: flex-end;
            }
        }

    </style>
}


<div class="history-page">

    <div class="history-container">


        <!-- =========================================
             HEADER
        ========================================== -->

        <div class="history-header">

            <div class="history-header-left">

                <a href="javascript:history.back()"
                   class="history-back">

                    <i class="bi bi-chevron-left"></i>

                </a>

                <div>

                    <h1 class="history-title">
                        Activity History
                    </h1>

                    <p class="history-subtitle">
                        A complete list of activities you've participated in.
                    </p>

                </div>

            </div>


            <div class="history-tip">

                <div class="history-tip-icon">
                    <i class="bi bi-calendar2-check"></i>
                </div>

                <div>

                    <div class="history-tip-title">
                        Stay engaged!
                    </div>

                    <div class="history-tip-text">
                        Keep participating in more
                        activities and events.
                    </div>

                </div>

            </div>

        </div>



        <!-- =========================================
             TOOLBAR
        ========================================== -->

        <div class="history-toolbar">

            <div class="history-tabs">

                <button type="button"
                        class="history-tab active"
                        data-type="All">

                    All

                </button>


                <button type="button"
                        class="history-tab"
                        data-type="Event">

                    Events

                </button>


                <button type="button"
                        class="history-tab"
                        data-type="Election">

                    Election

                </button>


                <button type="button"
                        class="history-tab"
                        data-type="Evaluation">

                    Evaluation

                </button>

            </div>


            <div class="history-toolbar-right">

                <div class="history-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="historySearch"
                           placeholder="Search activities..."
                           autocomplete="off" />

                </div>

            </div>

        </div>



        <!-- =========================================
             ACTIVITY HISTORY
        ========================================== -->
        @if (!Model.Activities.Any())
        {
            <div class="history-empty">

                <i class="bi bi-clock-history"></i>

                <div class="history-empty-title">
                    No activity history yet
                </div>

                <div class="history-empty-text">
                    Your events, elections, and evaluations
                    will appear here.
                </div>

            </div>
        }
        else
        {

            foreach (var month in groupedActivities)
            {
                var monthDate = new DateTime(
                    month.Key.Year,
                    month.Key.Month,
                    1
                );


                <div class="history-month">

                    <!-- MONTH HEADER -->

                    <div class="history-month-header">

                        <h2 class="history-month-title">
                            @monthDate.ToString("MMMM yyyy")
                        </h2>

                        <span class="history-month-count">
                            <span class="visible-count">
                                @month.Count()
                            </span>
                            activities
                        </span>

                    </div>


                    <!-- ROWS -->

                    <div class="history-month-items">

                        @foreach (var activity in month)
                        {
                            var typeClass =
                                activity.ActivityType.ToLower();

                            var statusClass =
                                activity.Status.ToLower();


                            <div class="history-item"
                                 data-type="@activity.ActivityType"
                                 data-title="@activity.Title.ToLower()"
                                 data-status="@activity.Status">


                                <!-- =========================
                                     ACTIVITY
                                ========================== -->

                                <div class="history-main">

                                    <div class="history-icon @typeClass">

                                        @if (activity.ActivityType == "Event")
                                        {
                                            <i class="bi bi-calendar2-check"></i>
                                        }
                                        else if (activity.ActivityType == "Election")
                                        {
                                            <i class="bi bi-ballot"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-stars"></i>
                                        }

                                    </div>


                                    <div class="history-main-content">

                                        <div class="history-title-row">

                                            <span class="activity-type @typeClass">
                                                @activity.ActivityType
                                            </span>

                                            <span class="activity-name">
                                                @activity.Title
                                            </span>

                                        </div>

                                    </div>

                                </div>



                                <!-- =========================
                                     DATE
                                ========================== -->

                                <div class="history-meta history-date">

                                    <i class="bi bi-calendar3"></i>

                                    <span>
                                        @activity.Date.ToString("MMM dd, yyyy")
                                    </span>

                                </div>


                                <!-- =========================
     TIME
========================== -->

                                <div class="history-meta history-time">

                                    <i class="bi bi-clock"></i>

                                    @if (activity.StartTime.HasValue)
                                    {
                                        var startTime = DateTime.Today
                                            .Add(activity.StartTime.Value)
                                            .ToString("h:mm tt");

                                        var endTime = activity.EndTime.HasValue
                                            ? DateTime.Today
                                                .Add(activity.EndTime.Value)
                                                .ToString("h:mm tt")
                                            : "";

                                        <span>
                                            @startTime

                                            @if (!string.IsNullOrEmpty(endTime))
                                            {
                                                <text> - @endTime</text>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }

                                </div>



                                <!-- =========================
                                     LOCATION / RELATED EVENT
                                ========================== -->

                                <div class="history-meta history-location">

                                    @if (activity.ActivityType == "Event")
                                    {
                                        <i class="bi bi-geo-alt"></i>
                                    }
                                    else if (activity.ActivityType == "Election")
                                    {
                                        <i class="bi bi-check2-square"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-calendar-event"></i>
                                    }

                                    <span>
                                        @activity.Location
                                    </span>

                                </div>



                                <!-- =========================
                                     STATUS
                                ========================== -->

                                <div class="history-status">

                                    <span class="status-badge status-@statusClass">
                                        @activity.Status
                                    </span>

                                </div>



                                <!-- =========================
                                     ARROW
                                ========================== -->


                            </div>
                        }

                    </div>

                </div>
            }


            <!-- FILTER EMPTY STATE -->

            <div id="noFilteredActivities"
                 class="history-empty">

                <i class="bi bi-search"></i>

                <div class="history-empty-title">
                    No activities found
                </div>

                <div class="history-empty-text">
                    Try another activity type or search.
                </div>

            </div>
        }

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =====================================
                // ELEMENTS
                // =====================================

                const tabs =
                    document.querySelectorAll(
                        ".history-tab"
                    );

                const items =
                    document.querySelectorAll(
                        ".history-item"
                    );

                const monthGroups =
                    document.querySelectorAll(
                        ".history-month"
                    );

                const searchInput =
                    document.getElementById(
                        "historySearch"
                    );

                const noResults =
                    document.getElementById(
                        "noFilteredActivities"
                    );


                // Currently selected tab.
                let selectedType = "All";


                // =====================================
                // FILTER ACTIVITIES
                // =====================================

                function filterActivities() {

                    const searchText =
                        searchInput
                            ? searchInput.value
                                .trim()
                                .toLowerCase()
                            : "";


                    let totalVisible = 0;


                    // Go through every month.
                    monthGroups.forEach(
                        function (month) {

                            const monthItems =
                                month.querySelectorAll(
                                    ".history-item"
                                );

                            let visibleInMonth = 0;


                            monthItems.forEach(
                                function (item) {

                                    const itemType =
                                        item.dataset.type;

                                    const itemTitle =
                                        item.dataset.title;


                                    // Check selected tab.
                                    const matchesType =
                                        selectedType === "All" ||
                                        itemType === selectedType;


                                    // Check search.
                                    const matchesSearch =
                                        itemTitle.includes(
                                            searchText
                                        );


                                    // Show only when BOTH
                                    // conditions are true.
                                    if (
                                        matchesType &&
                                        matchesSearch
                                    ) {

                                        item.style.display =
                                            "grid";

                                        visibleInMonth++;

                                        totalVisible++;

                                    }
                                    else {

                                        item.style.display =
                                            "none";

                                    }

                                }
                            );


                            // =================================
                            // UPDATE MONTH COUNT
                            // =================================

                            const count =
                                month.querySelector(
                                    ".visible-count"
                                );

                            if (count) {
                                count.textContent =
                                    visibleInMonth;
                            }


                            // Hide the whole month when
                            // nothing inside it is visible.
                            if (visibleInMonth === 0) {

                                month.style.display =
                                    "none";

                            }
                            else {

                                month.style.display =
                                    "";

                            }

                        }
                    );


                    // =====================================
                    // EMPTY FILTER RESULT
                    // =====================================

                    if (noResults) {

                        noResults.style.display =
                            totalVisible === 0
                                ? "block"
                                : "none";

                    }

                }



                // =====================================
                // TAB CLICK
                // =====================================

                tabs.forEach(
                    function (tab) {

                        tab.addEventListener(
                            "click",
                            function () {

                                selectedType =
                                    this.dataset.type;


                                // Remove active appearance
                                // from every tab.
                                tabs.forEach(
                                    function (button) {

                                        button.classList
                                            .remove("active");

                                    }
                                );


                                // Highlight clicked tab.
                                this.classList.add(
                                    "active"
                                );


                                // Run filter.
                                filterActivities();

                            }
                        );

                    }
                );



                // =====================================
                // SEARCH
                // =====================================

                if (searchInput) {

                    searchInput.addEventListener(
                        "input",
                        function () {

                            filterActivities();

                        }
                    );

                }


                // Run once when page loads.
                filterActivities();

            }
        );

    </script>

}