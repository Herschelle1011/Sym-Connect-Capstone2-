@page
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
    .fpc-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .fpc-card {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        overflow: hidden;
        text-align: center;
    }

    .fpc-icon-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: #d1e7dd;
        color: #0f5132;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 32px auto 20px;
        font-size: 28px;
    }

    .fpc-body {
        padding: 0 32px 36px;
    }

        .fpc-body h1 {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 12px;
        }

        .fpc-body p {
            font-size: 14px;
            color: #6b7280;
            line-height: 1.6;
            margin: 0;
        }

    .fpc-footer-link {
        margin-top: 24px;
    }

        .fpc-footer-link a {
            color: #4a6cf7;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

            .fpc-footer-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="fpc-wrapper">
    <div class="fpc-card">

        <div class="fpc-icon-circle">✓</div>

        <div class="fpc-body">
            <h1>@ViewData["Title"]</h1>
            <p>
                If an account exists for that email, we've sent a link to reset
                your password. Please check your inbox (and spam folder).
            </p>

            <div class="fpc-footer-link">
                <a asp-page="./Login">← Back to login</a>
            </div>
        </div>

    </div>
</div>