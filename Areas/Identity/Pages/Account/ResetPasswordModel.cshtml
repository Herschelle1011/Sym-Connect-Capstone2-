@page
@model ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - SYM-Connect</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
            body {
                margin: 0;
                padding: 0;
                background-color: #f1f5f9;
                font-family: 'Segoe UI', Arial, sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
            }

            .reset-card {
                width: 100%;
                max-width: 440px;
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 4px 24px rgba(0,0,0,0.08);
                overflow: hidden;
            }

            .reset-header {
                background-color: #007EC8;
                padding: 32px 24px;
                text-align: center;
            }

                .reset-header .icon-circle {
                    width: 56px;
                    height: 56px;
                    border-radius: 50%;
                    background-color: rgba(255,255,255,0.15);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin: 0 auto 12px;
                    font-size: 24px;
                }

                .reset-header h1 {
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 600;
                    margin: 0;
                }

            .reset-body {
                padding: 36px 32px;
            }

                .reset-body .subtitle {
                    font-size: 14px;
                    color: #6b7280;
                    line-height: 1.6;
                    margin-bottom: 24px;
                    text-align: center;
                }

            .form-label {
                font-size: 14px;
                font-weight: 600;
                color: #111827;
            }

            .password-wrapper {
                position: relative;
            }

                .password-wrapper input {
                    padding-right: 44px;
                }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 12px;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: #9ca3af;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                padding: 4px;
            }

                .password-toggle:hover {
                    color: #007EC8;
                }

            .form-control {
                border-radius: 8px;
                border: 1px solid #e5e7eb;
                padding: 10px 14px;
            }

                .form-control:focus {
                    border-color: #007EC8;
                    box-shadow: 0 0 0 3px rgba(74,108,247,0.12);
                }

            .password-hint {
                font-size: 12px;
                color: #9ca3af;
                margin-top: 6px;
            }

            .btn-primary {
                background-color: #007EC8;
                border-color: #4a6cf7;
                font-weight: 600;
                padding: 12px;
                border-radius: 8px;
                margin-top: 8px;
            }

                .btn-primary:hover {
                    background-color: #007EC8;
                    border-color: #007EC8;
                }

            .footer-link {
                text-align: center;
                margin-top: 20px;
                font-size: 14px;
            }

                .footer-link a {
                    color: #007EC8;
                    text-decoration: none;
                    font-weight: 600;
                }

                    .footer-link a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>
    <div class="reset-card">

        <div class="reset-header">
            <div class="icon-circle">🔑</div>
            <h1>Reset your password</h1>
        </div>

        <div class="reset-body">
            <p class="subtitle">
                Choose a new password for your SYM-Connect account.
            </p>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form method="post">
                <input asp-for="Input.Code" type="hidden" />
                <input asp-for="Input.Email" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">New password</label>
                    <div class="password-wrapper">
                        <input asp-for="Input.Password" id="password-input" class="form-control" autocomplete="new-password" />
                        <button type="button" class="password-toggle" onclick="togglePassword('password-input', this)">Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                    <div class="password-hint">Must be at least 6 characters.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <div class="password-wrapper">
                        <input asp-for="Input.ConfirmPassword" id="confirm-input" class="form-control" autocomplete="new-password" />
                        <button type="button" class="password-toggle" onclick="togglePassword('confirm-input', this)">Show</button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </form>

            <div class="footer-link">
                <a asp-page="./Login">← Back to login</a>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";
        btn.textContent = isPassword ? "Hide" : "Show";
        }
    </script>
</body>
</html>