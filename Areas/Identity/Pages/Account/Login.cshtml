@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}


<div class="login-page-wrapper">
    <div class="login-logo-panel">
        <img src="/images/logosym.png" alt="Salesian Youth Movement" class="login-logo-img" />
    </div>
    <div class="login-card">
        <div class="login-heading">
            <h2>Login</h2>
            <p>Enter your account details.</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <!-- Email -->
            <!-- Email -->
            <div class="input-group-custom">
                <label asp-for="Input.Email">Email</label>

                <div class="input-wrapper">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Input.Email"
                           type="email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="Enter your email" />
                </div>

                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="input-group-custom password-group">
                <label asp-for="Input.Password">Password</label>

                <div class="input-wrapper">
                    <i class="bi bi-lock input-icon"></i>

                    <input asp-for="Input.Password"
                           type="password"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Enter your password"
                           id="passwordInput" />

                    <button type="button"
                            class="password-toggle"
                            id="togglePassword"
                            aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Remember me + Forgot password -->
            <div class="login-extras">
                <label>
                    <input class="form-check-input" asp-for="Input.RememberMe" type="checkbox" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
            </div>

            <!-- Sign In -->
            <button id="login-submit" type="submit" class="btn-signin">Sign In</button>

            <!-- Footer links -->
            <div class="login-footer">
                <p>
                    Don't have an account yet?
                   <button type="button"
        class="btn btn-link"
        data-bs-toggle="modal"
        data-bs-target="#membershipRegistrationModal">

    Register here

</button>
                </p>
            </div>

        </form>

        <!-- External logins (shown only when providers exist) -->
        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="external-login-section">
                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn-external"
                                    name="provider"
                                    value="@provider.Name"
                                    title="Log in using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            }
        }

    </div>
</div>

<partial name="_MembershipRegistrationModal"
         model="new MembershipRegistrationViewModel()" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/membership-registration.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const passwordInput = document.getElementById("passwordInput");
            const togglePassword = document.getElementById("togglePassword");

            if (passwordInput && togglePassword) {
                togglePassword.addEventListener("click", function() {
                    const icon = this.querySelector("i");

                    if (passwordInput.type === "password") {
                        passwordInput.type = "text";

                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");

                        this.setAttribute("aria-label", "Hide password");
                    } else {
                        passwordInput.type = "password";

                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");

                        this.setAttribute("aria-label", "Show password");
                    }
                });
            }
        });
    </script>
}
