@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<style>
    .fp-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .fp-card {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .fp-header {
        background-color: #4a6cf7;
        color: #ffffff;
        padding: 32px 24px;
        text-align: center;
    }

        .fp-header .icon-circle {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background-color: rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            font-size: 24px;
        }

        .fp-header h1 {
            font-size: 20px;
            font-weight: 600;
            margin: 0;
        }

    .fp-body {
        padding: 32px;
    }

        .fp-body p.fp-subtitle {
            font-size: 14px;
            color: #6b7280;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .fp-body .form-floating {
            margin-bottom: 20px;
        }

        .fp-body .btn-primary {
            background-color: #4a6cf7;
            border-color: #4a6cf7;
            font-weight: 600;
            padding: 12px;
            border-radius: 8px;
        }

            .fp-body .btn-primary:hover {
                background-color: #3a5ce0;
                border-color: #3a5ce0;
            }

    .fp-footer-link {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
    }

        .fp-footer-link a {
            color: #4a6cf7;
            text-decoration: none;
            font-weight: 600;
        }

            .fp-footer-link a:hover {
                text-decoration: underline;
            }
</style>

<div class="fp-wrapper">
    <div class="fp-card">

        <div class="fp-header">
            <div class="icon-circle">🔒</div>
            <h1>Forgot your password?</h1>
        </div>

        <div class="fp-body">
            <p class="fp-subtitle">
                No worries — enter the email associated with your SYM-Connect
                account and we'll send you a link to reset your password.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                    <label asp-for="Input.Email"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary mt-2">
                    Send reset link
                </button>
            </form>

            <div class="fp-footer-link">
                <a asp-page="./Login">← Back to login</a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}